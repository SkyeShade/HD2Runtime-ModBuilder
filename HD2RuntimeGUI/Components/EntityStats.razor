@typeparam TField
@* Reusable semantic entity statistics (health, armor, …) for any spawned entity. Field editors are supplied by the owning catalog. *@
<section class="panel entity-stats" data-entity-stats="@Identity">
    <div class="panel-heading"><h2>@Title</h2>@if (Kind != null) { <span class="badge">@Kind</span> }</div>
    @if (Description != null) { <p class="subtle">@Description</p> }
    @if (Items.Count > 0) { <h3 class="group-title">@T["EntityPanel.Stats.Durability"]</h3><div class="stat-grid">@foreach (var item in Items) { @Editor(item) }</div> }
    else if (ChildContent == null) { <p class="subtle">@T["EntityPanel.Stats.Empty"]</p> }
    @ChildContent
</section>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Identity { get; set; } = "";
    [Parameter] public string? Kind { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<TField> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TField> Editor { get; set; } = null!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

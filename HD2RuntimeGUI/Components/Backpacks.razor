@inject BuilderWorkspace Workspace
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var entities = sdk?.Entities; }
<div class="page-heading"><div><div class="eyebrow">GUARDED AUTHORING · SDK @sdk?.Version</div><h1>Backpacks</h1><p>Delivered backpack behavior from <code>hd2.backpack</code>. Linked call-in cooldowns are edited here too.</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">Build requires review: @issue</div> }
@if (entities == null) { <section class="panel" data-entity-unavailable><h2>Backpack authoring requires SDK 0.23.0</h2><p>This project is bound to SDK @sdk?.Version. Rebind it from Overview to use the published backpack capabilities.</p></section> }
else
{
    var backpacks = entities.Backpacks.Backpacks.Where(b => b.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToArray();
    <div class="weapon-editor"><section class="panel weapon-browser"><h2>@backpacks.Length backpacks</h2>
        <label>Search<input id="backpack-search" @bind="Search" @bind:event="oninput" placeholder="Backpack name" /></label>
        <div class="weapon-list">@foreach (var b in backpacks)
        {
            var writable = entities.Backpacks.FieldInstances.Count(f => f.Target.Backpack == b.Name && f.Editable);
            <button class="resource-item cat-support @(Selected == b.Name ? "active" : "")" data-backpack-item="@b.Name" @onclick="() => Selected = b.Name"><strong>@b.Name</strong><small>@(writable == 0 ? "Read-only" : writable + " writable") · @string.Join(", ", b.Components.Where(c => c != "Backpack"))@(Modified(b.Name) ? " · modified" : "")</small></button>
        }</div>
    </section><div class="weapon-detail">
        @if (entities.Backpacks.Find(Selected) != null) { <BackpackEditor Name="@Selected" Changed="Refresh" @key="Selected" /> }
        else { <section class="panel"><h2>Choose a backpack</h2><p>@entities.Backpacks.Summary.Backpacks backpacks · @entities.Backpacks.Summary.WritableFieldInstances writable fields · @entities.Backpacks.Summary.ReadOnlyFieldInstances read-only fields</p></section> }
    </div></div>
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private string Search = "", Selected = "";
    private bool Modified(string name) => Workspace.Project?.EntityChanges.Any(c => c.Resource == "backpack" && c.Entity == name) == true;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
}

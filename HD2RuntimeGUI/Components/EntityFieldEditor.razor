@inject BuilderWorkspace Workspace
@* One published vehicle/backpack/attachment/booster scalar as a compact row. The evidence tier stays visible as a short badge
   (schema-proven never looks like in-game tested); its full description and provenance are in the tooltip / ⓘ section. *@
@{ var saved = Saved; }
<div class="field-row @(saved != null ? "modified" : "") @(Field.Editable ? "" : "readonly")" data-entity-field="@Field.InstanceKey" data-semantic-field="@Field.SemanticFieldId">
    <div class="field-name"><span>@(Label ?? Field.DisplayName)</span>@if (Unit.Length > 0) { <small class="field-unit">@Unit</small> }
        <span class="field-flags"><EvidenceBadge Evidence="Field.Evidence" Tiers="Tiers" Compact="true" />
            @if (saved != null) { <span class="badge modified-badge">Modified</span> }</span></div>
    <div class="field-value">
        @if (!Field.Editable) { <span class="badge" title="@Field.Reason">Read-only</span> }
        else { <input type="number" step="@(Field.Type == "integer" ? "1" : "any")" value="@Value" disabled="@(Workspace.Project == null)" @onchange="e => Run(() => Workspace.SetEntityAsync(Field.InstanceKey, e.Value?.ToString() ?? string.Empty))" aria-label="@(Label ?? Field.DisplayName)" /> }
    </div>
    @if (saved != null) { <div class="field-baseline modified-value" data-baseline="@Format(saved.ExpectedValue)" data-desired="@Format(saved.DesiredValue)">Base @Format(saved.ExpectedValue) → <strong>@Format(saved.DesiredValue)</strong></div> }
    else { <div class="field-baseline subtle" data-baseline="@Format(Field.CurrentDefault)">Base @Format(Field.CurrentDefault)</div> }
    <div class="field-tools">
        @if (saved != null)
        {
            <label class="field-toggle" title="Include this change in the build"><input type="checkbox" checked="@saved.Enabled" @onchange="() => Run(() => Workspace.ToggleEntityAsync(saved.InstanceKey))" /> On</label>
            <button class="reset-action small" @onclick="() => Run(() => Workspace.ResetEntityAsync(instance: Field.InstanceKey))">Reset field</button>
        }
        <details class="field-info"><summary title="Why? / provenance">ⓘ</summary><div class="field-info-body">
            @if (!Field.Editable) { <p><strong>Not writable:</strong> @Field.Reason</p> }
            <p><strong>Evidence:</strong> @EvidenceBadge.Label(Field.Evidence.Tier)@(Tiers?.GetValueOrDefault(Field.Evidence.Tier) is { } tier ? " — " + tier : "")</p><p>@Field.Provenance</p><code>@Field.SemanticFieldId</code></div></details>
    </div>
    @if (saved != null && Workspace.EntityIssue(saved) is { } issue && !(AcknowledgedInGroup && issue.StartsWith("Acknowledge ", StringComparison.Ordinal)))
    {
        <div class="field-wide"><p class="notice warning">@issue</p>
            @if (Field.Editable && (saved.CapabilityEvidence != EntityChangeService.Evidence(Field) || !EntityScalar.Equal(Field, saved.ExpectedValue, Field.CurrentDefault)))
            { <button @onclick="() => Run(() => Workspace.SetEntityAsync(Field.InstanceKey, Value, true))">Accept current capability / baseline</button> }</div>
    }
    @if (Error != null) { <p class="field-wide notice warning" role="alert">@Error</p> }
</div>
@code {
    [Parameter, EditorRequired] public EntityField Field { get; set; } = null!;
    [Parameter] public string? Label { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? Tiers { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    // The acknowledgement is given in the enclosing group's panel, so its "Acknowledge … before building" issue is not repeated per row.
    [Parameter] public bool AcknowledgedInGroup { get; set; }
    private string? Error;
    private EntityChange? Saved => EntityChangeService.Saved(Workspace.Project, Field);
    private string Unit => Field.Unit?.Replace('_', ' ') ?? "";
    private string Value => Format(Saved?.DesiredValue ?? Field.CurrentDefault);
    private string Format(System.Text.Json.JsonElement v) { try { return EntityScalar.Text(Field, v); } catch (InvalidDataException) { return v.GetRawText(); } }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

@inject BuilderWorkspace Workspace
@* Throwables (hd2.throwable, SDK 0.27.0+): every published armory throwable, filterable by its published category and family. *@
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Entities?.Throwables; }
<div class="page-heading cat-throwable"><div><div class="eyebrow">@T.Format("EntityPanel.GuardedEyebrow", sdk?.Version)</div><h1>@T["Throwable.Page.Title"]</h1><p>@T.Markup("Throwable.Page.Help.Html")</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">@T.Format("EntityPanel.BuildReview", issue)</div> }
@if (catalog == null) { <section class="panel" data-throwable-unavailable><h2>@T["Throwable.Unavailable.Title"]</h2><p>@T.Format("Throwable.Unavailable.Help", sdk?.Version)</p></section> }
else
{
    var families = catalog.Throwables.Select(t => t.Family).Distinct().Order(StringComparer.Ordinal).ToArray();
    var list = catalog.Throwables.Where(t => (Family.Length == 0 || t.Family == Family)
            && string.Join(" ", t.Name, t.Designation, t.SemanticId, t.Category, t.Family).Contains(Search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(t => t.Category == "Standard" ? 0 : 1).ThenBy(t => t.Name, StringComparer.Ordinal).ToArray();
    <div class="weapon-editor"><section class="panel weapon-browser"><h2>@T.Plural("Throwable.List.Count", list.Length)</h2>
        <label>@T["Common.Search"]<input id="throwable-search" @bind="Search" @bind:event="oninput" placeholder="@T["Throwable.Search.Placeholder"]" /></label>
        <label>@T["Throwable.Family.Label"]<select data-throwable-family-filter @bind="Family"><option value="">@T["Throwable.Family.All"]</option>@foreach (var f in families) { <option value="@f">@ThrowableEditor.FamilyLabel(f)</option> }</select></label>
        <div class="weapon-list">@foreach (var t in list)
        {
            <button class="resource-item with-icon cat-throwable @(Selected == t.Name ? "active" : "")" data-throwable-item="@t.Name" data-throwable-family="@t.Family" @onclick="() => Selected = t.Name">
                <GameIcon Kind="throwable" Label="@t.Name" CssClass="cat-throwable" /><span class="resource-text">
                <strong>@t.Name</strong><small>@t.Category · @ThrowableEditor.FamilyLabel(t.Family) · @T.Format("EntityPanel.WritableCount", t.WritableFields)@(Modified(t.Name) ? " · " + T["EntityPanel.ListModified"] : "")</small></span></button>
        }</div>
    </section><div class="weapon-detail">
        @if (catalog.Find(Selected) != null) { <ThrowableEditor Name="@Selected" Changed="Refresh" @key="Selected" /> }
        else { <section class="panel category-panel cat-throwable" data-throwable-summary><h2>@T["Throwable.Choose.Title"]</h2><p>@T.Format("Throwable.Choose.Summary", catalog.Summary.Throwables, catalog.Summary.WritableFieldInstances, catalog.Summary.SharedFieldInstances)</p></section> }
    </div></div>
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private string Search = "", Selected = "", Family = "";
    private bool Modified(string name) => Workspace.Project?.EntityChanges.Any(c => c.Resource == ThrowableAuthoringReader.Resource && c.Entity == name) == true;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
}

@inject BuilderWorkspace Workspace
@* One projectile / damage / explosion object scalar as a compact row. Shared objects are flagged here and warned about once
   in the section (CompositionApprovals); allow_shared is implicit. *@
@* An option-only edit (1.6.0, vanilla value kept for its in-game option) shows as the unedited field with its option. *@
@{ var edited = Saved is { } saved && !Workspace.OptionOnly(saved); }
<div class="field-row @(edited ? "modified" : "") @(Editable ? "" : "readonly")" data-object-field="@Field.SemanticFieldId">
    <div class="field-name"><span>@Field.DisplayName</span>@if (FieldPresentation.Unit(Field) is { Length: > 0 } unit) { <small class="field-unit">@unit</small> }
        <span class="field-flags">
            @if (edited) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
            @if (Field.AffectsMultipleWeapons) { <span class="badge amber" data-flag="allow_shared" title="@T["ObjectField.Shared.Tooltip"]">@T["Common.Shared"]</span> }
            @if (Editable && ExplosionStatus) { <span class="badge amber" data-explosion-status title="@T["Status.Explosion.NotLiveTested"]">@T["Status.Explosion.Badge"]</span> }
            @if (!Editable) { <span class="badge" title="@Field.Reason">@T["Common.ReadOnly"]</span> }
        </span></div>
    <div class="field-value">
        @if (Editable && Field.Type == WeaponCapability.StatusReference)
        {
            var (allowed, none) = Workspace.StatusChoices(Field);
            <StatusReferenceSelect Allowed="allowed" AllowNone="none" Value="@Value" Label="@Field.DisplayName" Disabled="@Busy" Changed="async v => { Value = v; await Commit(); }" />
        }
        else if (Editable) { <input aria-label="@Field.DisplayName" type="number" step='@(Field.Type == "integer" ? "1" : "any")' @bind="Value" @bind:after="Commit" disabled="@Busy" /> }
        else { <span class="readonly-value">@Display(Current)</span> }
    </div>
    <div class="field-baseline @(edited ? "modified-value" : "subtle")" data-baseline="@FieldPresentation.Value(Field, Field.CurrentDefault)">@T.Format("ObjectField.Base", Display(Field.CurrentDefault))@if (edited) { <span> → <strong>@Display(Current)</strong></span> }</div>
    <div class="field-tools">
        @if (Editable || Saved?.Scalar != null) { <OptionToggle Key="@ModOptionsService.ObjectKey(Weapon, Role, Kind, Phase, Field.SemanticFieldId)" Changed="Changed" /> }
        @if (edited) { <button class="reset-action small" @onclick="Reset">@T["ObjectField.Reset"]</button> }
        <details class="field-info"><summary title="@T["ObjectField.Info.Tooltip"]">ⓘ</summary><div class="field-info-body">
            @if (!Editable) { <p>@T.Markup("ObjectField.NotWritable.Html", Field.Reason)</p> }
            @if (Field.AffectsMultipleWeapons) { <p>@T.Markup("ObjectField.SharedWith.Html", string.Join(", ", Field.SharedWithWeapons.Append(Workspace.EffectiveProjectile(Weapon, Role).Weapon).Append(Weapon).Distinct()))</p>
                @if (Field.DynamicConsumersPossible == true) { <p>@T["ObjectField.DynamicConsumers"]</p> } }
            <p><span class="badge">@Field.Provenance.Label</span> @(Field.Backing?.Settings ?? T["ObjectField.ReadOnlyEvidence"])</p><code>@Field.SemanticFieldId</code>
        </div></details>
    </div>
    @if (Editable && Field.AffectsMultipleWeapons && Workspace.Metadata?.Plans == null)
    {
        <div class="field-wide"><AckPanel Title="@OptInWarnings.Title(T, "allow_shared")" Description="@T["ObjectField.Shared.Description"]" Items="@Field.SharedWithWeapons.Append(Workspace.EffectiveProjectile(Weapon, Role).Weapon).Append(Weapon).Distinct().ToArray()" /></div>
    }
    @* Runtime's allow_unverified_effect for this object field (every value but a live-proven one) is always written; this only warns. *@
    @if (Saved?.Scalar is { } scalar && CompositionOptIns.EffectFor(Field, scalar.DesiredValue) && !WarnedByStatusRow)
    {
        <div class="field-wide"><AckPanel Title="@T.Format("WeaponField.UnverifiedEffect.Title", Field.DisplayName)" Kind="unverified" Description="@Field.AcknowledgementReason">
            @* 0.30.2: no status on a player-weapon explosion is live-tested yet (Runtime's pending test PurifierIncendiaryCharge). *@
            @if (ExplosionStatus) { <p class="subtle" data-explosion-status-note>@T["Status.Explosion.NotLiveTested"]</p> }
        </AckPanel></div>
    }
    @if (Field.Type == WeaponCapability.StatusReference && Saved?.Scalar is { } chosen) { <StatusTierWarning Value="@(chosen.DesiredValue.ValueKind == System.Text.Json.JsonValueKind.String ? chosen.DesiredValue.GetString() : null)" /> }
    @if (StrengthlessSlot is int slot) { <p class="field-wide notice" data-status-strength-hint="@slot">@T.Format("VehicleWeapon.Status.StrengthHint", slot)</p> }
    @if (Saved != null && Workspace.CompositionIssue(Saved) is { } issue) { <p class="field-wide notice warning">@issue</p> }
    @if (Error != null) { <p class="field-wide dialog-error" role="alert">@Error</p> }
</div>
@code {
    [Parameter] public string Weapon { get; set; } = "";
    [Parameter] public string Role { get; set; } = "";
    [Parameter] public string Kind { get; set; } = "projectile";
    [Parameter] public string? Phase { get; set; }
    [Parameter] public WeaponCapability Field { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private CompositionChange? Saved => Workspace.Project!.CompositionChanges.SingleOrDefault(c => c.Weapon == Weapon && c.AttackRole == Role && c.Kind == Kind && c.Phase == Phase && c.Scalar?.SemanticFieldId == Field.SemanticFieldId);
    private bool Editable => Field.Editable && !Field.DerivedReadOnly;
    // 0.30.2 status slots on a player weapon's explosion row (Player Weapons › impact / expiry actions).
    private bool ExplosionStatus => Kind == "explosion" && AuthoredTypes.IsPlayerExplosionStatus(Field.SemanticFieldId);
    // An explosion status strength whose slot's status row is edited too: that row's panel covers the pair (warned once per slot).
    private bool WarnedByStatusRow => ExplosionStatus && Field.Type != WeaponCapability.StatusReference && Workspace.Project!.CompositionChanges.Any(c => c.Weapon == Weapon
        && c.AttackRole == Role && c.Kind == Kind && c.Phase == Phase && c.Scalar?.SemanticFieldId == Field.SemanticFieldId[..^"_strength".Length] + "_type");
    // A status slot that gains a status (it had none) while its paired strength stays 0: the slot's number, else null.
    private int? StrengthlessSlot
    {
        get
        {
            if (Field.Type != WeaponCapability.StatusReference || Field.CurrentDefault.GetString() != StatusReference.None || StatusReferences.Slot(Field.SemanticFieldId) is not int k
                || Saved?.Scalar is not { DesiredValue: { ValueKind: System.Text.Json.JsonValueKind.String } desired } || desired.GetString() == StatusReference.None) return null;
            var id = Field.SemanticFieldId[..^"_type".Length] + "_strength";
            if (Workspace.ObjectFields(Weapon, Role, Kind, Phase).FirstOrDefault(f => f.SemanticFieldId == id) is not { } strength) return null;
            var value = Workspace.Project!.CompositionChanges.SingleOrDefault(c => c.Weapon == Weapon && c.AttackRole == Role && c.Kind == Kind && c.Phase == Phase && c.Scalar?.SemanticFieldId == id)?.Scalar?.DesiredValue ?? strength.CurrentDefault;
            return value.ValueKind == System.Text.Json.JsonValueKind.Number && value.GetDouble() == 0 ? k : null;
        }
    }
    private System.Text.Json.JsonElement Current => Saved?.Scalar?.DesiredValue ?? Field.CurrentDefault;
    private string Value = "", Loaded = ""; private CompositionChange? Previous; private bool Busy; private string? Error;
    protected override void OnParametersSet() { var key = Weapon + Role + Kind + Phase + Field.SemanticFieldId; if (Loaded == key && Previous == Saved) return; Loaded = key; Previous = Saved; Value = Field.Format(Saved?.Scalar?.DesiredValue ?? Field.CurrentDefault); }
    // A status reference is a status key: saved as a JSON string.
    private Task Commit() => Run(() => Workspace.SetObjectScalarAsync(Weapon, Role, Kind, Phase, Field.SemanticFieldId,
        Field.Type == WeaponCapability.StatusReference ? System.Text.Json.JsonSerializer.Serialize(Value) : Value, acknowledge: true));
    private string Display(System.Text.Json.JsonElement value) => Field.Type == WeaponCapability.StatusReference && value.ValueKind == System.Text.Json.JsonValueKind.String
        ? Workspace.StatusLabel(value.GetString()!) : FieldPresentation.DisplayValue(T, Field, value);
    private Task Reset() => Run(() => Workspace.RemoveCompositionAsync(Saved!.Id));
    private async Task Run(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); await Changed.InvokeAsync(); } catch (Exception e) { Error = e.Message; } finally { Busy = false; } }
}

@* Runtime 0.26.0 fire modes for one weapon, as Runtime models them: the native four-slot FireMode list. Slot 1 is the default mode;
   slots 2-4 are further selectable modes when the in-game selector is bound. Only modes Runtime allows are offered, only up to its
   published maximum; a weapon without a selector has exactly one mode, which can be replaced. Blocked weapons show their observed
   modes and Runtime's reason, with no controls. Burst length and rate of fire are weapon-wide, not per mode. *@
<div class="fire-mode-editor @(Model.Modified ? "modified" : "")" data-fire-modes="@Model.Weapon" data-fire-mode-state="@Model.State">
    <div class="fire-mode-head">
        <strong>Fire modes</strong>
        <span class="badge" data-fire-mode-selector>@(Model.State == "selectable" ? "Selector bound · up to " + Model.MaxModes + " modes" : Model.State == "single_mode" ? "No selector · one mode" : Model.State == "absent" ? "No weapon data" : "Read-only")</span>
        @if (Model.Modified) { <span class="badge modified-badge">Modified</span> }
        @if (Model.AckRequired) { <span class="badge amber" data-flag="allow_unverified_effect" title="@Model.AckReason">Effect unverified</span> }
        @if (Model.Modified && Model.Writable) { <button class="reset-action small" data-fire-mode-reset @onclick="() => Run(() => Reset.InvokeAsync())">Reset modes</button> }
        <details class="field-info"><summary title="How fire modes work">ⓘ</summary><div class="field-info-body">
            <p>Fire modes are one ordered list in the weapon's own data: the first slot is the default, the rest are cycled with the fire-mode selector. Enabling a mode writes it into an empty slot; there is no per-mode rate of fire.</p>
            @if (Model.Evidence != null) { <p>@Model.Evidence</p> }
            @if (Model.AckReason != null) { <p>@Model.AckReason</p> }
        </div></details>
    </div>
    @if (!Model.Writable)
    {
        <p class="fire-mode-blocked" data-fire-mode-blocked>
            @if (Model.Observed.Count > 0) { <span>@string.Join(", ", Model.Observed)</span><span class="subtle"> · </span> }
            <span class="subtle">@Model.Reason</span></p>
    }
    else
    {
        var current = Model.Current.ToList();
        <ol class="fire-mode-slots" data-fire-mode-slots>
            @for (var i = 0; i < 4; i++)
            {
                var index = i; var mode = i < current.Count ? current[i] : null; var usable = i < Model.MaxModes;
                <li class="fire-mode-slot @(mode == null ? "empty" : "") @(usable ? "" : "unavailable")" data-fire-mode-slot="@(i + 1)" data-mode="@(mode ?? "")">
                    <span class="slot-label">Slot @(i + 1)@(i == 0 ? " · default" : "")</span>
                    @if (mode != null)
                    {
                        @if (Model.State == "single_mode")
                        {
                            <select aria-label="Fire mode" data-fire-mode-replace value="@mode" @onchange="e => Run(() => Set([e.Value!.ToString()!]))">
                                @foreach (var option in Model.Allowed) { <option value="@option">@FireModes.Label(option)</option> }</select>
                        }
                        else
                        {
                            <strong>@FireModes.Label(mode)</strong>
                            <span class="slot-actions">
                                <button class="small" title="Move earlier" aria-label="Move @FireModes.Label(mode) earlier" disabled="@(index == 0)" data-fire-mode-up="@mode" @onclick="() => Run(() => Set(Move(current, index, -1)))">↑</button>
                                <button class="small" title="Move later" aria-label="Move @FireModes.Label(mode) later" disabled="@(index == current.Count - 1)" data-fire-mode-down="@mode" @onclick="() => Run(() => Set(Move(current, index, 1)))">↓</button>
                                <button class="small reset-action" title="Remove this mode" aria-label="Remove @FireModes.Label(mode)" disabled="@(current.Count == 1)" data-fire-mode-remove="@mode" @onclick="() => Run(() => Set(current.Where((_, j) => j != index).ToArray()))">✕</button>
                            </span>
                        }
                    }
                    else { <span class="subtle">@(usable ? "Empty" : "Not available")</span> }
                </li>
            }
        </ol>
        @if (Model.State == "selectable" && current.Count < Model.MaxModes && Model.Allowed.Except(current).ToArray() is { Length: > 0 } addable)
        {
            <div class="fire-mode-add"><span class="subtle">Add mode:</span>
                @foreach (var mode in addable) { <button class="small" data-fire-mode-add="@mode" @onclick="() => Run(() => Set([.. current, mode]))">+ @FireModes.Label(mode)</button> }</div>
        }
        @if (Model.Modified) { <p class="field-baseline modified-value" data-fire-mode-baseline>Base @string.Join(", ", Model.Baseline.Select(FireModes.Label)) → <strong>@string.Join(", ", current.Select(FireModes.Label))</strong></p> }
        else { <p class="field-baseline subtle" data-fire-mode-baseline>Base @string.Join(", ", Model.Baseline.Select(FireModes.Label))</p> }
        @if (Model.Modified && Model.AckRequired)
        {
            <AckPanel Title="Fire modes · effect not gameplay-confirmed" Kind="unverified" Checked="Model.Acknowledged" Description="@Model.AckReason"
                Label="I understand this effect is not gameplay-confirmed" OnChange="v => Run(() => Acknowledge.InvokeAsync(v))"
                CheckboxAttributes='@(new() { ["data-fire-mode-ack"] = "true" })' />
        }
    }
    @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
</div>
@code {
    // One weapon's fire-mode capability and saved state, from the player or support catalog.
    public sealed record FireModeModel(string Weapon, string State, bool Writable, string? Reason, IReadOnlyList<string> Baseline, IReadOnlyList<string> Current,
        IReadOnlyList<string> Allowed, int MaxModes, bool AckRequired, bool Acknowledged, string? AckReason, string? Evidence, IReadOnlyList<string> Observed)
    {
        public bool Modified => !Baseline.SequenceEqual(Current);
    }
    [Parameter, EditorRequired] public FireModeModel Model { get; set; } = null!;
    // Receives the desired mode list as JSON (["single","burst","automatic"]).
    [Parameter, EditorRequired] public EventCallback<string> SetModes { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public EventCallback<bool> Acknowledge { get; set; }
    private string? Error;
    private Task Set(string[] modes) => SetModes.InvokeAsync(System.Text.Json.JsonSerializer.Serialize(modes));
    private static string[] Move(List<string> modes, int index, int by)
    {
        var copy = modes.ToList(); var item = copy[index]; copy.RemoveAt(index); copy.Insert(index + by, item); return [.. copy];
    }
    private async Task Run(Func<Task> action) { try { Error = null; await action(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

@* Runtime 0.26.0 fire modes for one weapon, as Runtime models them: the native four-slot FireMode list. Slot 1 is the default mode;
   slots 2-4 are further selectable modes when the in-game selector is bound. Only modes Runtime allows are offered, only up to its
   published maximum; a weapon without a selector has exactly one mode, which can be replaced. Blocked weapons show their observed
   modes and Runtime's reason, with no controls. Burst length and rate of fire are weapon-wide, not per mode. *@
<div class="fire-mode-editor @(Model.Modified ? "modified" : "")" data-fire-modes="@Model.Weapon" data-fire-mode-state="@Model.State">
    <div class="fire-mode-head">
        <strong>@T["FireMode.Title"]</strong>
        <span class="badge" data-fire-mode-selector>@(Model.State == "selectable" ? T.Plural("FireMode.State.Selectable", Model.MaxModes) : Model.State == "single_mode" ? T["FireMode.State.SingleMode"] : Model.State == "absent" ? T["FireMode.State.Absent"] : T["Common.ReadOnly"])</span>
        @if (Model.Modified) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
        @if (Model.AckRequired) { <span class="badge amber" data-flag="allow_unverified_effect" title="@Model.AckReason">@T["FireMode.EffectUnverified"]</span> }
        @if (Model.Modified && Model.Writable) { <button class="reset-action small" data-fire-mode-reset @onclick="() => Run(() => Reset.InvokeAsync())">@T["FireMode.ResetModes"]</button> }
        <details class="field-info"><summary title="@T["FireMode.Info.Tooltip"]">ⓘ</summary><div class="field-info-body">
            <p>@T["FireMode.Info.Help"]</p>
            @if (Model.Evidence != null) { <p>@Model.Evidence</p> }
            @if (Model.AckReason != null) { <p>@Model.AckReason</p> }
        </div></details>
    </div>
    @if (!Model.Writable)
    {
        <p class="fire-mode-blocked" data-fire-mode-blocked>
            @if (Model.Observed.Count > 0) { <span>@string.Join(", ", Model.Observed)</span><span class="subtle"> · </span> }
            <span class="subtle">@Model.Reason</span></p>
    }
    else
    {
        var current = Model.Current.ToList();
        <ol class="fire-mode-slots" data-fire-mode-slots>
            @for (var i = 0; i < 4; i++)
            {
                var index = i; var mode = i < current.Count ? current[i] : null; var usable = i < Model.MaxModes;
                <li class="fire-mode-slot @(mode == null ? "empty" : "") @(usable ? "" : "unavailable")" data-fire-mode-slot="@(i + 1)" data-mode="@(mode ?? "")">
                    <span class="slot-label">@T.Format(i == 0 ? "FireMode.Slot.Default" : "FireMode.Slot", i + 1)</span>
                    @if (mode != null)
                    {
                        @if (Model.State == "single_mode")
                        {
                            <select aria-label="@T["FireMode.Select.Aria"]" data-fire-mode-replace value="@mode" @onchange="e => Run(() => Set([e.Value!.ToString()!]))">
                                @foreach (var option in Model.Allowed) { <option value="@option">@FireModes.DisplayLabel(option)</option> }</select>
                        }
                        else
                        {
                            <strong>@FireModes.DisplayLabel(mode)</strong>
                            <span class="slot-actions">
                                <button class="small" title="@T["FireMode.MoveEarlier"]" aria-label="@T.Format("FireMode.MoveEarlier.Aria", FireModes.DisplayLabel(mode))" disabled="@(index == 0)" data-fire-mode-up="@mode" @onclick="() => Run(() => Set(Move(current, index, -1)))">↑</button>
                                <button class="small" title="@T["FireMode.MoveLater"]" aria-label="@T.Format("FireMode.MoveLater.Aria", FireModes.DisplayLabel(mode))" disabled="@(index == current.Count - 1)" data-fire-mode-down="@mode" @onclick="() => Run(() => Set(Move(current, index, 1)))">↓</button>
                                <button class="small reset-action" title="@T["FireMode.Remove"]" aria-label="@T.Format("FireMode.Remove.Aria", FireModes.DisplayLabel(mode))" disabled="@(current.Count == 1)" data-fire-mode-remove="@mode" @onclick="() => Run(() => Set(current.Where((_, j) => j != index).ToArray()))">✕</button>
                            </span>
                        }
                    }
                    else { <span class="subtle">@(usable ? T["Common.Empty"] : T["FireMode.Slot.Unavailable"])</span> }
                </li>
            }
        </ol>
        @if (Model.State == "selectable" && current.Count < Model.MaxModes && Model.Allowed.Except(current).ToArray() is { Length: > 0 } addable)
        {
            <div class="fire-mode-add"><span class="subtle">@T["FireMode.AddMode"]</span>
                @foreach (var mode in addable) { <button class="small" data-fire-mode-add="@mode" @onclick="() => Run(() => Set([.. current, mode]))">+ @FireModes.DisplayLabel(mode)</button> }</div>
        }
        @if (Model.Modified) { <p class="field-baseline modified-value" data-fire-mode-baseline>@T.Markup("FireMode.BaselineToCurrent.Html", string.Join(", ", Model.Baseline.Select(FireModes.DisplayLabel)), string.Join(", ", current.Select(FireModes.DisplayLabel)))</p> }
        else { <p class="field-baseline subtle" data-fire-mode-baseline>@T.Format("FireMode.Baseline", string.Join(", ", Model.Baseline.Select(FireModes.DisplayLabel)))</p> }
        @if (Model.Modified && Model.AckRequired)
        {
            <AckPanel Title="@T["FireMode.UnverifiedEffect.Title"]" Kind="unverified" Description="@Model.AckReason" />
        }
    }
    @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
</div>
@code {
    // One weapon's fire-mode capability and saved state, from the player or support catalog.
    public sealed record FireModeModel(string Weapon, string State, bool Writable, string? Reason, IReadOnlyList<string> Baseline, IReadOnlyList<string> Current,
        IReadOnlyList<string> Allowed, int MaxModes, bool AckRequired, string? AckReason, string? Evidence, IReadOnlyList<string> Observed)
    {
        public bool Modified => !Baseline.SequenceEqual(Current);
    }
    [Parameter, EditorRequired] public FireModeModel Model { get; set; } = null!;
    // Receives the desired mode list as JSON (["single","burst","automatic"]).
    [Parameter, EditorRequired] public EventCallback<string> SetModes { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    private string? Error;
    private Task Set(string[] modes) => SetModes.InvokeAsync(System.Text.Json.JsonSerializer.Serialize(modes));
    private static string[] Move(List<string> modes, int index, int by)
    {
        var copy = modes.ToList(); var item = copy[index]; copy.RemoveAt(index); copy.Insert(index + by, item); return [.. copy];
    }
    private async Task Run(Func<Task> action) { try { Error = null; await action(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

@inject BuilderWorkspace Workspace
@* 0.26.0 drop-pod contents (PodPayloadCapabilities): the hellpod rack a call-in delivers. Slots 1-4 are authored with a pickup from
   Runtime's typed catalog (grouped by its published category, never by name) or 'empty'; the spawn count decides how many of them
   spawn. Slots 5-8 are never authored. Written as hd2.pod_rack(name):slot(n) and hd2.pod_rack(name) with the published opt-ins. *@
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var entities = sdk?.Entities; var pods = entities?.Pods; var rack = pods?.Rack(Rack); }
@if (entities != null && pods != null && rack != null)
{
    var byKey = pods.FieldInstances.Where(f => f.Target.Rack == rack.Name).ToDictionary(f => f.InstanceKey);
    var spawn = byKey.GetValueOrDefault(PodPayloadReader.SpawnKey(rack));
    var slots = rack.AuthoredSlots.Where(s => s.Writable).Select(s => (Slot: s, Field: byKey[PodPayloadReader.SlotKey(rack, s.Slot)])).ToArray();
    var edited = byKey.Values.Where(f => EntityChangeService.Saved(Workspace.Project, f) != null).ToArray();
    var count = spawn == null ? rack.SpawnCount.Value ?? 0 : Int(EntityChangeService.Saved(Workspace.Project, spawn)?.DesiredValue ?? spawn.CurrentDefault);
    @if (!ModifiedOnly || edited.Length > 0)
    {
    <section class="panel pod-payload @(edited.Length > 0 ? "modified" : "")" data-pod-rack="@rack.Name" data-pod-shared="@(rack.Shared ? "true" : "false")">
        <div class="panel-heading"><h3>@T["DropPod.Title"]</h3><span class="badge" data-pod-rack-name>@rack.Name</span>
            @if (rack.Shared) { <span class="badge amber" data-flag="allow_shared" title="@T["DropPod.SharedRack.Tooltip"]">@T.Format("DropPod.SharedRack", rack.Consumers.Length)</span> }
            @if (edited.Length > 0) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
            @if (edited.Length > 0 && Workspace.Project != null) { <button class="reset-action small" data-pod-reset @onclick='() => Run(() => Workspace.ResetEntityAsync("pod_rack", rack.Name))'>@T["DropPod.Reset"]</button> }</div>
        @if (!rack.Writable) { <p class="subtle field-blocker" data-pod-readonly>@T.Format("DropPod.ReadOnly", rack.Reason)</p> }
        else
        {
            @if (rack.Shared)
            {
                <p class="notice cat-note" data-pod-shared-warning>@T.Markup("DropPod.SharedWarning.Html", string.Join(", ", rack.Consumers.Select(c => c.Name)))</p>
            }
            @if (spawn != null && (!ModifiedOnly || EntityChangeService.Saved(Workspace.Project, spawn) != null))
            { <div class="stat-grid" data-pod-spawn-count><EntityFieldEditor @key="spawn.InstanceKey" Field="spawn" Label="@T["DropPod.SpawnCount"]" Tiers="Tiers" Changed="Refresh" /></div> }
            <div class="pod-slots">
            @foreach (var (s, f) in slots.Where(x => !ModifiedOnly || EntityChangeService.Saved(Workspace.Project, x.Field) != null))
            {
                var saved = EntityChangeService.Saved(Workspace.Project, f);
                var value = (saved?.DesiredValue ?? f.CurrentDefault).GetString()!;
                var chosen = value == PodPayloadReader.Empty ? null : pods.Pickup(value);
                <article class="stat-card pod-slot @(saved != null ? "modified" : "") @(s.Slot > count ? "inactive" : "")" data-pod-slot="@s.Slot">
                    <div class="panel-heading"><h4>@T.Format("DropPod.Slot", s.Slot)</h4>
                        @if (s.Slot > count) { <span class="badge" data-pod-slot-idle title="@T.Plural("DropPod.SpawnsFirst", count)">@T.Format("DropPod.NotSpawned", count)</span> }
                        @if (saved != null) { <span class="badge modified-badge">@T["Common.Modified"]</span> }</div>
                    <p class="subtle" data-pod-slot-vanilla>@T.Markup("DropPod.Vanilla.Html", s.Current?.Name ?? T["Common.Empty"])</p>
                    <label>@T["DropPod.Contents"]
                        <select data-pod-slot-select disabled="@(Workspace.Project == null)" @onchange="e => Run(() => Workspace.SetEntityAsync(f.InstanceKey, e.Value?.ToString() ?? string.Empty))">
                            <option value="@PodPayloadReader.Empty" selected="@(value == PodPayloadReader.Empty)">@(s.Current == null ? T["DropPod.EmptyVanilla"] : T["Common.Empty"])</option>
                            @foreach (var category in pods.Categories)
                            {
                                var items = pods.Pickups.Where(p => p.Category == category.Key).OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToArray();
                                if (items.Length == 0) continue;
                                <optgroup label="@category.Value">
                                    @foreach (var p in items) { <option value="@p.SemanticId" selected="@(value == p.SemanticId)">@p.Name@(s.Current?.Pickup == p.SemanticId ? " " + T["DropPod.VanillaSuffix"] : "") · @Short(T, pods.LiveVerifiedPair(rack, s, p) ? LiveVerified : PodPayloadCatalog.CompatibilityIn(s, p), PodPayloadCatalog.LowPackageRisk(rack, s, p), AssetStatus.Pickup(sdk!, s, p))</option> }
                                </optgroup>
                            }
                        </select>
                    </label>
                    @if (chosen != null)
                    {
                        <div class="field-badges" data-pickup-badges="@chosen.SemanticId">
                            <span class="badge">@chosen.CategoryLabel</span>
                            @* A pickup Runtime verified live in this slot shows that instead of the catalog's generic "unverified" (from 0.28.0 its write in that slot
                               needs no allow_unverified_reference; with 0.27.0 the write still carries it). *@
                            @switch (pods.LiveVerifiedPair(rack, s, chosen) ? LiveVerified : PodPayloadCatalog.CompatibilityIn(s, chosen))
                            {
                                case "PROVEN_COMPATIBLE": <span class="badge green" data-pickup-badge="proven" title="@pods.CompatibilityStates["PROVEN_COMPATIBLE"]">@T["DropPod.Proven"]</span> break;
                                case LiveVerified: break;
                                case "SCHEMA_COMPATIBLE": <span class="badge" data-pickup-badge="rack-compatible" title="@pods.CompatibilityStates["SCHEMA_COMPATIBLE"]">@T["DropPod.RackCompatible"]</span> break;
                                default: <span class="badge amber" data-pickup-badge="unverified" title="@pods.CompatibilityStates["UNVERIFIED_REFERENCE"]">@T["Common.Unverified"]</span> break;
                            }
                            @if (chosen.Evidence.WorldLoot || chosen.Evidence.StandalonePickup) { <span class="badge" data-pickup-badge="world" title="@chosen.CompatibilityBasis">@T["DropPod.WorldPickup"]</span> }
                            @if (pods.LiveVerifiedPair(rack, s, chosen)) { <span class="badge green" data-pickup-badge="live-pair" title="@T["DropPod.LivePair.Tooltip"]">@T["DropPod.LivePair"]</span> }
                            @* 0.27.0+: Runtime loads known packages itself, so package risk is replaced by the asset-loading state. *@
                            @if (AssetStatus.Pickup(sdk!, s, chosen) is { } assetView) { <AssetBadge View="assetView" Compact="true" /> }
                            else if (!PodPayloadCatalog.LowPackageRisk(rack, s, chosen)) { <span class="badge amber" data-pickup-badge="package-risk" title="@chosen.Residency.Basis">@T["DropPod.PackageRisk"]</span> }
                        </div>
                        @if (AssetStatus.Pickup(sdk!, s, chosen) is { Warning: true } unknownAssets) { <p class="asset-note" data-asset-warning>@unknownAssets.Description</p> }
                    }
                    @if (saved != null)
                    {
                        <div class="field-tools">
                            <label class="field-toggle" title="@T["DropPod.Include.Tooltip"]"><input type="checkbox" checked="@saved.Enabled" @onchange="() => Run(() => Workspace.ToggleEntityAsync(saved.InstanceKey))" /> @T["Common.On"]</label>
                            <button class="reset-action small" @onclick="() => Run(() => Workspace.ResetEntityAsync(instance: f.InstanceKey))">@T["DropPod.ResetSlot"]</button></div>
                        @if (EntityScalar.AcknowledgementRequired(f, saved.DesiredValue))
                        {
                            @* Slot/gameplay compatibility stays unverified even when the assets load automatically (allow_unverified_reference). *@
                            <AckPanel Title="@T["DropPod.Compatibility.Title"]" Kind="unverified" Description="@CompatibilityNote(T, pods, rack, s, chosen)"
                                PanelAttributes='@(new() { ["data-pod-compatibility-warning"] = "true" })' />
                        }
                        else if (EntityScalar.LiveProven(f, saved.DesiredValue))
                        {
                            @* 0.28.0: a pickup a live test used in exactly this slot is written without allow_unverified_reference (allow_shared stays). *@
                            <p class="subtle" data-pod-live-verified>@T["DropPod.Note.LiveVerifiedNoFlag"]</p>
                        }
                        @if (Workspace.EntityIssue(saved) is { } issue) { <p class="notice warning">@issue</p> }
                    }
                </article>
            }
            </div>
            @if (!ModifiedOnly && rack.AuthoredSlots.Any(s => !s.Writable)) { <p class="subtle field-blocker">@T.Format("DropPod.ReadOnlySlots", string.Join(", ", rack.AuthoredSlots.Where(s => !s.Writable).Select(s => s.Slot)))</p> }
            @if (spawn != null && EntityChangeService.Saved(Workspace.Project, spawn) != null)
            {
                <AckPanel Title="@T["DropPod.SpawnCount.Unverified"]" Kind="unverified"
                    Description="@T["DropPod.SpawnCount.Unverified.Description"]" />
            }
            @if (rack.Shared && edited.Length > 0)
            {
                <AckPanel Title="@T["DropPod.Shared.Title"]" Kind="shared"
                    Description="@T["DropPod.Shared.Description"]" Items="@rack.Consumers.Select(c => c.Name).ToArray()" ItemsLabel="@T["DropPod.Shared.ItemsLabel"]" />
            }
        }
        @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
    </section>
    }
}
@code {
    [Parameter, EditorRequired] public string Rack { get; set; } = "";
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private IReadOnlyDictionary<string, string> Tiers => new Dictionary<string, string> { ["structural_reference"] = T["DropPod.Tier.StructuralReference"] };
    private static int Int(System.Text.Json.JsonElement v) => v.ValueKind == System.Text.Json.JsonValueKind.Number && v.TryGetInt32(out var i) ? i : 0;
    private const string LiveVerified = "LIVE_VERIFIED";
    private static string Short(IUiText t, string compatibility, bool lowRisk, AssetStatusView? assets) => (compatibility switch { "PROVEN_COMPATIBLE" => t["DropPod.Proven"], "SCHEMA_COMPATIBLE" => t["DropPod.RackCompatible"], LiveVerified => t["DropPod.LiveVerifiedHere"], _ => t["Common.Unverified"] })
        + (assets != null ? (assets.State == AssetState.None ? "" : " · " + assets.Short) : lowRisk ? "" : " · " + t["DropPod.Short.PackageRisk"]);
    // What the replacement acknowledgement covers. From 0.27.0 package loading is Runtime's job, so this is only slot compatibility.
    private static string CompatibilityNote(IUiText t, PodPayloadCatalog pods, PodRack rack, PodRackSlot slot, Pickup? chosen)
    {
        if (pods.PackageResidency == null) return chosen != null && !PodPayloadCatalog.LowPackageRisk(rack, slot, chosen) ? pods.PackageRisk : t["DropPod.Note.NotVanilla"];
        if (chosen == null) return t["DropPod.Note.EmptySlot"];
        return pods.LiveVerifiedPair(rack, slot, chosen) ? t["DropPod.Note.LiveVerified"] : t["DropPod.Note.AssetsNotBehaviour"];
    }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

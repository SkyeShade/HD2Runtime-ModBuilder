@inject BuilderWorkspace Workspace
@using System.Text.Json
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Advanced?.Support; var authoring = sdk?.SupportAuthoring; var links = sdk?.SupportLinks; }
<div class="page-heading"><div><div class="eyebrow">@T.Format(authoring == null ? "Support.Page.EyebrowReadOnly" : "Support.Page.Eyebrow", sdk?.Version)</div><h1>@T["Support.Page.Title"]</h1><p><span class="category-pill static cat-support"><span class="cat-dot" aria-hidden="true"></span>@StratagemCategories.Support.Label</span>@(links == null ? T.Format("Support.Page.DescriptionNoLinks", sdk?.Version) : T["Support.Page.Description"])</p></div></div>
@if (links != null) { <p class="notice cat-note cat-support" data-linked-support-count="@links.ByWeapon.Count">@T.Plural("Support.LinkedCount", links.ByWeapon.Count)</p> }
@if (Workspace.Project is { } active) { <p class="subtle">@T.Format("Support.Page.ProjectLine", active.DisplayName, active.SdkVersion)</p> }
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert"><strong>@T["Support.BuildReview"]</strong><p>@issue</p></div> }
@if (catalog == null)
{ <section class="panel"><h2>@T["Support.NoCatalog.Title"]</h2><p>@T["Support.NoCatalog.Help"]</p></section> }
else
{
    <div class="weapon-editor"><section class="panel weapon-browser"><h2>@T.Plural("Support.List.Count", Listed(catalog, authoring, links).Count())</h2><label>@T["Common.Search"]<input id="support-search" @bind="Search" @bind:event="oninput" placeholder="@T["Support.Search.Placeholder"]" /></label>
    @if (authoring != null) { <label>@T["Support.Filter.Family"]<select @bind="Family"><option value="">@T["Support.Filter.AllFamilies"]</option>@foreach (var family in authoring.Weapons.SelectMany(w => w.Family).Concat(authoring.FieldInstances.Select(f => f.Display.Domain)).Select(f => f.ToLowerInvariant()).Distinct().Order()) { <option value="@family">@SupportAuthoringEditor.Label(T, family)</option> }</select></label><label><input type="checkbox" @bind="WritableOnly" /> @T["Support.Filter.WritableOnly"]</label><label><input type="checkbox" @bind="SharedOnly" /> @T["Support.Filter.SharedOnly"]</label><p>@T.Format("Support.WritableIdentities", authoring.Weapons.Count(w => w.Writable))</p> }
    <div class="weapon-list">@foreach (var w in Listed(catalog, authoring, links).Where(w => (w.CatalogIdentity + " " + w.WeaponType + " " + string.Join(" ", w.Traits)).Contains(Search, StringComparison.OrdinalIgnoreCase)))
    { <button class="resource-item @(Selected == w.CatalogIdentity ? "active" : "")" data-support="@w.CatalogIdentity" @onclick="() => Selected = w.CatalogIdentity"><strong>@w.CatalogIdentity</strong><small>@w.WeaponType · @w.IdentityResolution</small></button> }</div></section>
    <div class="weapon-detail">
    @if (catalog.Weapons.ContainsKey(Selected) && links?.ForWeapon(Selected) == null) { <SupportWeaponDetail Weapon="@Selected" Changed="Refresh" @key="Selected" /> }
    else { <section class="panel"><h2>@T["Support.Empty.Title"]</h2><p>@T["Support.Empty.Help"]</p></section> }
    </div></div>
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private string Search = "", Selected = "", Family = ""; private bool WritableOnly, SharedOnly;
    // Weapons with a published call-in link live inside that stratagem's editor; only unlinked weapons stay here.
    private IEnumerable<SupportWeapon> Listed(SupportCatalog catalog, SupportAuthoringCatalog? authoring, SupportCallInIndex? links)
        => catalog.Weapons.Values.Where(w => links?.ForWeapon(w.CatalogIdentity) == null && Matches(w, authoring));
    private bool Matches(SupportWeapon w, SupportAuthoringCatalog? catalog) {
        if (catalog == null) return true;
        var descriptor = catalog.Weapons.Single(x => x.Name == w.CatalogIdentity);
        var fields = catalog.FieldInstances.Where(f => f.SupportWeapon == w.CatalogIdentity);
        return (!WritableOnly || descriptor.Writable) && (!SharedOnly || fields.Any(f => f.SharedScope.Shared))
            && (Family.Length == 0 || descriptor.Family.Contains(Family, StringComparer.OrdinalIgnoreCase) || fields.Any(f => f.Display.Domain == Family));
    }
}

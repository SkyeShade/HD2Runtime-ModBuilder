@inject BuilderWorkspace Workspace
@* One published support-weapon scalar as a compact row. Shared and unverified-effect guards stay visible as badges. *@
@{ var saved = Workspace.Project?.SupportChanges.SingleOrDefault(c => c.InstanceKey == Field.InstanceKey); }
<div class="field-row @(saved != null ? "modified" : "")" data-support-field="@Field.InstanceKey" data-semantic-field="@Field.SemanticFieldId" data-support-role="@Field.Target.AttackRole">
    <div class="field-name"><span>@Field.Display.Name</span>@if (!string.IsNullOrEmpty(Field.Value.Unit)) { <small class="field-unit">@Field.Value.Unit!.Replace('_', ' ')</small> }
        <span class="field-flags">
            @if (Field.SharedScope.RequiresAcknowledgement) { <span class="badge amber" data-flag="allow_shared" title="Shared object: requires acknowledging its affected consumers">Shared</span> }
            @if (UnverifiedEffect) { <span class="badge amber" data-flag="allow_unverified_effect" title="@Field.Operation.AcknowledgementReason">Effect unproven</span> }
            @if (Field.Reticle?.Evidence is { GameplayProven: true } proven) { <span class="badge green" data-gameplay-proven title="@proven.GameplaySource">Gameplay-proven</span> }
            @if (saved != null) { <span class="badge modified-badge">Modified</span> }
        </span></div>
    <div class="field-value">
        @if (Field.Value.Type == "boolean") { <input type="checkbox" checked="@(Value == "true")" disabled="@(Workspace.Project == null)" @onchange="BooleanChanged" aria-label="@Field.Display.Name" /> }
        else { <input type="number" step="@(Field.Value.Type == "integer" ? "1" : "any")" value="@Value" disabled="@(Workspace.Project == null)" @onchange="e => Commit(e.Value?.ToString() ?? string.Empty)" aria-label="@Field.Display.Name" /> }
    </div>
    @if (saved != null) { <div class="field-baseline modified-value" data-baseline="@Format(saved.ExpectedValue)" data-desired="@Format(saved.DesiredValue)">Base @Display(saved.ExpectedValue) → <strong>@Display(saved.DesiredValue)</strong></div> }
    else { <div class="field-baseline subtle" data-baseline="@Format(Field.Value.Baseline)">Base @Display(Field.Value.Baseline)</div> }
    <div class="field-tools">
        @if (saved != null) { <OptionToggle Key="@ModOptionsService.SupportKey(Field.InstanceKey)" Changed="Changed" /> }
        @if (saved != null)
        {
            <label class="field-toggle" title="Include this change in the build"><input type="checkbox" checked="@saved.Enabled" @onchange="() => Run(() => Workspace.ToggleSupportAsync(Field.InstanceKey))" /> On</label>
            <button class="reset-action small" @onclick="Reset">Reset field</button>
        }
        <details class="field-info"><summary title="Why? / provenance">ⓘ</summary><div class="field-info-body">
            @if (UnverifiedEffect) { <p><strong>Effect unproven:</strong> @Field.Operation.AcknowledgementReason</p> }
            <p>@Field.Provenance.Baseline · @Field.Provenance.Ownership</p><p>@Field.Backing.SemanticType · @Field.Target.AttackRole</p><code>@Field.SemanticFieldId</code></div></details>
    </div>
    @* allow_unverified_effect is acknowledged once per group in SupportAuthoringEditor's panel. *@
    @if (saved != null && Workspace.SupportIssue(saved) is { } issue)
    {
        <div class="field-wide"><p class="notice warning">@issue</p>
            @if (saved.CapabilityEvidence != SupportChangeService.Evidence(Field) || !BaselineMatches(saved)) { <button @onclick="Review">Accept current capability / baseline</button> }</div>
    }
    @if (Error != null) { <p class="field-wide notice warning" role="alert">@Error</p> }
</div>
@code {
    [Parameter, EditorRequired] public SupportField Field { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    // 0.24.0+: Runtime requires allow_unverified_effect=true for this field.
    private bool UnverifiedEffect => Field.Operation.Acknowledgement == "allow_unverified_effect";
    private string Value => Format(Workspace.Project?.SupportChanges.SingleOrDefault(c => c.InstanceKey == Field.InstanceKey)?.DesiredValue ?? Field.Value.Baseline);
    private string Display(System.Text.Json.JsonElement value) => Field.Value.Type == "boolean" && value.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False
        ? (value.GetBoolean() ? "On" : "Off") : Field.Value.Type == WeaponCapability.FireModeSet && value.ValueKind == System.Text.Json.JsonValueKind.Array ? FireModes.Text(value) : Format(value);
    private string Format(System.Text.Json.JsonElement value)
    {
        try { return SupportScalar.Text(Field, value); }
        catch (Exception e) when (e is InvalidDataException or InvalidOperationException) { return value.GetRawText(); }
    }
    private bool BaselineMatches(SupportChange c)
    { try { return SupportScalar.Equal(Field, c.ExpectedValue, Field.Value.Baseline); } catch (InvalidDataException) { return false; } }
    private async Task Run(Func<Task> work) { try { await work(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
    private Task Commit(string value) => Run(() => Workspace.SetSupportAsync(Field.InstanceKey, value));
    private Task BooleanChanged(ChangeEventArgs e) => Commit((bool)e.Value! ? "true" : "false");
    private Task Reset() => Run(() => Workspace.ResetSupportAsync(instance: Field.InstanceKey));
    private Task Review() => Run(() => Workspace.SetSupportAsync(Field.InstanceKey, Value, true));
}

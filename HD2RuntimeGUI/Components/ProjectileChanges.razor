@inject BuilderWorkspace Workspace
@* Resetting a swap while stat edits exist on the replacement projectile asks, in the row, whether to keep them on the original. *@
@foreach (var change in Workspace.Project!.ProjectileChanges.Where(c => c.Weapon == Weapon).OrderBy(c => c.AttackRole))
{
    <div class="weapon-change modified" data-projectile-change="@change.AttackRole">
        <div class="change-row"><div class="change-name"><strong>@T.Format("Projectile.Title", change.AttackRole.Replace('_', ' '))</strong><span class="badge modified-badge">@T["Common.Modified"]</span><small>@change.Group · @(change.EnsureEnabled ? T["Composition.Ensure"] : T["Composition.ApplyOnce"])</small></div>
            <div class="modified-value">@change.ExpectedProjectile.Label → <strong>@change.ReplacementProjectile.Label</strong></div>
            <label class="switch-label"><input type="checkbox" checked="@change.Enabled" @onchange="() => Run(() => Workspace.ToggleProjectileAsync(change.Id))" />@T["Common.Enabled"]</label>
            <button class="reset-action" disabled="@(Pending?.Role == change.AttackRole)" @onclick="() => ResetProjectile(change)">@T["Projectile.Reset"]</button>
        </div>
        @if (Pending is { } pending && pending.Role == change.AttackRole)
        { <ProjectileSwapPrompt Current="change.ReplacementProjectile" Target="change.ExpectedProjectile" Edits="pending.Edits" Reset="true" Decide="keep => Decide(change, keep)" Cancel="() => Pending = null" /> }
        @if (Workspace.ProjectileIssue(change) is { } issue)
        { <div class="notice warning"><span>@issue</span><button @onclick="() => Run(() => Workspace.SetProjectileAsync(change.Weapon, change.AttackRole, change.ReplacementProjectile, true))">@T["Composition.AcceptBaseline"]</button></div> }
        @if (change.Notes != null) { <p>@change.Notes</p> }
    </div>
}
@* Attack outputs (0.28.0 development SDKs): the donor output an attack fires through its active projectile source. *@
@foreach (var output in (Workspace.Project!.AttackOutputChanges ?? []).Where(c => c.IsPlayer && c.Weapon == Weapon).OrderBy(c => c.AttackRole))
{
    <div class="weapon-change modified" data-attack-output-change="@output.AttackRole">
        <div class="change-row"><div class="change-name"><strong>@T.Format("Projectile.Title", output.AttackRole.Replace('_', ' '))</strong><span class="badge modified-badge">@T["Common.Modified"]</span><small>@output.Group · @(output.Mechanism == AttackOutputHost.AmmunitionMechanism ? T["AttackOutput.Via.Ammunition"] : T["AttackOutput.Via.Output"]) · @(output.EnsureEnabled ? T["Composition.Ensure"] : T["Composition.ApplyOnce"])</small></div>
            <div class="modified-value">@T.Markup("AttackOutput.FiresChange.Html", output.OutputName)</div>
            <label class="switch-label"><input type="checkbox" checked="@output.Enabled" @onchange="() => Run(() => Workspace.ToggleAttackOutputAsync(output.Id))" />@T["Common.Enabled"]</label>
            <button class="reset-action" @onclick="() => Run(() => Workspace.SetAttackOutputAsync(output.Weapon, output.AttackRole, null))">@T["Projectile.Reset"]</button>
        </div>
        @if (Workspace.AttackOutputIssue(output) is { } outputIssue)
        { <div class="notice warning"><span>@outputIssue</span><button @onclick="() => Run(() => Workspace.SetAttackOutputAsync(output.Weapon, output.AttackRole, output.Output))">@T["AttackOutput.AcceptCurrent"]</button></div> }
        @if (output.Acknowledgements.Length > 0) { <p class="subtle" data-attack-output-flags>@T.Format("AttackOutput.WrittenWith", string.Join(", ", output.Acknowledgements.Select(a => a + "=true")))</p> }
    </div>
}
@if (Result is { } result) { <ProjectileSwapResult Result="result" Dismiss="() => Result = null" /> }
@if (Error != null) { <p class="dialog-error" role="alert">@Error</p> }
@code {
    [Parameter, EditorRequired] public string Weapon { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private (string Role, IReadOnlyList<CompositionChange> Edits)? Pending;
    private ObjectEditCarryResult? Result;
    private Task ResetProjectile(ProjectileChange change)
    {
        var edits = Workspace.ObjectEditsOnCurrentProjectile(change.Weapon, change.AttackRole);
        Result = null;
        if (edits.Count > 0) { Pending = (change.AttackRole, edits); return Task.CompletedTask; }
        return Run(() => Workspace.SwapProjectileAsync(change.Weapon, change.AttackRole, null, keepValues: false));
    }
    private Task Decide(ProjectileChange change, bool keep) => Run(async () =>
    { var result = await Workspace.SwapProjectileAsync(change.Weapon, change.AttackRole, null, keep); Pending = null; Result = keep ? result : new(0, 0, []); });
    private async Task Run(Func<Task> action) { Error = null; try { await action(); await Changed.InvokeAsync(); } catch (Exception e) { Error = e.Message; } }
}

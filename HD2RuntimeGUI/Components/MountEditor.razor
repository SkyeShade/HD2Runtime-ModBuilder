@inject BuilderWorkspace Workspace
@* One vehicle mount slot. Only weapon slots Runtime marks swappable get a selector, and it offers only the published
   compatible replacements (same attack family). Values are published mounted-weapon semantic IDs. From SDK 0.27.0 the replacement's
   asset-loading state and the (still unverified) mount compatibility are shown separately. *@
@{ var field = Field; var saved = field == null ? null : EntityChangeService.Saved(Workspace.Project, field); var catalog = Catalog; }
<article class="stat-card mount-slot @(saved != null ? "modified" : "")" data-mount="@Mount.MountId" data-mount-kind="@Mount.CurrentKind">
    <div class="panel-heading"><h3>@Title(Mount.Label)</h3><span class="badge">@Mount.MountId</span>
        @if (field != null) { <EvidenceBadge Evidence="field.Evidence" Tiers="catalog.EvidenceTiers" /> }
        @if (saved != null) { <span class="badge modified-badge">@T["Common.Modified"]</span> }</div>
    @if (!Mount.Swappable || field == null)
    { <p class="subtle" data-mount-blocked>@T["Mount.NotSwapSlot"] @Mount.BlockedReason</p> }
    else
    {
        <p class="subtle">@T.Markup("Mount.Current.Html", Describe(T, catalog.Weapon(Mount.Current!.SemanticId)!), Mount.Current.AttackFamily)</p>
        @if (saved != null) { <p class="modified-value" data-desired="@saved.DesiredValue.GetString()">→ <strong>@Describe(T, catalog.Weapon(saved.DesiredValue.GetString()!)!)</strong></p> }
        <label>@T["Mount.Weapon.Label"]
            <select data-mount-select disabled="@(Workspace.Project == null || !field.Editable)" @onchange="e => Run(() => Workspace.SetEntityAsync(field.InstanceKey, e.Value?.ToString() ?? string.Empty))">
                <option value="@Mount.Current!.SemanticId" selected="@(saved == null)">@T.Format("Mount.Vanilla", Describe(T, catalog.Weapon(Mount.Current.SemanticId)!))</option>
                @foreach (var w in field.AllowedValues!.Where(v => v != Mount.Current.SemanticId).Select(v => catalog.Weapon(v)!).OrderBy(w => Describe(T, w), StringComparer.OrdinalIgnoreCase))
                { <option value="@w.SemanticId" selected="@(saved?.DesiredValue.GetString() == w.SemanticId)">@Describe(T, w)@AssetHint(w.SemanticId)</option> }
            </select>
        </label>
        <p class="subtle">@T.Plural("Mount.Replacements", field.AllowedValues!.Length, Mount.Current.AttackFamily) · <span class="badge amber" title="@T["Mount.OptIn.Tooltip"]">allow_unverified_reference=true</span></p>
        @if (saved != null)
        {
            var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed;
            @if (sdk?.Assets != null)
            {
                <AssetBadge View="AssetStatus.MountedWeapon(sdk, Mount.Current!.SemanticId, saved.DesiredValue.GetString()!)" />
                <AckPanel Title="@T["Mount.Compatibility.Title"]" Kind="unverified"
                    Description="@T["Mount.Compatibility.Description"]"
                    PanelAttributes='@(new() { ["data-residency-warning"] = "true", ["data-mount-compatibility-warning"] = "true" })' />
            }
            else
            {
                <AckPanel Title="@T["Mount.UnverifiedSwap.Title"]" Kind="unverified" Description="@field.ResidencyWarning"
                    PanelAttributes='@(new() { ["data-residency-warning"] = "true" })' />
            }
            <label><input type="checkbox" checked="@saved.Enabled" @onchange="() => Run(() => Workspace.ToggleEntityAsync(saved.InstanceKey))" /> @T["Common.Enabled"]</label>
            <button class="reset-action" @onclick="() => Run(() => Workspace.ResetEntityAsync(instance: field.InstanceKey))">@T["Mount.ResetSlot"]</button>
            @if (Workspace.EntityIssue(saved) is { } issue) { <p class="notice warning">@issue</p> }
        }
    }
    @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
</article>
@code {
    private string AssetHint(string replacement) => (Workspace.Metadata ?? Workspace.SdkStatus?.Installed) is { } sdk
        && AssetStatus.MountedWeapon(sdk, Mount.Current!.SemanticId, replacement) is { State: AssetState.Unknown } ? " · " + T["Mount.AssetsUnknown"] : "";
    [Parameter, EditorRequired] public VehicleMount Mount { get; set; } = null!;
    [Parameter, EditorRequired] public string Vehicle { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private VehicleCatalog Catalog => (Workspace.Metadata ?? Workspace.SdkStatus!.Installed)!.Entities!.Vehicles;
    private EntityField? Field => Catalog.FieldInstances.SingleOrDefault(f => f.Target.Vehicle == Vehicle && f.Target.Path == "mount" && f.Target.Mount == Mount.MountId);
    private static string Title(string s) => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(s);
    // Published display names repeat (for example several "unnamed mounted weapon" entities), so show the semantic-ID suffix
    // and who references the weapon to keep entries distinguishable. The value written is always the semantic ID.
    public static string Describe(IUiText t, MountedWeapon w)
    {
        var name = w.DisplayName.Replace('_', ' '); var suffix = w.SemanticId[(w.SemanticId.LastIndexOf('/') + 1)..][..6];
        var users = w.ReferencedBy.Select(r => r.Vehicle).Where(v => v != null).Distinct().Take(2).ToArray();
        return $"{name}{(w.Turret ? " · " + t["Mount.Describe.Turret"] : "")} · {suffix}" + (users.Length > 0 ? " · " + t.Format("Mount.Describe.On", string.Join(", ", users)) : "");
    }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

@inject BuilderWorkspace Workspace
@* One player-weapon field as a compact row. Shared-definition acknowledgement is made once per shared object in the
   section's acknowledgement panel; a new edit inherits it. Evidence, group and notes are behind the ⓘ toggle. *@
<div class="field-row @(Modified ? "modified" : "") @(CanEdit ? "" : "readonly")" data-field="@Field.SemanticFieldId">
    <div class="field-name"><span>@Field.DisplayName</span>@if (FieldPresentation.Unit(Field) is { Length: > 0 } unit) { <small class="field-unit">@unit</small> }
        <span class="field-flags">
            @if (Modified) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
            @if (Dirty) { <span class="badge">@T["WeaponField.Unsaved"]</span> }
            @if (SavedGroup?.Enabled == false) { <span class="badge">@T["WeaponField.Disabled"]</span> }
            @if (Field.AffectsMultipleWeapons) { <span class="badge amber" data-flag="allow_shared" title="@T["WeaponField.Shared.Tooltip"]">@T["Common.Shared"]</span> }
            @if (!CanEdit) { <span class="badge" title="@(Weapon.OrdinaryWritesBlocked ? Weapon.BlockReason : Field.Reason)">@(SavedGroup?.Conflict != null ? T["WeaponField.ResolveConflict"] : Field.DerivedReadOnly ? T["WeaponField.Derived"] : !Available ? T["WeaponField.Unavailable"] : T["Common.ReadOnly"])</span> }
        </span></div>
    <div class="field-value">
        @if (CanEdit)
        {
            @if (Field.Type == "boolean")
            { <label class="boolean-control"><input id="@InputId" type="checkbox" role="switch" checked='@(Value == "true")' disabled="@Busy" @onchange='async e => { Value = (bool)e.Value! ? "true" : "false"; await Commit(); }' aria-label="@Field.DisplayName" /><span>@(Value == "true" ? T["Common.On"] : T["FieldValue.Off"])</span></label> }
            else if (Field.Type == WeaponCapability.StatusReference)
            {
                var (allowed, none) = Workspace.StatusChoices(Field);
                <StatusReferenceSelect Allowed="allowed" AllowNone="none" Value="@Value" Label="@Field.DisplayName" Disabled="@Busy" Changed="async v => { Value = v; await Commit(); }" />
            }
            else if (Field.Type == "enum")
            { <select id="@InputId" @bind="Value" @bind:after="Commit" disabled="@Busy" aria-label="@Field.DisplayName">@foreach (var option in Field.EnumValues!.Where(p => Field.AllowedValues == null || Field.AllowedValues.Contains(p.Value.GetInt32()))) { <option value="@option.Value.GetRawText()">@FieldPresentation.EnumLabel(option.Key)</option> }</select> }
            else
            { <input id="@InputId" type="number" step='@(Field.Type == "integer" ? "1" : "any")' @bind="Value" @bind:after="Commit" disabled="@Busy" aria-label="@Field.DisplayName" /> }
        }
        else { <span class="readonly-value">@Display(CurrentValue)</span> }
    </div>
    <div class="field-baseline @(Modified ? "modified-value" : "subtle")" data-baseline="@FieldPresentation.Value(Field, Field.CurrentDefault)">@T.Format("WeaponField.Base", Display(Field.CurrentDefault))@if (Modified) { <span> → <strong>@Display(CurrentValue)</strong></span> }</div>
    <div class="field-tools">
        @if (SavedGroup != null || CanEdit) { <OptionToggle Key="@ModOptionsService.WeaponKey(Weapon.Name, Field.SemanticFieldId)" Changed="Changed" /> }
        @if (Busy) { <small role="status">@T["WeaponField.Saving"]</small> }
        @if (CanEdit && (Modified || FieldPresentation.Modified(Field, Change))) { <button class="reset-action small" @onclick="Reset" disabled="@Busy">@T["WeaponField.ResetField"]</button> }
        <details class="field-info"><summary title="@T["WeaponField.Info.Tooltip"]">ⓘ</summary><div class="field-info-body">
            @if (FieldPresentation.Explanation(T, Field) is { } explanation) { <p class="flag-explanation">@explanation</p> }
            @if (Field.DerivedReadOnly) { <p>@T["WeaponField.DerivedHelp"]</p> }
            @if (!CanEdit) { <p>@T.Markup("WeaponField.NotWritable.Html", Weapon.OrdinaryWritesBlocked ? Weapon.BlockReason : Field.Reason)</p> }
            @if (Field.AffectsMultipleWeapons) { <p>@(Field.SharedWithWeapons.Count > 0 ? T.Markup("WeaponField.SharedWith.Html", string.Join(", ", Field.SharedWithWeapons)) : T.Markup("WeaponField.SharedWithUnnamed.Html"))</p> }
            <p><span class="badge">@Field.Provenance.Label</span> @(Field.Backing?.Settings ?? Field.Backing?.Component ?? T["WeaponField.Calculated"])</p>
            <code>@Field.SemanticFieldId</code>
            <p>@Field.Provenance.Source</p><p>@T.Format("WeaponField.FamilyScope", string.Join(", ", Weapon.ImplementationFamilies), Field.WriteScope)</p>
            @if (Field.Backing is { } backing) { <p>@T.Format("WeaponField.Backing", backing.Kind, backing.Storage, backing.Offset, backing.Width, backing.RecordIndex, backing.Row)</p> }
            @if (Field.Provenance.PendingGameplayConfirmation) { <p>@T["WeaponField.GameplayPending"]</p> }
            @if (CanEdit)
            { <details class="field-options"><summary>@T["WeaponField.GroupNotes"]</summary><label>@T["WeaponField.AtomicGroup"]<input @bind="Group" @bind:after="Commit" disabled="@Busy" maxlength="120" /></label><label>@T["WeaponField.Notes"]<textarea @bind="Notes" @bind:after="Commit" disabled="@Busy" maxlength="4000"></textarea></label></details> }
        </div></details>
    </div>
    @if (SavedGroup?.Conflict != null) { <div class="field-wide"><WeaponAliasConflict Group="SavedGroup" Changed="AliasResolved" /></div> }
    @* 0.26.0: Runtime's allow_unverified_effect opt-in (reticle, burst length) is warned about next to the edit it covers. *@
    @if (Change != null && CompositionOptIns.EffectFor(Field, Change.DesiredValue) && FieldPresentation.Modified(Field, Change))
    {
        <div class="field-wide"><AckPanel Title="@T.Format("WeaponField.UnverifiedEffect.Title", Field.DisplayName)" Kind="unverified" Description="@Field.AcknowledgementReason" /></div>
    }
    @if (!CanEdit && Field.SemanticFieldId == FireModes.ReticleField) { <p class="field-wide subtle field-blocker" data-field-blocker>@(Weapon.OrdinaryWritesBlocked ? Weapon.BlockReason : Field.Reason)</p> }
    @if (Error != null) { <p class="field-wide dialog-error" role="alert">@Error</p> }
</div>

@code {
    [Parameter, EditorRequired] public PlayerWeapon Weapon { get; set; } = default!;
    [Parameter, EditorRequired] public WeaponCapability Field { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private HD2RuntimeGUI.Core.Generation.WeaponChangeGroup? SavedGroup => Workspace.WeaponGroupsFor(Weapon.Name).SingleOrDefault(g => g.FieldId == Field.SemanticFieldId);
    private WeaponChange? Change => SavedGroup?.Representative;
    private string InputId => "stat-" + Field.SemanticFieldId.Replace('.', '-');
    private System.Text.Json.JsonElement CurrentValue => FieldPresentation.Parse(Value) ?? Change?.DesiredValue ?? Field.CurrentDefault;
    private bool Modified => FieldPresentation.Differs(Field, Field.CurrentDefault, CurrentValue);
    private bool Dirty => FieldPresentation.Differs(Field, Change?.DesiredValue ?? Field.CurrentDefault, CurrentValue);
    private bool Available =>Field.CurrentDefault.ValueKind is not (System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined);
    private bool CanEdit => Field.IsPreferred && Field.WriteAccepted && Field.Editable && !Weapon.OrdinaryWritesBlocked && !Field.DerivedReadOnly && SavedGroup?.Conflict == null;
    private string Value = "", Group = "Gameplay", Notes = "";
    private string? Error;
    private bool Busy;
    private WeaponChange? LoadedChange;
    private string LoadedField = "";
    private async Task AliasResolved() => await Changed.InvokeAsync();
    // Status references show the status name the SDK publishes; every other value as FieldPresentation spells it.
    private string Display(System.Text.Json.JsonElement value) => Field.Type == WeaponCapability.StatusReference && value.ValueKind == System.Text.Json.JsonValueKind.String
        ? Workspace.StatusLabel(value.GetString()!) : FieldPresentation.DisplayValue(T, Field, value);
    protected override void OnParametersSet()
    {
        var key = Weapon.Name + Field.SemanticFieldId;
        if (LoadedField == key && ReferenceEquals(LoadedChange, Change)) return;
        LoadedField = key; LoadedChange = Change;
        Value = Field.Format(Change?.DesiredValue ?? Field.CurrentDefault);
        Group = Change?.Group ?? "Gameplay"; Notes = Change?.Notes ?? ""; Error = null;
    }
    private Task Commit()
    {
        // A status reference is a status key: saved as a JSON string.
        var value = Field.Type == WeaponCapability.StatusReference ? System.Text.Json.JsonSerializer.Serialize(Value) : Value; var group = Group; var notes = Notes;
        return Run(async () =>
        {
            await Workspace.SetWeaponChangeAsync(Weapon.Name, Field.SemanticFieldId, value, acknowledge: true, group, notes);
            Value = Field.Format(Change?.DesiredValue ?? Field.CurrentDefault);
        });
    }
    private async Task Reset() => await Run(async () => { await Workspace.ResetWeaponsAsync(Weapon.Name, Field.SemanticFieldId); Value = Field.Format(Field.CurrentDefault); });
    private readonly SemaphoreSlim commitGate = new(1);
    private async Task Run(Func<Task> action)
    {
        await commitGate.WaitAsync(); Busy = true; Error = null;
        try { await action(); await Changed.InvokeAsync(); }
        catch (Exception e) { Error = e.Message; }
        finally { Busy = false; commitGate.Release(); }
    }
}

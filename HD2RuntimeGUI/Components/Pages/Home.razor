@page "/"
@using HD2RuntimeGUI.Core
@inject BuilderWorkspace Workspace

<div class="desktop-shell" inert="@(Dialog != null)">
    <aside class="sidebar">
        <div class="brand"><BrandLockup Size="sm" /></div>
        <button class="nav-item @(Page == "library" ? "selected" : "")" data-nav="library" @onclick="ShowLibrary">▦ <span>@T["Nav.ProjectLibrary"]</span></button>
        @{ var nav = Navigation.Build(Workspace.Metadata ?? Workspace.SdkStatus?.Installed, Workspace.Project, ModificationCount); }
        <nav class="nav-group" aria-label="@T["Nav.Workspace.Aria"]">
            <div class="nav-caption">@T["Nav.Workspace.Caption"]</div>
            <div class="project-label @(Workspace.Project == null ? "empty" : "")">@(Workspace.Project?.DisplayName ?? T["Nav.NoProject"])</div>
            @foreach (var item in nav.Where(i => i.Section == Navigation.Workspace)) { @NavButton(item) }
        </nav>
        <nav class="nav-group research" aria-label="@T["Nav.Research.Aria"]">
            <div class="nav-caption">@T["Nav.Research.Caption"]</div>
            @foreach (var item in nav.Where(i => i.Section == Navigation.Research)) { @NavButton(item) }
        </nav>
        <div class="sidebar-bottom"><button class="nav-item @(Page == "settings" ? "selected" : "")" @onclick='() => Navigate("settings")'>⚙ <span>@T["Nav.Settings"]</span></button><div class="sdk-mini"><span class="status-dot @(Workspace.SdkStatus?.VerifiedOnline == true ? "online" : "")"></span><div>@(Workspace.SdkStatus?.Installed.Version is { } sdkVersion ? "SDK " + sdkVersion : T[Workspace.SdkError != null ? "Nav.Sdk.Unavailable" : "Nav.Sdk.Loading"])<small>@(Workspace.SdkStatus?.LocalSource != null ? T["Sdk.Status.LocalDevelopment"] : Workspace.SdkStatus?.VerifiedOnline == true ? T["Nav.Sdk.ReleaseVerified"] : T["Sdk.Status.Offline"])</small></div></div></div>
    </aside>
    <main class="workspace">
        <header class="titlebar"><span><span class="titlebar-product">HD2Runtime ModBuilder</span> <span class="crumb">/ @PageTitle</span></span><span class="subtle">@(Workspace.Project is null ? T["App.Titlebar.LocalWorkspace"] : T.Format("App.Titlebar.Binding", Workspace.Project.SdkVersion, Workspace.Project.RuntimeApi))</span></header>
        <AppUpdateBanner />
        @if (Busy) { <div class="activity" role="status">@T[BusyKey]</div> }
        @if (Error != null) { <div class="notice error" role="alert">@Error <button @onclick="() => Error = null" aria-label="@T["Home.DismissError"]">×</button></div> }
        @if (Notice != null) { <div class="notice success" role="status">@Notice.Text(T) <button @onclick="() => Notice = null" aria-label="@T["Home.DismissNotice"]">×</button></div> }
        <fieldset class="workspace-content" disabled="@Busy">
        @if (Page == "library")
        {
            <div class="page-heading"><div><div class="eyebrow">@T["ProjectLibrary.Eyebrow"]</div><h1>@T["ProjectLibrary.Title"]</h1><p>@T["ProjectLibrary.Tagline"]</p></div><div class="actions"><button @onclick="ImportProject">@T["ProjectLibrary.OpenProject"]</button><button class="primary" @onclick="BeginCreate">@T["ProjectLibrary.CreateNewMod"]</button></div></div>
            @if (Workspace.SdkStatus?.UpdateAvailable == true) { <div class="notice warning"><div><strong>@T.Format("ProjectLibrary.SdkUpdate.Title", Workspace.SdkStatus.Latest!.Version)</strong><p>@T["ProjectLibrary.SdkUpdate.Pinned"]</p></div><button @onclick='() => Navigate("settings")'>@T["ProjectLibrary.SdkUpdate.Review"]</button></div> }
            @if (Workspace.Library.Count == 0)
            { <section class="empty-state"><BrandLockup Size="lg" Tagline="true" /><h2>@T["ProjectLibrary.Empty.Title"]</h2><p>@T["ProjectLibrary.Empty.Help"]</p><button class="primary" @onclick="BeginCreate">@T["ProjectLibrary.Empty.Create"]</button><small>@T["ProjectLibrary.Empty.InstalledSeparately"]</small></section> }
            else
            {
                <div class="section-label">@T["ProjectLibrary.Projects"] <span>@Workspace.Library.Count</span></div><div class="project-grid">
                @foreach (var item in Workspace.Library)
                {
                    <article class="project-card"><button class="project-open" @onclick="() => OpenProject(item.Id)"><div class="project-monogram">@Initials(item.DisplayName)</div><span class="badge">SDK @item.SdkVersion</span><h2>@item.DisplayName</h2><code>@item.ResourceId</code><p>@T.Format("ProjectLibrary.Card.Modified", item.ModifiedAt.ToLocalTime().ToString(T["ProjectLibrary.DateTime.Format"], T.Culture))</p></button><div class="card-actions"><button @onclick="() => OpenProject(item.Id)">@T["ProjectLibrary.Card.Open"]</button><details><summary aria-label="@T["ProjectLibrary.Card.Actions"]">•••</summary><div class="menu"><button @onclick="() => BeginRename(item)">@T["ProjectLibrary.Card.Rename"]</button><button @onclick="() => BeginDuplicate(item)">@T["ProjectLibrary.Card.Duplicate"]</button><button @onclick="() => Run(() => Workspace.OpenProjectFolderAsync(item.Id))">@T["ProjectLibrary.Card.OpenFolder"]</button><button @onclick="() => ExportFromLibrary(item.Id)">@T["ProjectLibrary.Card.Export"]</button><button class="danger-text" @onclick="() => BeginRemove(item)">@T["ProjectLibrary.RemoveFromLibrary"]</button></div></details></div></article>
                }
                </div>
            }
            <div class="library-footnote"><span>01 &nbsp; @T["ProjectLibrary.Step.Create"]</span><span>02 &nbsp; @T["ProjectLibrary.Step.Configure"]</span><span>03 &nbsp; @T["ProjectLibrary.Step.Export"]</span></div>
        }
        else if (Workspace.Project == null && Page != "research" && Page != "settings")
        {
            <section class="empty-state workspace-empty" data-empty-workspace="@Page"><div class="empty-icon">◇</div><h2>@PageTitle</h2><p>@T["Home.NoProject.Help"]</p>
                <div class="actions"><button @onclick="ShowLibrary">@T["Home.NoProject.OpenLibrary"]</button><button class="primary" @onclick="BeginCreate">@T["ProjectLibrary.CreateNewMod"]</button></div></section>
        }
        else if (Page == "stratagems") { <Stratagems Category="@StratagemCategory" CategoryChanged="c => { StratagemCategory = c; StratagemSupportTab = null; }" SupportTab="@StratagemSupportTab" Changed="RefreshWeaponUI" /> }
        else if (Page == "support") { <SupportWeapons Changed="RefreshWeaponUI" /> }
        else if (Page == "boosters") { <Boosters Changed="RefreshWeaponUI" /> }
        else if (Page == "throwables") { <Throwables Changed="RefreshWeaponUI" /> }
        else if (Page == "scripting") { <CustomLuaPage Changed="RefreshWeaponUI" /> }
        else if (Page == "enemies") { <Enemies Kind="@EnemyAuthoringReader.Enemy" Changed="RefreshWeaponUI" /> }
        else if (Page == "structures") { <Enemies Kind="@EnemyAuthoringReader.Structure" Changed="RefreshWeaponUI" /> }
        else if (Page == "research") { <SnapshotBrowser /> }
        else if (Page == "settings")
        {
            <div class="page-heading"><div><div class="eyebrow">@T["Settings.Eyebrow"]</div><h1>@T["Settings.Title"]</h1><p>@T["Settings.Tagline"]</p></div></div>
            <LanguageSettings />
            <AppUpdateSettings />
            <section class="panel" data-sdk-updates><div class="panel-heading"><h2>@T["Sdk.Updates.Title"]</h2><span class="badge @(Workspace.SdkStatus?.LocalSource != null ? "amber" : "")" data-sdk-source>@(Workspace.SdkStatus == null ? T[Workspace.SdkError != null ? "Sdk.Status.NotLoaded" : "Sdk.Status.Loading"] : Workspace.SdkStatus.LocalSource != null ? T["Sdk.Status.LocalDevelopment"] : Workspace.SdkStatus.VerifiedOnline ? T["Sdk.Status.VerifiedOnline"] : T["Sdk.Status.Offline"])</span></div>@if (Workspace.SdkStatus is { } sdkStatus)
            {
                @if (sdkStatus.LocalSource is { } localSource) { <p class="notice warning" data-local-sdk="@localSource"><span>@T.Markup("Sdk.LocalBuild.Html", sdkStatus.Installed.Version, localSource)</span></p> }
                <div class="stats"><div><small>@(sdkStatus.LocalSource != null ? T["Sdk.Stats.LocalSdk"] : T["Sdk.Stats.InstalledSdk"])</small><strong data-installed-sdk>@(sdkStatus.LocalSource != null ? T.Format("Sdk.Stats.LocalVersion", sdkStatus.Installed.Version) : sdkStatus.Installed.Version)</strong></div><div><small>@T["Sdk.Stats.LatestRelease"]</small><strong data-latest-release>@(sdkStatus.Latest?.Version ?? T["Sdk.Stats.NotChecked"])</strong></div><div><small>@T["Sdk.Stats.SupportedUpTo"]</small><strong data-sdk-supported>@SdkCompatibility.NewestSupportedVersion</strong></div><div><small>@T["Sdk.Stats.ApiSchema"]</small><strong>@sdkStatus.Installed.ApiVersion / 1</strong></div></div><p>@sdkStatus.Message</p>
                @if (sdkStatus.NewerUnsupported is { } newer) { <p class="notice" data-sdk-newer-unsupported="@newer">@T.Format("Sdk.NewerUnsupported", newer)</p> }
            }
            else
            { <p class="notice warning" data-sdk-error>@(Workspace.SdkError is { } sdkError ? T.Format("Sdk.LoadFailed", sdkError) : T["Sdk.Loading"])</p> }<p class="subtle">@T["Sdk.Source"]</p><div class="actions"><button @onclick="CheckUpdates">@T["Sdk.CheckUpdates"]</button>@if (Workspace.SdkStatus?.UpdateAvailable == true) { <button class="primary" @onclick="InstallUpdate">@T["Sdk.InstallUpdate"]</button> }</div></section>
            @if (Workspace.SdkStatus?.Installed.PlayerWeapons is { } capabilities) { <section class="panel"><h2>@T["Sdk.Capabilities.Title"]</h2><p>@T.Format("Sdk.Capabilities.Summary", capabilities.Summary.Weapons, capabilities.Summary.FieldInstances, capabilities.Summary.WritableSemanticFieldDefinitions, capabilities.Summary.ReadOnlySemanticFieldDefinitions, capabilities.Summary.DerivedSemanticFieldDefinitions)</p><p>@T.Plural("Sdk.Capabilities.Ambiguous", capabilities.Summary.DuplicateWeapons)</p></section> }
            <LocalSdkSettings />
            <section class="panel" data-game-icons><h2>@T["Icons.Title"]</h2>
                <p>@T["Icons.Help"]</p>
                <label>@T["Icons.DataFolder.Label"]<input id="icon-data-path" @bind="IconDataPath" placeholder="…\steamapps\common\Helldivers 2\data" /></label>
                <div class="actions"><button data-import-icons @onclick="ImportIcons" disabled="@Icons.Importing">@(Icons.Importing ? T["Icons.Importing"] : Icons.Manifest == null ? T["Icons.Import"] : T["Icons.Reimport"])</button>@if (Icons.Manifest != null) { <button @onclick="RemoveIcons">@T["Icons.Remove"]</button> }</div>
                <label class="switch-label"><input type="checkbox" data-icons-auto checked="@Icons.AutoImportEnabled" @onchange="e => SetAutoImport((bool)e.Value!)" />@T["Icons.AutoImport.Label"]</label>
                @if (Icons.Importing) { <p class="subtle" data-icon-importing>@T.Format("Icons.ImportingBackground", Icons.LastReason)</p> }
                @if (Icons.Manifest is { } icons)
                {
                    var sdkIcons = Workspace.Metadata ?? Workspace.SdkStatus?.Installed;
                    var boosters = sdkIcons?.Entities?.Boosters?.Boosters ?? [];
                    <p class="subtle" data-icon-status>@T.Markup("Icons.Status.Html", Icons.Count("booster"), Icons.Count("stratagem"), icons.ImportedAt.ToLocalTime().ToString(T["Common.DateTime.Format"], T.Culture), icons.GameDataPath)
                        @if (boosters.Length > 0) { <span data-booster-icon-count>@T.Format("Icons.BoosterCount", boosters.Count(b => Icons.BoosterIcon(b) is { } k && Icons.Svg("booster", k) != null), boosters.Length)@(" ")</span> }
                        @if (sdkIcons?.Stratagems is { } catalog && catalog.Stratagems.Any(s => s.UiIcon != null))
                        {
                            var roots = catalog.Stratagems;
                            <span data-stratagem-icon-count>@(T.Format("Icons.StratagemCount", roots.Count(s => GameIconStore.StratagemIconKey(s) is { } k && Icons.Svg("stratagem", k) != null), roots.Length,
                                roots.Count(s => s.UiIcon?.State == "resolved"), roots.Count(s => s.UiIcon?.State == "empty_template"), roots.Count(s => s.UiIcon?.State == "unbound"), roots.Count(s => s.UiIcon?.State == "no_native_root")))</span>
                            @if (catalog.UiIconContract is { } contract && Icons.StratagemLibrarySha is { } sha && !sha.Equals(contract.LibrarySha256, StringComparison.OrdinalIgnoreCase))
                            { <span class="notice warning" data-icon-library-mismatch>@T.Format("Icons.LibraryMismatch", sdkIcons.Version)</span> }
                        }
                        else { <span>@T.Format("Icons.NoStratagemIdentities", sdkIcons?.Version)</span> }</p>
                }
                else { <p class="subtle" data-icon-status>@(T[!Icons.AutoImportEnabled ? "Icons.None.AutoOff" : GameIconStore.DefaultGameDataPath() is null ? "Icons.None.NoInstall" : "Icons.None.Auto"])</p> }
                @if (Icons.LastError != null) { <p class="notice warning" data-icon-import-error>@T.Format("Icons.AutoImportFailed", Icons.LastError)</p> }
            </section>
            <section class="panel"><h2>@T["Settings.Storage.Title"]</h2><code class="path">@Workspace.StorageLocation</code><p>@T["Settings.Storage.Help"]</p></section>
            <section class="panel about-panel" data-about><BrandLockup Size="lg" Tagline="true" /><p>HD2Runtime ModBuilder <span data-build-identity title="@BuildInfo.Commit">@BuildInfo.Identity</span> · .NET 10 · MAUI Blazor Hybrid</p><p>@T["Settings.About.Help"]</p></section>
        }
        else if (Workspace.Project is { } active)
        {
            <div class="page-heading"><div><div class="eyebrow">@PageTitle.ToUpperInvariant()</div><h1>@active.DisplayName</h1><code class="subtle">@active.ResourceId</code></div><button class="primary" @onclick="BuildExport">@T["Export.BuildButton"]</button></div>
            @if (Workspace.BuildError != null)
            {
                @* Edits left on a projectile an attack no longer fires are resolved in that weapon's Projectile section, not on Changes. *@
                <div class="notice warning" role="alert"><span>@T.Format("Home.BuildReview", Workspace.BuildError)</span>
                    @if (Workspace.WeaponWithOrphanedObjectEdits is { } orphanWeapon)
                    { @if (Page != "player-weapons") { <button data-fix-projectile @onclick="() => EditWeapon(orphanWeapon)">@T.Format("Home.BuildReview.OpenWeapon", orphanWeapon)</button> } }
                    else { <button @onclick='() => Navigate("changes")'>@T["Changes.Review"]</button> }</div>
            }
            @if (Page == "player-weapons") { <PlayerWeaponsEditor InitialWeapon="@EditingWeapon" Changed="RefreshWeaponUI" Review='() => Navigate("changes")' /> }
            else if (Page == "lua") { <LuaPreview Source="@Workspace.LuaPreview" /> }
            else if (Page == "overview")
            {
                @* Compact, authoring-focused Overview: facts strip, SDK notices, in-game options, details form and quick links.
                   Change lists live on the Changes page; the count here links to it. *@
                var sdkLabel = Workspace.Metadata?.Version ?? active.SdkVersion; var rebind = Workspace.SdkStatus?.Installed.Version != active.SdkVersion;
                <div class="overview-grid" data-overview>
                    <section class="panel overview-facts" data-overview-facts>
                        <dl class="fact-strip">
                            <div><dt>@T["Overview.Author"]</dt><dd data-fact="author">@active.Author</dd></div>
                            <div><dt>@T["Overview.Version"]</dt><dd data-fact="version">@active.Version</dd></div>
                            <div><dt>@T["Overview.Fact.Changes"]</dt><dd data-fact="changes"><button class="link-button" @onclick='() => Navigate("changes")'>@ModificationCount</button></dd></div>
                            <div><dt>SDK</dt><dd data-fact="sdk">@sdkLabel@if (rebind) { <span class="badge amber" title="@T.Format("Overview.Fact.SdkInstalled", Workspace.SdkStatus?.Installed.Version)">@T["Overview.Fact.Update"]</span> }</dd></div>
                            <div><dt>@T["Overview.Fact.Storage"]</dt><dd><span class="status-dot online"></span> @T["Overview.Fact.SavedLocally"]</dd></div>
                        </dl>
                        <div class="actions overview-actions">
                            <button @onclick="() => Run(() => Workspace.OpenProjectFolderAsync(active.Id))">@T["Overview.OpenFolder"]</button>
                            <button @onclick='() => Navigate("changes")'>@T["Changes.Review"]</button>
                            <details class="identity-info"><summary>@T["Overview.Identity.Title"]</summary><div class="identity-body">
                                <div class="metadata-row"><span>@T["Overview.Identity.ManagerGuid"]</span><code>@active.ManagerGuid</code></div>
                                <div class="metadata-row"><span>@T["Overview.Identity.Created"]</span><span>@active.CreatedAt.ToLocalTime().ToString("f", T.Culture)</span></div>
                                <div class="metadata-row"><span>@T["Overview.Identity.Format"]</span><span>@active.FormatVersion</span></div></div></details>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(active.Description)) { <p class="subtle overview-description">@active.Description</p> }
                        @if (Workspace.SdkStatus?.Installed is { } installed && SemVersion.Parse(installed.Version).CompareTo(SemVersion.Parse("0.23.0")) >= 0 && SemVersion.Parse(active.SdkVersion).CompareTo(SemVersion.Parse("0.23.0")) < 0 && (active.StratagemChanges.Count > 0 || active.SupportChanges.Count > 0))
                        { <p class="notice warning" data-runtime023-fixes>@T.Markup("Overview.Runtime023.Html", installed.Version)</p> }
                        @if (rebind)
                        {
                            <div class="notice rebind-notice" data-rebind-panel><div><strong>@(Workspace.SdkStatus?.LocalSource != null ? T["Overview.Rebind.LocalTitle"] : T["Overview.Rebind.Title"])</strong>
                                <p>@T.Format("Overview.Rebind.Help", Workspace.SdkStatus?.Installed.Version)</p>
                                @if (Workspace.SdkStatus?.LocalSource != null) { <p class="notice warning" data-local-rebind-warning>@T.Format("Overview.Rebind.LocalWarning", Workspace.SdkStatus.Installed.Version)</p> }</div>
                                <button data-rebind @onclick="() => Run(Workspace.RebindToInstalledSdkAsync)">@(Workspace.SdkStatus?.LocalSource != null ? T.Format("Overview.Rebind.ToLocal", Workspace.SdkStatus.Installed.Version) : T["Overview.Rebind.ToInstalled"])</button></div>
                        }
                    </section>
                    <ModOptionsOverview Changed="RefreshWeaponUI" />
                    <section class="panel overview-details" data-project-details><h2>@T["Overview.Details.Title"]</h2>
                        <form class="details-form" @onsubmit="SaveDetails" @onsubmit:preventDefault>
                            <label class="span-name">@T["Overview.Details.Name"]<input id="overview-name" @bind="OverviewName" required maxlength="120" /></label>
                            <label class="span-version">@T["Overview.Version"]<input id="overview-version" @bind="OverviewVersion" required /></label>
                            <label class="span-author">@T["Overview.Author"]<input id="overview-author" @bind="OverviewAuthor" required maxlength="120" /></label>
                            <label class="span-full">@T["Overview.Details.Description"]<textarea id="overview-description" @bind="OverviewDescription" maxlength="8000" rows="3"></textarea></label>
                            <div class="actions span-full"><button class="primary" type="submit">@T["Overview.Details.Save"]</button></div>
                        </form>
                    </section>
                    <nav class="panel quick-author" data-quick-author aria-label="@T["Overview.QuickAuthor.Aria"]"><span class="quick-author-label">@T["Overview.QuickAuthor.Label"]</span>
                        @if (Workspace.Metadata!.PlayerWeapons != null) { <button @onclick='() => Navigate("player-weapons")'>@T["Nav.PlayerWeapons"]</button> }
                        @if (Workspace.Metadata.Entities?.Throwables != null) { <button @onclick='() => Navigate("throwables")'>@T["Nav.Throwables"]</button> }
                        @if (Workspace.Metadata.Stratagems != null) { <button @onclick='() => NavigateTo("stratagems")'>@T["Nav.Stratagems"]</button> }
                        @if (Workspace.Metadata.Entities?.Boosters != null) { <button @onclick='() => Navigate("boosters")'>@T["Nav.Boosters"]</button> }
                        @if (Workspace.Metadata.Entities?.Enemies != null) { <button data-quick-enemies @onclick='() => Navigate("enemies")'>@T["Nav.Enemies"]</button><button @onclick='() => Navigate("structures")'>@T["Nav.Structures"]</button> }
                    </nav>
                </div>
            }
            else if (Page == "changes")
            {
                <WeaponChanges Edit="EditWeapon" Changed="RefreshWeaponUI" />
                <SupportChanges Changed="RefreshWeaponUI" />
                <StratagemChanges Changed="RefreshWeaponUI" />
                <EntityChanges Changed="RefreshWeaponUI" />
                @if (Workspace.Project?.CustomLua is { } customLua)
                {
                    <section class="panel" data-custom-lua-change><div class="panel-heading"><h2>@T["Changes.CustomLua.Title"]</h2><span class="badge @(customLua.Enabled ? "modified-badge" : "")">@(customLua.Enabled ? T["Changes.CustomLua.Included"] : T["Changes.CustomLua.NotIncluded"])</span></div>
                        <p class="subtle"><code>@CustomLuaSettings.RelativePath</code> · @T.Plural("Changes.CustomLua.Lines", LineCount(customLua.Source))</p>
                        @if (Workspace.CustomLuaSyncIssue() is { } syncIssue) { <p class="notice warning">@syncIssue</p> }
                        <button @onclick='() => Navigate("scripting")'>@T["Changes.CustomLua.Open"]</button></section>
                }
                @if (active.Changes.Count > 0) {
                <section class="panel"><div class="panel-heading"><h2>@T["Changes.Other.Title"]</h2><span class="badge">@T.Format("Changes.Other.Enabled", active.Changes.Count(c => c.Enabled))</span></div>
                    @foreach (var group in active.Changes.GroupBy(c => c.Group))
                    {
                        <h3 class="group-title">@group.Key</h3>
                        @foreach (var change in group)
                        { <div class="change-row @(change.Enabled ? "" : "disabled-row")"><label class="switch-label"><input type="checkbox" role="switch" checked="@change.Enabled" @onchange="() => Run(() => Workspace.ToggleChangeAsync(change.Id))" aria-label="@T["Changes.Other.Enable"]" /></label><div class="change-name"><strong>@Workspace.Metadata!.Resources[change.Target].Label</strong><small>@Workspace.Metadata.Resources[change.Target].Fields[change.Field].Label · @(change.EnsureEnabled ? T["Changes.Other.Ensure"] : T["Changes.Other.ApplyOnce"])</small></div><div class="change-value modified-value">@change.ExpectedValue <span>→</span> <strong>@change.NewValue</strong></div><button @onclick="() => EditChange(change)">@T["Common.Edit"]</button><button class="quiet danger-text" @onclick="() => Run(() => Workspace.RemoveChangeAsync(change.Id))" aria-label="@T["Changes.Other.Remove"]">×</button></div> }
                    }
                </section> }<LuaPreview Source="@Workspace.LuaPreview" />
            }
            else if (Page == "export")
            {
                <section class="panel"><h2>@T["Export.Title"]</h2><p>@T.Format("Export.Help", active.SdkVersion, active.RuntimeApi)</p><label for="export-directory">@T["Export.Directory.Label"]</label><div class="input-action"><input id="export-directory" @bind="ExportDirectory" /><button @onclick="SaveExportDirectory">@T["Export.Directory.Save"]</button></div><p class="subtle">@T["Export.Reproducible"]</p>@if (Workspace.Metadata?.Has028 == true) { <p class="subtle" data-export-apply-timing>@T.Markup("Export.ApplyTiming.Html", "registered operations settled")</p> }<button class="primary" @onclick="BuildExport">@T["Export.BuildButton"]</button></section>
                @if (Workspace.LastExport != null) { <section class="panel export-success" role="status"><span class="badge green">@T["Export.Succeeded"]</span><h2>@T["Export.Complete"]</h2><code class="path">@Workspace.LastExport</code><button @onclick="() => Run(Workspace.OpenExportAsync)">@T["Export.OpenFolder"]</button></section> }
                <LuaPreview Source="@Workspace.LuaPreview" />
            }
            else if (Workspace.Metadata!.Builders.ContainsKey(Page))
            {
                <div class="editor-grid"><section class="panel resource-panel"><h2>@Workspace.Metadata.CategoryName(Page)</h2><input aria-label="@T["Home.Legacy.Search.Aria"]" placeholder="@T["Home.Legacy.Search.Placeholder"]" @bind="Search" @bind:event="oninput" /><div class="resource-list">@foreach (var resource in VisibleResources) { <button class="resource-item @(TargetKey == resource.Key ? "active" : "")" @onclick="() => SelectResource(resource.Key)"><strong>@resource.Label</strong><small>@T.Plural("Home.Legacy.WritableFields", resource.Fields.Values.Count(f => f.Writable))</small></button> }</div></section>
                <section class="panel field-panel">
                    @if (SelectedResource is { } selected)
                    {
                        <div class="eyebrow">@T["Home.Legacy.MappedResource"]</div><h2>@selected.Label</h2><label for="field">@T["Home.Legacy.Field"]</label><select id="field" value="@FieldKey" @onchange="OnFieldChanged">@foreach (var itemField in selected.Fields.Values.OrderByDescending(f => f.Writable)) { <option value="@itemField.Name">@(itemField.Writable ? itemField.Label : T.Format("Home.Legacy.ReadOnlyOption", itemField.Label))</option> }</select>
                        @if (SelectedField is { } field)
                        {
                            <div class="field-title"><h3>@field.Label</h3>@if (LegacyDraftModified) { <span class="badge modified-badge">@T["Common.Modified"]</span> }<span class="badge @(field.Confidence == "Gameplay proven" ? "green" : "")">@ConfidenceLabel(field.Confidence)</span></div>@if (LegacyDraftModified) { <div class="value-comparison modified-value"><span class="original-value">@field.Expected</span><span> ? </span><strong>@NewValue</strong></div> }<div class="value-grid"><div class="baseline"><small>@T["Home.Legacy.Vanilla"]</small><strong>@(field.Expected?.ToJsonString() ?? T["Common.Unknown"])</strong></div><div><label for="modified-value">@T["Home.Legacy.ModifiedValue"]</label>
                                @if (!field.Writable) { <div class="readonly-value">@T["Common.ReadOnly"]</div> }
                                else if (field.ControlType == "enum") { <select id="modified-value" @bind="NewValue">@foreach (var option in field.EnumValues) { <option value="@option.Value?.ToJsonString()">@option.Key (@option.Value)</option> }</select> }
                                else if (field.ControlType is "bool" or "boolean") { <input id="modified-value" type="checkbox" role="switch" checked='@(NewValue == "true")' @onchange='e => NewValue = (bool)e.Value! ? "true" : "false"' /> }
                                else { <input id="modified-value" type="number" step='@(field.ValueType == "integer" ? "1" : "any")' @bind="NewValue" /> }
                            </div></div>
                            @if (field.Writable)
                            { <label class="switch-label"><input type="checkbox" role="switch" @bind="EnsureEnabled" /><span>@T["Home.Legacy.Ensure.Label"]<small>@T["Home.Legacy.Ensure.Help"]</small></span></label><label for="change-group">@T["Home.Legacy.ChangeGroup"]</label><input id="change-group" @bind="ChangeGroup" maxlength="120" /><p class="subtle">@T.Format("Home.Legacy.Supported", SupportedValues)</p><button class="primary" @onclick="AddChange">@(EditingChange is null ? T["Home.Legacy.Add"] : T["Home.Legacy.Save"])</button> }
                            <details class="provenance"><summary>@T["Home.Legacy.Evidence"]</summary><p>@field.Provenance</p><p>@Workspace.Metadata.EvidenceNote</p></details>
                        }
                    }
                    else { <h2>@T["Home.Legacy.SelectResource"]</h2><p>@T["Home.Legacy.NoResources"]</p> }
                </section></div><LuaPreview Source="@Workspace.LuaPreview" />
            }
        }
        </fieldset>
        <footer class="statusbar"><span><span class="status-dot online"></span> @T["App.Status.LocalWorkspace"]</span><span>@(Workspace.Project is null ? "HD2Runtime ModBuilder " + BuildInfo.Identity : T.Format("App.Status.AutoSaved", Workspace.Project.SdkVersion))</span></footer>
    </main>
</div>

@if (Dialog != null)
{
    <div class="modal-backdrop" @onkeydown="DialogKey"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-title" tabindex="-1" @ref="DialogElement"><fieldset disabled="@Busy">
    @if (Dialog == "update")
    { <span class="badge amber">@T["NewProject.Update.Badge"]</span><h2 id="dialog-title">@T["NewProject.Update.Title"]</h2><div class="stats"><div><small>@T["NewProject.Update.Installed"]</small><strong>@Ticket!.Status.Installed.Version</strong></div><div><small>@T["NewProject.Update.Latest"]</small><strong>@Ticket.Status.Latest!.Version</strong></div></div><p>@T["NewProject.Update.NotRecommended"]</p><p class="subtle">@T["NewProject.Update.Help"]</p><div class="actions"><button @onclick="() => ResolveSdk(UpdateDecision.IgnoreThisTime)">@T["NewProject.Update.Ignore"]</button><button class="primary" @onclick="() => ResolveSdk(UpdateDecision.InstallUpdate)">@T["Sdk.InstallUpdate"]</button></div> }
    else if (Dialog is "create" or "duplicate")
    {
        <div class="eyebrow">@T.Format(Dialog == "duplicate" ? "NewProject.Eyebrow.Duplicate" : "NewProject.Eyebrow.New", CreationSdk?.Version)</div><h2 id="dialog-title">@(Dialog == "duplicate" ? T["NewProject.Title.Duplicate"] : T["NewProject.Title.New"])</h2><p>@T["NewProject.Help"]</p><form @onsubmit="SubmitProject" @onsubmit:preventDefault><label for="mod-name">@T["NewProject.Name.Label"]</label><input id="mod-name" @bind="ModName" @bind:event="oninput" @bind:after="SuggestResourceId" required maxlength="120" placeholder="@T["NewProject.Name.Placeholder"]" /><div class="form-grid"><div><label for="author">@T["NewProject.Author.Label"]</label><input id="author" @bind="Author" @bind:event="oninput" @bind:after="SuggestResourceId" required maxlength="120" /></div><div><label for="version">@T["NewProject.Version.Label"]</label><input id="version" @bind="ModVersion" required placeholder="0.1.0" /></div></div><label for="resource-id">@T["NewProject.ResourceId.Label"]</label><input id="resource-id" @bind="ResourceId" @bind:event="oninput" @bind:after="ResourceIdTyped" required placeholder="mods/your_name/my_mod" /><small class="hint">@(ResourceIdEdited ? T["NewProject.ResourceId.HintCustom"] : T["NewProject.ResourceId.HintSuggested"])</small><label for="description">@T["NewProject.Description.Label"] <span class="subtle">@T["NewProject.Description.Optional"]</span></label><textarea id="description" @bind="Description" rows="3" maxlength="8000"></textarea><div class="actions end"><button type="button" @onclick="CloseDialog">@T["Common.Cancel"]</button><button type="submit" class="primary">@(Dialog == "duplicate" ? T["NewProject.Submit.Duplicate"] : T["NewProject.Submit.New"])</button></div></form>
    }
    else if (Dialog == "rename")
    { <h2 id="dialog-title">@T["ProjectLibrary.Rename.Title"]</h2><label for="rename">@T["ProjectLibrary.Rename.Label"]</label><input id="rename" @bind="ModName" maxlength="120" /><p>@T["ProjectLibrary.Rename.Help"]</p><div class="actions end"><button @onclick="CloseDialog">@T["Common.Cancel"]</button><button class="primary" @onclick="SubmitRename">@T["ProjectLibrary.Rename.Save"]</button></div> }
    else if (Dialog == "remove")
    { <h2 id="dialog-title">@T.Format("ProjectLibrary.Remove.Title", ModName)</h2><p>@T["ProjectLibrary.Remove.Help"]</p><div class="actions end"><button @onclick="CloseDialog">@T["Common.Cancel"]</button><button class="danger" @onclick="SubmitRemove">@T["ProjectLibrary.RemoveFromLibrary"]</button></div> }
    @if (Error != null) { <p class="dialog-error" role="alert">@Error</p> }
    @if (Busy) { <p role="status">@T[BusyKey]</p> }
    </fieldset></section></div>
}
@code {
    private RenderFragment NavButton(NavItem item) => @<button class="nav-item @(item.Child ? "nav-child" : "") @item.CssClass @(IsSelected(item) ? "selected" : "") @(item.RequiresProject && Workspace.Project == null ? "no-project" : "")"
        data-nav="@item.Page" aria-current="@(IsSelected(item) ? "page" : null)" @onclick="() => NavigateTo(item.Page)">
        @if (item.CssClass != null) { <span class="cat-dot" aria-hidden="true"></span> }<span>@item.Label</span>@if (item.Count is { } count) { <small>@count</small> }</button>;
}

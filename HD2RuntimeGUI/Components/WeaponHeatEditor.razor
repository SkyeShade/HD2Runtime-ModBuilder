@inject BuilderWorkspace Workspace

@if (Workspace.Metadata?.PlayerHeat?.Weapons.SingleOrDefault(w => w.Weapon == Weapon.Name) is { HeatMechanismPresent: true } heat)
{
    <section class="semantic-section" data-section="Heat / Heatsink">
        <h2>Heat / Heatsink</h2>
        <p class="subtle">Direct heat and heatsink mechanics. These changes do not edit the read-only attachment presets.</p>
        @foreach (var section in Weapon.Fields.Where(f => f.IsPreferred && f.Domain is "heat" or "heatsink")
            .GroupBy(f => f.Editable ? FieldPresentation.Section(f) : "Advanced / Read-only")
            .OrderBy(g => FieldPresentation.SectionOrder(g.Key)))
        {
            <h3>@section.Key</h3>
            <div class="stat-grid">
                @foreach (var field in section)
                {
                    <div>
                        <WeaponFieldEditor @key="(Weapon.Name, field.SemanticFieldId)" Weapon="Weapon" Field="field" Changed="Changed" />
                        @if (heat.Fields.Single(f => f.Id == field.SemanticFieldId) is { CorrelationMatches: false } evidence && evidence.WikiValue.ValueKind == System.Text.Json.JsonValueKind.Number)
                        {
                            <p class="notice warning">Catalog comparison: @evidence.WikiValue. The SDK native baseline is preserved; scaling/correlation is not proven.</p>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public PlayerWeapon Weapon { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
}

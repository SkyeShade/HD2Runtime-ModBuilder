@inject BuilderWorkspace Workspace
@inject GameIconStore Icons
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Entities?.Boosters; }
<div class="page-heading cat-booster"><div><div class="eyebrow">@T.Format("EntityPanel.GuardedEyebrow", sdk?.Version)</div><h1>@T["Booster.Page.Title"]</h1><p>@T.Markup("Booster.Page.Help.Html")</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">@T.Format("EntityPanel.BuildReview", issue)</div> }
@if (catalog != null) { <IconImportPrompt /> }
@if (catalog == null) { <section class="panel" data-booster-unavailable><h2>@T["Booster.Unavailable.Title"]</h2><p>@T.Format("Booster.Unavailable.Help", sdk?.Version)</p></section> }
else
{
    var boosters = catalog.Boosters.Where(b => string.Join(" ", b.Name, b.SemanticId, b.Identity.NativeName, b.Identity.Status).Contains(Search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(b => b.Writable).ThenBy(b => b.Name, StringComparer.Ordinal).ToArray();
    <div class="weapon-editor"><section class="panel weapon-browser"><h2>@T.Plural("Booster.List.Count", boosters.Length)</h2>
        <label>@T["Common.Search"]<input id="booster-search" @bind="Search" @bind:event="oninput" placeholder="@T["Booster.Search.Placeholder"]" /></label>
        <div class="weapon-list">@foreach (var b in boosters)
        {
            <button class="resource-item with-icon cat-booster @(Selected == b.Name ? "active" : "")" data-booster-item="@b.Name" data-booster-writable="@(b.Writable ? "true" : "false")" @onclick="() => Selected = b.Name">
                <GameIcon Kind="booster" Booster="b" Label="@b.Name" CssClass="cat-booster" /><span class="resource-text">
                <strong>@b.Name</strong><small>@(b.Writable ? T.Format("EntityPanel.WritableCount", b.FieldInstanceKeys.Length) : T["Common.ReadOnly"]) · @BoosterEditor.Status(T, b.Identity.Status)@(Modified(b.Name) ? " · " + T["EntityPanel.ListModified"] : "")</small></span></button>
        }</div>
    </section><div class="weapon-detail">
        @if (catalog.Find(Selected) != null) { <BoosterEditor Name="@Selected" Changed="Refresh" @key="Selected" /> }
        else { <section class="panel category-panel cat-booster"><h2>@T["Booster.Choose.Title"]</h2><p>@T.Format("Booster.Choose.Summary", catalog.Summary.Boosters, catalog.Summary.WritableBoosters, catalog.Summary.FieldInstances)</p><p class="subtle">@catalog.NativeModel.Ownership</p></section> }
    </div></div>
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private string Search = "", Selected = "";
    private bool Modified(string name) => Workspace.Project?.EntityChanges.Any(c => c.Resource == "booster" && c.Entity == name) == true;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
}

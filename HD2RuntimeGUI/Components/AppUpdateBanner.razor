@implements IDisposable
@inject AppUpdateService Updates
@* HD2Runtime ModBuilder application update banner (not the HD2Runtime SDK). Shown under the titlebar until dismissed or
   installed; one banner per available version. The outcome of an update finished before this start is shown once. *@
@if (Updates.PreviousResult is { } result)
{
    <div class="app-update-result @(result.Success ? "ok" : "failed")" role="status" data-app-update-result="@(result.Success ? "success" : "failed")">
        <span>@result.Message</span>
        @if (!result.Success) { <button class="link-button" @onclick="OpenNotes">View release</button> }
        <button class="app-update-close" aria-label="Dismiss" @onclick="Updates.ClearPreviousResult">×</button>
    </div>
}
@if (Updates.ShowBanner && Updates.Latest is { } latest)
{
    <section class="app-update-banner" role="region" aria-label="Application update" data-app-update-banner="@latest.Version">
        <BrandMark Size="34" CssClass="app-update-mark" />
        <div class="app-update-text">
            <strong>HD2Runtime ModBuilder @latest.Version is available</strong>
            <span>You're currently using @Updates.CurrentVersion.@if (Updates.Installing) { <span class="app-update-stage" data-app-update-stage> @Updates.InstallStage</span> }</span>
            @if (Updates.InstallError is { } error) { <span class="app-update-error" role="alert" data-app-update-error>@error</span> }
        </div>
        <div class="app-update-actions">
            @if (Updates.InstallNeedsManualDownload) { <button class="primary" @onclick="OpenNotes" data-app-update-download>Open release page</button> }
            else { <button class="primary" disabled="@Updates.Installing" @onclick="Install" data-app-update-install>@(Updates.Installing ? "Installing…" : "Install update")</button> }
            <button @onclick="OpenNotes" data-app-update-notes>View release notes</button>
            <button class="app-update-dismiss" disabled="@Updates.Installing" @onclick="Updates.DismissAsync" data-app-update-dismiss>Dismiss</button>
        </div>
    </section>
}
@code {
    protected override void OnInitialized() => Updates.Changed += Refresh;
    public void Dispose() => Updates.Changed -= Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private Task Install() => Updates.InstallAsync();
    private async Task OpenNotes() { try { await Updates.OpenReleaseNotesAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException) { } }
}

@inject BuilderWorkspace Workspace
@* One resolved magazine attachment definition (hd2.weapon_attachment) as a compact group: capacity, starting / supply / spare magazines,
   and from 0.26.0 its reload duration and ergonomics modifier where the definition patches them. Writes need allow_shared and
   allow_unverified_effect; both are implicit and warned about once for the definition. Which magazine a player uses is not editable. *@
@{ var catalog = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.Entities?.Attachments; var a = catalog?.Attachment(Attachment); }
@if (catalog != null && a != null)
{
    var fields = a.FieldInstanceKeys.Select(k => catalog.FieldInstances.Single(f => f.InstanceKey == k))
        .Where(f => !ModifiedOnly || EntityChangeService.Saved(Workspace.Project, f) != null)
        .OrderBy(f => Array.IndexOf(FieldOrder, f.SemanticFieldId) is var i and >= 0 ? i : FieldOrder.Length).ToArray();
    var edited = a.FieldInstanceKeys.Any(k => Workspace.Project?.EntityChanges.Any(c => c.InstanceKey == k) == true);
    var consumers = a.CompatibleWeapons ?? a.Consumers.NativeDefaultOf;
    var locked = (a.Effects ?? []).Where(e => !e.Writable).ToArray();
    <article class="magazine-attachment @(edited ? "modified" : "")" data-attachment-id="@a.SemanticId" data-relationship="@Relationship">
        <div class="attachment-head"><strong>@(Option ?? a.Name)</strong>
            @if (Relationship == "native_resource_default") { <span class="badge green" data-default-magazine>@T["Magazine.DefaultMagazine"]</span> }
            else if (Relationship != null) { <span class="badge" data-relationship-badge title="@RelationshipDescription">@RelationshipLabel(Relationship)</span> }
            @if (edited) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
            <span class="badge amber" data-flag="allow_shared" title="@catalog.Acknowledgements["allow_shared"]">@T["Common.Shared"]</span>
            <span class="badge amber" data-flag="allow_unverified_effect" title="@catalog.Acknowledgements["allow_unverified_effect"]">@T["Magazine.EffectUnverified"]</span>
            <EvidenceBadge Evidence="new EntityEvidence(a.Evidence.Tier)" />
            <details class="field-info"><summary title="@T["Magazine.Info.Tooltip"]">ⓘ</summary><div class="field-info-body">
                <p>@a.Name</p>
                @if (RelationshipDescription != null) { <p>@(Weapon != null ? T.Markup("Magazine.WhyBelongs.Html", Weapon, RelationshipDescription) : T.Markup("Magazine.WhyBelongsThisWeapon.Html", RelationshipDescription))</p> }
                <p>@a.Consumers.ScopeNote</p>
                @if ((a.OtherPatchedEffects ?? []).Length > 0) { <p>@T.Format("Magazine.AlsoPatches", string.Join(", ", a.OtherPatchedEffects!))</p> }
            </div></details>
            @if (edited && Workspace.Project != null) { <button class="reset-action small" @onclick='() => Run(() => Workspace.ResetEntityAsync("weapon_attachment", a.SemanticId))'>@T["Magazine.Reset"]</button> }
        </div>
        <p class="attachment-meta subtle"><code data-semantic-id>@a.SemanticId</code>
            @if (consumers.Length > 0) { <span data-compatible-weapons> @T.Format(a.Consumers.ScopeComplete ? "Magazine.SharedBy" : "Magazine.SharedByIncomplete", string.Join(", ", consumers))</span> }</p>
        <div class="stat-grid">@foreach (var f in fields) { <EntityFieldEditor @key="f.InstanceKey" Field="f" Changed="FieldChanged" /> }</div>
        @if (locked.Length > 0 && !ModifiedOnly)
        { <p class="subtle locked-effects" data-locked-effects>@T.Format("Magazine.NotEditable", string.Join(" · ", locked.Select(e => e.Effect.Replace('_', ' ') + (e.Blocker != null ? " (" + e.Blocker + ")" : ""))))</p> }
        @if (edited && Workspace.Project != null)
        {
            <AckPanel Title="@T["Magazine.Ack.Title"]" Kind="unverified"
                Description="@T["Magazine.Ack.Description"]"
                Items="@(consumers.Length > 0 ? consumers : null)" ItemsLabel="@T["Magazine.Ack.Consumers"]" />
        }
        @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
    </article>
}
@code {
    [Parameter, EditorRequired] public string Attachment { get; set; } = "";
    [Parameter] public string? Option { get; set; }
    [Parameter] public string? Relationship { get; set; }
    [Parameter] public string? RelationshipDescription { get; set; }
    [Parameter] public string? Weapon { get; set; }
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private static readonly string[] FieldOrder = ["attachment.magazine_capacity", "attachment.starting_magazines", "attachment.magazines_from_supply",
        "attachment.spare_magazines", "attachment.reload_duration", "attachment.ergonomics_modifier"];
    private string RelationshipLabel(string relationship) => relationship switch
    {
        "catalog_effect_fingerprint_unique" or "catalog_effects_unique" => T["Magazine.Relationship.UniqueMatch"],
        "catalog_effects_unlock_list" => T["Magazine.Relationship.CatalogUnlockList"],
        "unlock_listed" => T["Magazine.Relationship.UnlockList"],
        _ => relationship.Replace('_', ' '),
    };
    // Handled here (not passed straight through) so this card re-renders its modified / acknowledgement state after a field edit.
    private Task FieldChanged() => Changed.InvokeAsync();
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

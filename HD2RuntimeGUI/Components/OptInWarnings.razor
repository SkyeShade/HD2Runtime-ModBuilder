@* Runtime opt-ins a write carries (allow_shared, allow_unverified_effect, allow_unverified_reference), each with why it is required. Opt-ins
   are implicit: the generated Lua always carries them and nothing needs ticking; these panels only make the risk visible. *@
@foreach (var flag in Acknowledgements.Order(StringComparer.Ordinal))
{
    <AckPanel Title="@Title(T, flag)" Kind="@(flag == "allow_shared" ? "shared" : "unverified")" Description="@(Reasons?.GetValueOrDefault(flag) ?? Default(T, flag))"
        PanelAttributes='@(new() { ["data-opt-in"] = flag })'>
        <p class="subtle">@T.Markup("OptIn.WrittenWith.Html", flag + "=true")</p>
    </AckPanel>
}
@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Acknowledgements { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, string>? Reasons { get; set; }
    // Flag names are Runtime identifiers (kept as written); their titles and explanations are ModBuilder's text.
    public static string Title(IUiText t, string flag) => flag switch
    {
        "allow_shared" => t["OptIn.Shared.Title"],
        "allow_unverified_effect" => t["OptIn.UnverifiedEffect.Title"],
        "allow_unverified_reference" => t["OptIn.UnverifiedReference.Title"],
        _ => flag,
    };
    public static string Default(IUiText t, string flag) => flag switch
    {
        "allow_shared" => t["OptIn.Shared.Reason"],
        "allow_unverified_effect" => t["OptIn.UnverifiedEffect.Reason"],
        "allow_unverified_reference" => t["OptIn.UnverifiedReference.Reason"],
        _ => t["OptIn.Other.Reason"],
    };
}

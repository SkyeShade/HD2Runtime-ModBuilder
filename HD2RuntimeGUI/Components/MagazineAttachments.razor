@inject BuilderWorkspace Workspace
@* Attachment-owned magazine values for one player weapon (SDK 0.23.1+), shown inside the weapon's Ammo / Magazine section.
   The weapon-level capacity is never aliased onto these; its placeholder fields are in Advanced / Read-only. *@
@{ var catalog = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.Entities?.Attachments; var entry = catalog?.Weapon(Weapon); }
@if (catalog != null && entry != null)
{
    var resolved = catalog.Resolved(entry); var unresolved = entry.MagazineSlot.Options.Where(o => !o.Resolved).ToArray();
    <div class="magazine-attachments" data-magazine-attachments="@Weapon">
        <p class="ownership-note" data-ammo-owned-by-attachment>Magazine values for this weapon are owned by the fitted magazine attachment.</p>
        @if (resolved.Count == 0) { <p class="notice" data-no-resolved>No magazine attachment definition is resolved for this weapon.</p> }
        @foreach (var (attachment, option, relationship) in resolved)
        { <MagazineAttachmentCard @key="attachment.SemanticId" Attachment="@attachment.SemanticId" Option="@option?.Name" Relationship="@relationship" Changed="Changed" /> }
        <details class="collapsed-group" data-other-magazines>
            <summary><strong>Other magazine options</strong> <span class="subtle">@entry.MagazineSlot.Options.Length options · @resolved.Count resolved</span>
                @if (unresolved.Length > 0) { <span class="badge" data-unresolved-count>@unresolved.Length unresolved</span> }</summary>
            @foreach (var o in unresolved)
            {
                <div class="unresolved-option" data-unresolved-option="@o.Name"><strong>@o.Name</strong> <span class="badge">@(o.Relationship == "catalog_effect_fingerprint_ambiguous" ? "Ambiguous" : "No native match")</span>
                    @if (o.Default) { <span class="badge">Catalog default</span> }
                    <span class="subtle">@(o.PublishedEffects.Capacity?.ToString() ?? "—") rounds · @(o.PublishedEffects.StartingMagazines?.ToString() ?? "—") starting · @(o.PublishedEffects.MaxMagazines?.ToString() ?? "—") max magazines</span>
                    <details class="field-info"><summary title="Why unresolved?">ⓘ</summary><div class="field-info-body"><p>@o.Blocker</p>
                        @if (o.Candidates.Length > 0) { <p>Candidates (not chosen):</p><ul>@foreach (var c in o.Candidates) { <li><code>@c</code> @catalog.Attachment(c)?.Name</li> }</ul> }</div></details>
                </div>
            }
            <p class="subtle" data-selection-blocked>Changing which magazine is selected is not supported: @catalog.Selection.Reason</p>
            @if (entry.MagazineSlot.BaseRecordCapacityIsPlaceholder)
            { <p class="subtle" data-placeholder-capacity>The weapon record's own capacity is a placeholder; it is listed read-only under Advanced / Read-only.</p> }
            <p class="subtle">@catalog.OwnershipModel.WriteScope</p>
        </details>
    </div>
}
@code {
    [Parameter, EditorRequired] public string Weapon { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
}

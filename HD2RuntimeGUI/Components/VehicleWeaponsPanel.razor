@inject BuilderWorkspace Workspace
@* 0.26.0 mounted vehicle weapons (VehicleWeaponCapabilities): one coherent section per mount. Each mount is its own weapon
   (hd2.vehicle(v):weapon(label)); Exosuit arms and tank weapons are never merged. Values are grouped as Runtime publishes them:
   the mount's own weapon (fire rate, ammo, reload, mount health/armor and hit zone), then its projectile, damage and explosion,
   which are shared rows. allow_shared is acknowledged once per shared native owner, next to the group it covers. *@
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var entities = sdk?.Entities; var weapons = entities?.VehicleWeapons; var vehicle = weapons?.Find(Vehicle); }
@if (entities != null && weapons != null && vehicle != null)
{
    var byKey = weapons.FieldInstances.ToDictionary(f => f.InstanceKey);
    bool Show(EntityField f) => !ModifiedOnly || EntityChangeService.Saved(Workspace.Project, f) != null;
    var mounts = vehicle.Mounts.Where(m => !ModifiedOnly || m.Weapon != null && m.Weapon.FieldGroups.Values.SelectMany(k => k).Any(k => Show(byKey[k]))).ToArray();
    @foreach (var m in mounts)
    {
        var swap = entities.Vehicles.Find(Vehicle)?.Mounts.FirstOrDefault(x => x.SlotIndex == m.Slot);
        var keys = m.Weapon?.FieldGroups.Values.SelectMany(k => k).ToArray() ?? [];
        var edited = keys.Any(k => EntityChangeService.Saved(Workspace.Project, byKey[k]) != null);
        <section class="panel vehicle-weapon @(edited ? "modified" : "")" data-vehicle-weapon="@(m.Weapon?.Key ?? Vehicle + " / " + m.Label)" data-mount-slot="@m.Slot" data-carrier="@vehicle.Carrier?.Kind">
            <div class="panel-heading">@if (vehicle.Carrier != null) { <h3>@T["VehicleWeapon.DroneWeapon"]</h3> } else { <h2>@MountTitle(m)</h2> }<span class="badge" title="@T["VehicleWeapon.MountLabel.Tooltip"]">@T.Format("VehicleWeapon.Slot", m.Slot, m.Label)</span>
                @if (swap?.Current is { } current) { <span class="badge" data-mounted-weapon>@current.DisplayName</span> }
                @if (m.Weapon?.Ownership.AlsoMountedAt is { Length: > 0 } also) { <span class="badge amber" title="@T["VehicleWeapon.AlsoMountedAt.Tooltip"]">@T.Format("VehicleWeapon.AlsoMountedAt", string.Join(", ", also))</span> }
                @if (edited) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
                @if (edited && Workspace.Project != null) { <button class="reset-action small" @onclick='() => Run(() => ResetMount(keys))'>@T["VehicleWeapon.ResetMount"]</button> }</div>
            @* 0.28.0 Guard Dog drones: the weapon is written through its backpack (the published carrier accessor), never through hd2.vehicle. *@
            @if (vehicle.Carrier is { } carrier && !ModifiedOnly)
            { <p class="subtle" data-carrier-api>@T.Markup("VehicleWeapon.Carrier.Html", carrier.Api)</p> }
            @if (m.Weapon == null) { <p class="subtle" data-mount-no-weapon>@m.Reason</p> }
            else
            {
                @if (swap is { Swappable: true } && !ModifiedOnly) { <details class="mount-swap"><summary>@T["VehicleWeapon.Swap"]</summary><MountEditor Mount="swap" Vehicle="@Vehicle" Changed="Refresh" /></details> }
                @foreach (var group in Groups.Where(m.Weapon.FieldGroups.ContainsKey).Concat(m.Weapon.FieldGroups.Keys.Where(g => !Groups.Contains(g)).Order(StringComparer.Ordinal)))
                {
                    var fields = (m.Weapon.FieldGroups.GetValueOrDefault(group) ?? []).Select(k => byKey[k]).Where(Show).ToArray();
                    if (fields.Length == 0) continue;
                    var published = fields.Select(f => weapons.Published[f.InstanceKey]).ToArray();
                    <div class="vehicle-weapon-group" data-vehicle-weapon-group="@group">
                        <h3 class="group-title">@GroupTitle(group) <span class="subtle scope-line" data-scope-line>@ScopeLine(published)</span></h3>
                        <div class="stat-grid">@foreach (var f in fields) { <EntityFieldEditor @key="f.InstanceKey" Field="f" Label="@FieldLabel(f)" Tiers="VehicleWeaponCatalog.Tiers" Changed="Refresh" /> }</div>
                        @if (!ModifiedOnly && fields.Any(f => f.IsStatusReference && f.Editable)) { <p class="subtle" data-status-help>@T["VehicleWeapon.Status.Help"]</p> }
                        @foreach (var slot in StrengthlessStatuses(fields))
                        { <p class="notice" data-status-strength-hint="@slot">@T.Format("VehicleWeapon.Status.StrengthHint", slot)</p> }
                        @foreach (var scope in fields.Where(f => f.AllowSharedRequired && EntityChangeService.Saved(Workspace.Project, f) != null).GroupBy(f => f.SharedScopeKey))
                        {
                            var p = weapons.Published[scope.First().InstanceKey];
                            <AckPanel Title="@SharedTitle(T, p.Scope)" Kind="shared"
                                Description="@weapons.Scopes.GetValueOrDefault(p.Scope)" Items="@(p.OtherConsumers.Length > 0 ? p.OtherConsumers.Distinct().ToArray() : null)" ItemsLabel="@T["VehicleWeapon.Shared.ItemsLabel"]"
                                PanelAttributes='@(new() { ["data-vehicle-shared-scope"] = p.Scope })' />
                        }
                    </div>
                }
                var unverified = keys.Where(k => EntityChangeService.Saved(Workspace.Project, byKey[k]) is { } c && EntityScalar.AcknowledgementRequired(byKey[k], c.DesiredValue)).ToArray();
                @if (unverified.Length > 0)
                {
                    <AckPanel Title="@T["VehicleWeapon.Unverified.Title"]" Kind="unverified"
                        Items="@unverified.Select(k => FieldLabel(byKey[k]) ?? byKey[k].DisplayName).Distinct().ToArray()" ItemsLabel="@T["VehicleWeapon.Unverified.ItemsLabel"]"
                        Description="@T["VehicleWeapon.Unverified.Description"]" />
                }
                @if (!ModifiedOnly && m.Weapon.Blocked.Length > 0)
                { <details class="blocked-fields"><summary>@T.Format("VehicleWeapon.NotWritable", m.Weapon.Blocked.Length)</summary>@foreach (var b in m.Weapon.Blocked) { <p data-blocked-field="@b.Field"><strong>@b.Field@(b.Attack != null ? " (" + b.Attack + ")" : ""):</strong> @b.Reason</p> }</details> }
            }
        </section>
    }
    @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
}
@code {
    [Parameter, EditorRequired] public string Vehicle { get; set; } = "";
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    // Known mount labels get a translated title (VehicleWeaponMount.Title keeps the English one); other labels show as published.
    private string MountTitle(VehicleWeaponMount m) => m.Label switch
    {
        "left_gun" => T["VehicleWeapon.Mount.LeftArm"], "right_gun" => T["VehicleWeapon.Mount.RightArm"], "attach_tank_gun" => T["VehicleWeapon.Mount.MainCannon"],
        "attach_tank_gun_mg" => T["VehicleWeapon.Mount.CoaxialMachineGun"], _ => m.Title,
    };
    // Published field groups in display order (0.28.0 adds beam and arc settings); any other published group follows, so no field is hidden.
    // data-vehicle-weapon-group keeps the group id, only the title is translated.
    private static readonly string[] Groups = ["local", "projectile", "beam", "arc", "damage", "explosion"];
    private string GroupTitle(string group) => group switch
    {
        "local" => T["Stratagem.Group.Weapon"], "projectile" => T["Stratagem.Group.Projectile"], "damage" => T["Stratagem.Group.Damage"], "explosion" => T["Stratagem.Group.Explosion"],
        "beam" => T["Stratagem.Group.Beam"], "arc" => T["Stratagem.Group.Arc"], _ => group,
    };
    // Status slots all publish the name "Status applied" / "Status strength": number them (slot 1-4 of the damage row).
    private string? FieldLabel(EntityField f) => MountedStatusSlots.Slot(f) is not int k ? null
        : MountedStatusSlots.IsStrength(f) ? T.Format("VehicleWeapon.StatusStrengthSlot", k) : T.Format("VehicleWeapon.StatusSlot", k);
    // A status newly attached to an empty slot whose strength is still 0 (the slot's strength field is published next to it).
    private IEnumerable<int> StrengthlessStatuses(IReadOnlyList<EntityField> fields) => fields
        .Where(f => f.IsStatusReference && f.CurrentDefault.GetString() == StatusReference.None && EntityChangeService.Saved(Workspace.Project, f) is { } c && c.DesiredValue.GetString() != StatusReference.None)
        .Select(f => MountedStatusSlots.Slot(f)!.Value)
        .Where(k => fields.FirstOrDefault(s => MountedStatusSlots.IsStrength(s) && MountedStatusSlots.Slot(s) == k) is { } strength
            && (EntityChangeService.Saved(Workspace.Project, strength)?.DesiredValue ?? strength.CurrentDefault) is { ValueKind: System.Text.Json.JsonValueKind.Number } v && v.GetDouble() == 0);
    // Distinguishes mount-local values, one weapon shared by several mounts, and shared projectile/damage/explosion definitions.
    private string ScopeLine(IReadOnlyList<VehicleWeaponFieldInstance> fields)
    {
        var scopes = fields.Select(f => f.Scope).Distinct().ToArray();
        var others = fields.SelectMany(f => f.OtherConsumers).Distinct().ToArray();
        if (scopes.All(s => s == "weapon_local")) return "· " + T["VehicleWeapon.Scope.Local"];
        var kind = scopes.Contains("shared_mounted_weapon") ? T["VehicleWeapon.Scope.SharedMounts"] : T["VehicleWeapon.Scope.SharedDefinition"];
        return others.Length == 0 ? "· " + kind : "· " + kind + " · " + T.Format("VehicleWeapon.Scope.AlsoUsedBy", others.Length);
    }
    private static string SharedTitle(IUiText t, string scope) => scope switch
    {
        "shared_mounted_weapon" => t["VehicleWeapon.Shared.MountedWeapon"],
        "shared_projectile" => t["VehicleWeapon.Shared.Projectile"],
        "shared_damage" => t["VehicleWeapon.Shared.Damage"],
        "shared_explosion" => t["VehicleWeapon.Shared.Explosion"],
        "shared_beam" => t["VehicleWeapon.Shared.Beam"],
        "shared_arc" => t["VehicleWeapon.Shared.Arc"],
        _ => t["VehicleWeapon.Shared.Object"],
    };
    private async Task ResetMount(IEnumerable<string> keys) { foreach (var k in keys) await Workspace.ResetEntityAsync(instance: k); }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

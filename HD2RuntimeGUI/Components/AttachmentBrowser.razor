@inject BuilderWorkspace Workspace
@using System.Text.Json
@* Catalog attachment compatibility (read-only). Collapsed to a one-line summary per category; magazine values that are writable
   are edited in the Ammo / Magazine section. *@
@{ var entry = Workspace.Metadata?.Composition?.Magazines.Weapons.SingleOrDefault(w => w.Weapon == Weapon); }
@if (entry?.Categories is { Count: > 0 } categories)
{
    <details class="semantic-section collapsed-section" data-section="Attachments">
        <summary><h2>@T["Attachment.Title"]</h2><span class="section-summary" data-attachment-summary>@string.Join(" · ", categories.Select(c => T.Plural("Attachment.CategorySummary", c.Options.Count, c.Category, c.Options.Count(o => o.OptionIdentityProven))))</span><span class="badge">@T["Common.ReadOnly"]</span></summary>
        <p class="subtle">@(Workspace.Metadata?.Entities?.Attachments is { } magazines ? T["Attachment.Help"] : T["Attachment.HelpNoEffects"])</p>
        @if (Workspace.Metadata?.Entities?.Attachments is { } superseding && categories.Any(c => c.Category == "Magazine"))
        { <p class="subtle" data-magazine-owner-superseded>@T.Format("Attachment.MagazineSuperseded", superseding.Supersedes.File, superseding.Supersedes.Note)</p> }
        @foreach (var category in categories)
        {
            <details class="collapsed-group" data-attachment-category="@category.Category"><summary><strong>@category.Category</strong> <span class="subtle">@T.Plural("Attachment.OptionSummary", category.Options.Count, category.Options.Count(o => o.OptionIdentityProven))</span></summary>
            @foreach (var option in category.Options)
            {
                <details class="attachment-option" data-attachment="@option.Name"><summary><strong>@option.Name</strong> <span class="badge">@(option.Default ? T["Attachment.Default"] : T["Attachment.Optional"])</span> <span class="subtle">@(option.OptionIdentityProven ? T["Attachment.IdentityProven"] : T["Attachment.Unresolved"])</span></summary>
                    <p>@T.Format("Attachment.Compatibility", option.CatalogAllowed ? T["Attachment.Yes"] : T["Attachment.Unproven"], option.OptionIdentityProven ? T["Attachment.Proven"] : T["Attachment.Unresolved"])</p>
                    @if (option.NativeOption != null) { <p>@option.NativeOption.Name</p> }
                    <EvidenceTree Value="@JsonSerializer.SerializeToElement(option.Effects, EvidenceOptions)" />
                    <p class="subtle">@option.Reason</p>
                </details>
            }
            </details>
        }
    </details>
}
@code {
    [Parameter] public string Weapon { get; set; } = "";
    private static readonly JsonSerializerOptions EvidenceOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
}

@inject BuilderWorkspace Workspace
@using System.Text.Json
@* Catalog attachment compatibility (read-only). Collapsed to a one-line summary per category; magazine values that are writable
   are edited in the Ammo / Magazine section. *@
@{ var entry = Workspace.Metadata?.Composition?.Magazines.Weapons.SingleOrDefault(w => w.Weapon == Weapon); }
@if (entry?.Categories is { Count: > 0 } categories)
{
    <details class="semantic-section collapsed-section" data-section="Attachments">
        <summary><h2>Attachments</h2><span class="section-summary" data-attachment-summary>@string.Join(" · ", categories.Select(c => $"{c.Category} {c.Options.Count} {(c.Options.Count == 1 ? "option" : "options")} · {c.Options.Count(o => o.OptionIdentityProven)} resolved"))</span><span class="badge">Read-only</span></summary>
        <p class="subtle">Catalog compatibility is separate from proven native identity.@(Workspace.Metadata?.Entities?.Attachments is { } magazines ? "" : " No option-owned writable effects are published.")</p>
        @if (Workspace.Metadata?.Entities?.Attachments is { } superseding && categories.Any(c => c.Category == "Magazine"))
        { <p class="subtle" data-magazine-owner-superseded>Magazine ammo ownership from @superseding.Supersedes.File is superseded by the Ammo / Magazine section: @superseding.Supersedes.Note</p> }
        @foreach (var category in categories)
        {
            <details class="collapsed-group" data-attachment-category="@category.Category"><summary><strong>@category.Category</strong> <span class="subtle">@category.Options.Count options · @category.Options.Count(o => o.OptionIdentityProven) resolved</span></summary>
            @foreach (var option in category.Options)
            {
                <details class="attachment-option" data-attachment="@option.Name"><summary><strong>@option.Name</strong> <span class="badge">@(option.Default ? "Default" : "Optional")</span> <span class="subtle">@(option.OptionIdentityProven ? "Native identity proven" : "Unresolved")</span></summary>
                    <p>Catalog compatible: @(option.CatalogAllowed ? "Yes" : "Unproven") · Native identity: @(option.OptionIdentityProven ? "Proven" : "Unresolved")</p>
                    @if (option.NativeOption != null) { <p>@option.NativeOption.Name</p> }
                    <EvidenceTree Value="@JsonSerializer.SerializeToElement(option.Effects, EvidenceOptions)" />
                    <p class="subtle">@option.Reason</p>
                </details>
            }
            </details>
        }
    </details>
}
@code {
    [Parameter] public string Weapon { get; set; } = "";
    private static readonly JsonSerializerOptions EvidenceOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
}

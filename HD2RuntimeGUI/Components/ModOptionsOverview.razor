@inject BuilderWorkspace Workspace
@using HD2RuntimeGUI.Core.Generation
@* Project feature card: in-game options (HD2Runtime hd2.options → CowboyBingus Mod Options Menu). A clear on/off control and a
   one-line status; page settings, fallback and the ordered rows (master toggle first) are under "Manage options". The editor's labels are
   UI text; the page title, master toggle label and description, row labels and choices are mod content (written into the generated Lua)
   and are shown exactly as typed or defaulted, never translated. *@
@if (Workspace.Project is { } project)
{
    var supported = Workspace.OptionsSupported; var enabled = Workspace.OptionsEnabled;
    var settings = project.ModOptions ?? ModOptionsService.Defaults(project); var targets = enabled ? Workspace.OptionTargets : [];
    var active = enabled ? ModOptionsService.ActiveRows(project, Workspace.Metadata!) : [];
    var issues = enabled ? Workspace.OptionIssues : [];
    <section class="panel feature-card mod-options @(enabled ? "on" : "")" data-mod-options>
        <div class="feature-head">
            <div><h2>@T["ModOptions.Title"]</h2>
                <p class="subtle">@T["ModOptions.Help"]</p></div>
            @if (supported)
            {
                <label class="feature-switch" title="@(enabled ? T["ModOptions.Switch.OffTooltip"] : T["ModOptions.Switch.OnTooltip"])">
                    <input type="checkbox" role="switch" data-options-enabled checked="@enabled" @onchange="e => Run(() => Workspace.SetModOptionsEnabledAsync((bool)e.Value!))" />
                    <span class="feature-switch-track" aria-hidden="true"></span><span class="feature-switch-label">@(enabled ? T["Common.Enabled"] : T["ModOptions.Switch.Enable"])</span>
                </label>
            }
        </div>
        @if (!supported)
        { <p class="subtle" data-options-unsupported>@T.Format("ModOptions.Unsupported", project.SdkVersion)</p> }
        else if (!enabled)
        { <p class="feature-status" data-options-status="off">@T["ModOptions.Status.Off"]</p> }
        else
        {
            var usesDefaults = ModOptionsService.UsesDefaultsWithoutMenu(Workspace.Metadata!, settings);
            <p class="feature-status" data-options-status="@(active.Count == 0 ? "empty" : "active")">
                @if (active.Count == 0) { <span data-options-empty>@T.Markup("ModOptions.Status.Empty.Html")</span> }
                else { <strong>@T.Plural("ModOptions.Status.Configurable", active.Count)</strong><span> · @T.Format("ModOptions.Status.MasterToggle", settings.MasterLabel)</span> }
                @if (issues.Count > 0) { <span class="badge amber" data-options-issue-count>@T.Format("ModOptions.Status.ToReview", issues.Count)</span> }
            </p>
            <div class="feature-note" data-options-optional data-options-fallback="@(usesDefaults ? "default" : "disable")">
                @(usesDefaults ? T["ModOptions.Optional.Defaults"] : T["ModOptions.Optional.Disable"])
                <details class="field-info inline-info"><summary title="@T["ModOptions.Info.Tooltip"]">ⓘ</summary><div class="field-info-body">
                    <p>@T["ModOptions.Info.Dependency"]</p>
                    <p>@T["ModOptions.Info.Expose"]</p></div></details>
            </div>
            <details class="options-manage" data-options-manage open="@(issues.Count > 0)">
                <summary><span class="options-manage-button">@T["ModOptions.Manage.Title"]</span> <small class="subtle">@T["ModOptions.Manage.Hint"]</small></summary>
                <div class="options-manage-body">
                    <form class="option-page" @onsubmit="SavePage" @onsubmit:preventDefault data-options-page>
                        <label>@T["ModOptions.Page.Title"]<input @bind="Title" maxlength="40" data-options-title /></label>
                        <label>@T["ModOptions.Page.Id"]<input @bind="PageId" maxlength="40" data-options-page-id /></label>
                        <label>@T["ModOptions.Page.MasterLabel"]<input @bind="MasterLabel" maxlength="64" data-options-master-label /></label>
                        <label>@T["ModOptions.Page.MasterDescription"]<input @bind="MasterDescription" maxlength="400" placeholder="@T["ModOptions.Page.Optional"]" /></label>
                        <div class="actions"><button type="submit">@T["ModOptions.Page.Save"]</button>
                            @if (ModOptionsService.FallbackSupported(Workspace.Metadata))
                            {
                                <label class="option-fallback">@T["ModOptions.Fallback.Label"]
                                    <select data-options-fallback-select value="@settings.Fallback" @onchange="e => Run(() => Workspace.SetOptionsFallbackAsync(e.Value?.ToString() ?? ModOptionsService.FallbackDefault))">
                                        <option value="default">@T["ModOptions.Fallback.Default"]</option>
                                        <option value="disable">@T["ModOptions.Fallback.Disable"]</option>
                                    </select></label>
                            }</div>
                    </form>
                    <table class="option-rows" data-option-rows>
                        <thead><tr><th>#</th><th>@T["ModOptions.Rows.Row"]</th><th>@T["ModOptions.Rows.Control"]</th><th>@T["ModOptions.Rows.Range"]</th><th>@T["ModOptions.Rows.Default"]</th><th>@T["ModOptions.Rows.Field"]</th><th></th></tr></thead>
                        <tbody>
                            <tr data-option-row="master"><td>1</td><td><strong>@settings.MasterLabel</strong></td><td>@T["ModOptions.Kind.Toggle"]</td><td>@T["ModOptions.Master.Values"]</td><td>@T["Common.On"]</td><td class="subtle">@T["ModOptions.Master.Scope"]</td><td></td></tr>
                            @for (var i = 0; i < settings.Rows.Count; i++)
                            {
                                var row = settings.Rows[i]; var target = targets.FirstOrDefault(t => t.Key == row.Key); var index = i;
                                var state = target == null ? T["ModOptions.State.Removed"] : !target.Eligible ? T["ModOptions.State.NotConfigurable"] : !target.Active ? T["ModOptions.State.Disabled"] : null;
                                <tr class="@(state != null ? "inactive" : "")" data-option-row="@row.Id">
                                    <td>@(i + 2)</td><td><strong>@row.Label</strong>@if (row.Gap) { <small class="subtle"> · @T["ModOptions.Row.Gap"]</small> }</td>
                                    <td>@(row.Kind == ModOptionsService.Choice ? T["ModOptions.Kind.Choice"] : T["ModOptions.Kind.Slider"])</td>
                                    <td>@(row.Kind == ModOptionsService.Choice ? string.Join(", ", row.Choices.Zip(row.Values, (c, v) => $"{c} ({ModOptionsService.Format(v)})")) : T.Format("ModOptions.Row.Range", ModOptionsService.Format(row.Min), ModOptionsService.Format(row.Max), ModOptionsService.Format(row.Step)))</td>
                                    <td>@(row.Kind == ModOptionsService.Choice ? row.Choices.ElementAtOrDefault(row.DefaultIndex - 1) : ModOptionsService.Format(row.Default))</td>
                                    <td>@(target?.Title ?? "—")@if (state != null) { <span class="badge amber" title="@T["ModOptions.State.Tooltip"]"> @state</span> }</td>
                                    <td class="row-actions">
                                        <button class="small" title="@T["ModOptions.Row.MoveUp"]" disabled="@(index == 0)" @onclick="() => Run(() => Workspace.MoveOptionRowAsync(row.Key, -1))">↑</button>
                                        <button class="small" title="@T["ModOptions.Row.MoveDown"]" disabled="@(index == settings.Rows.Count - 1)" @onclick="() => Run(() => Workspace.MoveOptionRowAsync(row.Key, 1))">↓</button>
                                        @if (target is { Eligible: true }) { <button class="small" data-option-edit="@row.Id" @onclick="() => Editing = target">@T["Common.Edit"]</button> }
                                        <button class="small reset-action" @onclick="() => Run(() => Workspace.RemoveOptionRowAsync(row.Key))">@T["Common.Remove"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @{ var available = targets.Where(t => t.Eligible && t.Active && settings.Rows.All(r => r.Key != t.Key)).ToArray(); }
                    @if (available.Length > 0)
                    {
                        <details class="collapsed-group" data-options-available><summary><strong>@T["ModOptions.Available.Title"]</strong> <span class="subtle">@available.Length</span></summary>
                            @foreach (var t in available) { <div class="option-available"><span>@t.Title</span><button class="small" data-expose-option="@t.Key" @onclick="() => Editing = t">@T["ModOptions.Available.Expose"]</button></div> }
                        </details>
                    }
                    @if (issues.Count > 0) { <ul class="notice warning" data-options-issues>@foreach (var issue in issues) { <li>@issue</li> }</ul> }
                    <p class="subtle">@T.Format("ModOptions.RowsUsed", active.Count + 1, ModOptionsService.MaxRows)</p>
                </div>
            </details>
        }
        @if (Error != null) { <p class="dialog-error" role="alert">@Error</p> }
    </section>
    @if (Editing is { } editing) { <OptionEditor Target="editing" OnClose="() => Editing = null" Changed="Changed" /> }
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private OptionTarget? Editing; private string? Error;
    private string Title = "", PageId = "", MasterLabel = "", MasterDescription = ""; private object? Loaded;
    protected override void OnParametersSet()
    {
        var settings = Workspace.Project?.ModOptions ?? (Workspace.Project is { } p ? ModOptionsService.Defaults(p) : null);
        if (settings == null || ReferenceEquals(Loaded, Workspace.Project?.ModOptions ?? (object?)Workspace.Project)) return;
        Loaded = Workspace.Project?.ModOptions ?? (object?)Workspace.Project;
        (Title, PageId, MasterLabel, MasterDescription) = (settings.Title, settings.PageId, settings.MasterLabel, settings.MasterDescription ?? "");
    }
    private Task SavePage() => Run(() => Workspace.SaveModOptionsPageAsync(PageId, Title, MasterLabel, MasterDescription));
    private async Task Run(Func<Task> action)
    {
        try { await action(); Error = null; Loaded = null; OnParametersSet(); await Changed.InvokeAsync(); }
        catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; }
    }
}

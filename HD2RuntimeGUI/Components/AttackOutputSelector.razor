@inject BuilderWorkspace Workspace
@* What one attack fires, through its active projectile source (AttackOutputCapabilities.json, 0.28.0 development SDKs). Runtime says which
   member the shot actually reads: the attack's own reference (ACTIVE_DIRECT), the default ammunition's projectile (INDIRECT, e.g. the AR-23
   Liberator), or nothing writable (AMBIGUOUS / BLOCKED, with the reason). Donors are the catalogued projectile outputs, with their class,
   package, proof and the opt-ins the write carries; refused donors show Runtime's reason. A dormant reference is never offered. *@
@{
    var catalog = Workspace.Metadata!.AttackOutputs!;
    var source = catalog.Source(Weapon, Attack.Role);
    var host = Workspace.OutputHost(Weapon, Attack.Role, out var reason);
    var output = Workspace.AttackOutput(Weapon, Attack.Role);
    var classic = Workspace.Project!.ProjectileChanges.SingleOrDefault(c => c.Weapon == Weapon && c.AttackRole == Attack.Role);
    var own = catalog.Own(Weapon);
}
<div class="composition-control @(output != null || classic != null ? "modified" : "")" data-attack-output="@Attack.Role">
    <div class="panel-heading"><h3>@T.Format("Projectile.Title", Attack.Role.Replace('_', ' '))</h3>
        <span class="badge @(output != null || classic != null ? "modified-badge" : "")">@(output != null || classic != null ? T["Common.Modified"] : host != null ? T["Composition.Guarded"] : T["Common.ReadOnly"])</span></div>
    <p class="@(output != null || classic != null ? "modified-value" : "subtle")" data-attack-fires>@T.Markup("AttackOutput.Fires.Html", output?.OutputName ?? (classic != null ? classic.ReplacementProjectile.Label : own?.Label ?? Weapon))
        @if (output == null && classic == null) { <span class="subtle"> @T["AttackOutput.OwnProjectile"]</span> }</p>
    @if (source != null)
    {
        <details class="projectile-source" data-projectile-source="@source.Status"><summary>@T["AttackOutput.ActiveSource"] <span class="badge @(host != null ? "green" : "")">@source.Status.Replace('_', ' ').ToLowerInvariant()</span>
            @if (source.Mechanism != null) { <span class="badge">@source.Mechanism</span> }</summary>
            <p class="subtle">@source.Reason</p>
            @if (source.Member != null) { <p class="subtle">@(source.Write != null ? T.Markup("AttackOutput.MemberWrittenAs.Html", source.Member, source.Write) : T.Markup("AttackOutput.Member.Html", source.Member))</p> }
            @if (host?.Ammunition is { } ammunition)
            {
                <p class="subtle" data-ammunition-source>@T.Markup("AttackOutput.DefaultAmmunition.Html", ammunition.Item, ammunition.AppliesWhen) @ammunition.SharedReason
                    @if (ammunition.SharedWithWeapons.Length > 0) { <span> @T.Format("AttackOutput.AlsoEquippedBy", string.Join(", ", ammunition.SharedWithWeapons))</span> }</p>
            }
        </details>
    }
    @if (host == null) { <p class="notice" data-attack-output-readonly>@reason</p> }
    else
    {
        var donors = catalog.Donors(host);
        var shown = donors.Where(d => (ShowCross || !d.CrossClass || d.ProvenOnHost) && (Search.Length == 0 || $"{d.Output.Label} {d.Output.KindLabel} {d.Output.SemanticId}".Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase))).ToArray();
        <div class="donor-filters">
            <label>@T["AttackOutput.Search.Label"]<input data-donor-search @bind="Search" @bind:event="oninput" placeholder="EAT-700, Talon, arc…" /></label>
            <label class="switch-label"><input type="checkbox" data-donor-cross @bind="ShowCross" /> @T["AttackOutput.ShowCrossClass"]</label>
        </div>
        @if (Pending is { } pending)
        {
            <div class="swap-prompt" role="group" data-output-prompt>
                <p><strong>@T.Plural("AttackOutput.Pending.Changed", pending.Edits)</strong> @T.Format("AttackOutput.Pending.Discards", pending.Donor.Output.Label)</p>
                <div class="swap-actions"><button class="primary" data-output-discard @onclick="() => Choose(pending.Donor, true)">@T["Projectile.Swap.SwitchDiscard"]</button>
                    <button class="link-button" data-output-cancel @onclick="() => Pending = null">@T["Common.Cancel"]</button></div>
            </div>
        }
        <div class="donor-list" role="listbox" aria-label="@T["AttackOutput.Donors.Label"]" data-donor-list>
            @foreach (var d in shown)
            {
                var selected = output?.Output == d.Output.SemanticId || classic != null && classic.ReplacementProjectile.Weapon == d.Output.Owner.Name;
                <button class="donor @(selected ? "active" : "") @(d.Allowed ? "" : "refused")" role="option" aria-selected="@selected" disabled="@(!d.Allowed || Busy)" data-donor="@d.Output.SemanticId"
                        title="@(d.Refusal ?? d.Output.SemanticId)" @onclick="() => Choose(d, false)">
                    <span class="donor-name"><strong>@d.Output.Label</strong> <small class="subtle">@d.Output.KindLabel · @(d.Output.CompatibilityClass?.Replace('_', ' '))</small></span>
                    <span class="donor-badges">
                        @if (d.CrossClass) { <span class="badge amber" data-donor-cross>@T["AttackOutput.Badge.CrossClass"]</span> }
                        @if (d.ProvenOnHost) { <span class="badge green" data-donor-proven title="@T["AttackOutput.Badge.ProvenOnHost.Tooltip"]">@T.Format("AttackOutput.Badge.ProvenOnHost", Weapon)</span> }
                        else if (d.Output.LiveProof?.DonorOutput == "live_proven") { <span class="badge green" title="@string.Join(", ", d.Output.LiveProof.Tests)">@T["AttackOutput.Badge.DonorLiveProven"]</span> }
                        @if (!d.Output.Package.Known) { <span class="badge amber" title="@T["AttackOutput.Badge.AssetsUnknown.Tooltip"]">@T["Asset.Label.Unknown"]</span> }
                        else if (d.Output.Package.AutoLoad) { <span class="badge" title="@T.Format("AttackOutput.Badge.AutoLoad.Tooltip", d.Output.Package.Name)">@T["AttackOutput.Badge.AutoLoad"]</span> }
                        @foreach (var a in d.Acknowledgements) { <span class="badge amber" data-flag="@a">@Flag(a)</span> }
                    </span>
                    @if (!d.Allowed) { <small class="donor-refusal">@d.Refusal</small> }
                </button>
            }
            @if (shown.Length == 0) { <p class="subtle">@T["AttackOutput.Donors.Empty"]</p> }
        </div>
        @if (output != null || classic != null) { <button class="reset-action" data-attack-output-reset @onclick="Reset">@T["Projectile.Reset"]</button> }
        @if (output != null)
        {
            @if (Workspace.AttackOutputIssue(output) is { } issue) { <p class="notice warning" role="alert">@issue</p> }
            <OptInWarnings Acknowledgements="output.Acknowledgements" Reasons="Reasons(host, catalog.Output(output.Output))" />
        }
        @if (classic != null && Workspace.ProjectileIssue(classic) is { } classicIssue) { <p class="notice warning" role="alert">@classicIssue</p> }
    }
    @if (Error != null) { <p class="dialog-error" role="alert">@Error</p> }
</div>
@code {
    [Parameter, EditorRequired] public string Weapon { get; set; } = "";
    [Parameter, EditorRequired] public ProjectileAttack Attack { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private sealed record PendingOutput(AttackOutputDonor Donor, int Edits);
    private PendingOutput? Pending; private string Search = ""; private string? Error; private bool ShowCross, Busy;
    // Opt-in flag names are Runtime identifiers (kept as written); the badge labels are ModBuilder's text.
    private string Flag(string a) => a switch { "allow_shared" => T["Common.Shared"], "allow_unverified_effect" => T["AttackOutput.Flag.EffectUnverified"], "allow_unverified_reference" => T["AttackOutput.Flag.ReferenceUnverified"], _ => a };
    // Why each opt-in applies to this pair, from the published catalog (ammunition sharing and effect, the cross-class rule).
    private IReadOnlyDictionary<string, string> Reasons(AttackOutputHost host, AttackOutput? output) => new Dictionary<string, string>
    {
        ["allow_shared"] = host.Ammunition?.SharedReason ?? T["AttackOutput.Reason.Shared"],
        ["allow_unverified_effect"] = host.Ammunition?.EffectReason ?? T["AttackOutput.Reason.Effect"],
        ["allow_unverified_reference"] = T.Format("AttackOutput.Reason.CrossClass", host.Weapon, host.CompatibilityClass.Replace('_', ' '), output?.Label ?? T["AttackOutput.Reason.CrossClass.Donor"],
            output?.CompatibilityClass?.Replace('_', ' ') ?? T["AttackOutput.Reason.CrossClass.Different"]),
    };
    private async Task Choose(AttackOutputDonor donor, bool discard)
    {
        var host = Workspace.OutputHost(Weapon, Attack.Role, out _)!;
        var edits = Workspace.Project!.CompositionChanges.Count(c => c.Weapon == Weapon && c.AttackRole == Attack.Role);
        // A same-class donor the projectile graph also offers stays a classic reference swap, so projectile edits can follow it.
        if (Workspace.ClassicSource(host, donor.Output) is { } reference)
        {
            if (edits > 0 && !discard) { Pending = new(donor, edits); return; }
            await Run(async () => { await Workspace.SetAttackOutputAsync(Weapon, Attack.Role, null); await Workspace.SwapProjectileAsync(Weapon, Attack.Role, reference, keepValues: false); });
            return;
        }
        if (edits > 0 && !discard) { Pending = new(donor, edits); return; }
        await Run(() => Workspace.SetAttackOutputAsync(Weapon, Attack.Role, donor.Output.SemanticId, discardObjectEdits: true));
    }
    private Task Reset() => Run(async () =>
    {
        await Workspace.SetAttackOutputAsync(Weapon, Attack.Role, null);
        if (Workspace.Project!.ProjectileChanges.Any(c => c.Weapon == Weapon && c.AttackRole == Attack.Role)) await Workspace.SwapProjectileAsync(Weapon, Attack.Role, null, keepValues: false);
    });
    private async Task Run(Func<Task> action)
    {
        Busy = true; Error = null;
        try { await action(); Pending = null; await Changed.InvokeAsync(); }
        catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; }
        finally { Busy = false; }
    }
}

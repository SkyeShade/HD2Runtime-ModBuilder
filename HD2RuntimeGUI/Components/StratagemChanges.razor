@inject BuilderWorkspace Workspace
@{
    var catalog = Workspace.Metadata?.Stratagems; var links = Workspace.Metadata?.SupportLinks; var project = Workspace.Project;
    // Call-ins of vehicles/backpacks are listed with that vehicle or backpack (EntityChanges), not here.
    var entityCallIns = Workspace.Metadata?.Entities?.CallIns;
    var stratagemChanges = project?.StratagemChanges.Where(c => entityCallIns?.ContainsKey(c.Stratagem) != true).ToArray() ?? [];
    // Support weapon edits whose weapon has a published call-in link are shown with that stratagem (one logical entry).
    var linked = project?.SupportChanges.Select(c => (Change: c, Link: links?.ForWeapon(c.Weapon))).Where(x => x.Link != null)
        .ToLookup(x => x.Link!.Stratagem.Name, x => x.Change) ?? Enumerable.Empty<SupportChange>().ToLookup(_ => "");
}
@if (project != null && (stratagemChanges.Length > 0 || linked.Count > 0))
{
    <div class="panel-heading"><h2>@T["StratagemChanges.Title"]</h2>@if (project.StratagemChanges.Count > 0) { <button class="reset-action" @onclick="() => Run(() => Workspace.ResetStratagemAsync())">@T["StratagemChanges.ResetAll"]</button> }</div>
    @if (Workspace.Metadata != null)
    {
        @foreach (var overlap in StratagemLua.SharedOverlaps(project, Workspace.Metadata))
        { <p class="notice" data-shared-overlap>@string.Join(", ", overlap.Changes.Select(c => c.Stratagem + " · " + c.SemanticFieldId).Distinct()): @overlap.Message</p> }
    }
    @foreach (var key in stratagemChanges.Select(Key).Concat(linked.Select(g => g.Key)).Distinct().Order())
    {
        var group = stratagemChanges.Where(c => Key(c) == key).ToArray(); var weaponChanges = linked[key].ToArray();
        var shared = key == "Eagle Shared System"; var name = group.FirstOrDefault()?.Stratagem ?? key;
        <details class="panel" data-stratagem-change-group="@key"><summary>@if (!shared && catalog?.Root(name) is { } root && StratagemCategories.Of(root.Family) is { } category) { <span class="category-pill static @category.CssClass" data-change-category="@category.Key"><span class="cat-dot" aria-hidden="true"></span>@category.Label</span> }<strong>@(shared ? T["StratagemChanges.EagleSharedSystem"] : key)</strong> <span class="badge">@T.Plural("StratagemChanges.Count", group.Length + weaponChanges.Length)</span> <small class="subtle">@string.Join(" · ", group.Select(Section).Concat(weaponChanges.Length > 0 ? [T.Format("Stratagem.Delivered.Weapon", weaponChanges[0].Weapon)] : []).Distinct())</small></summary>
            <label><input type="checkbox" checked="@ShowAll.Contains(key)" @onchange="e => Toggle(key, (bool)e.Value!)" /> @T["StratagemChanges.ShowAll"]</label>
            <StratagemEditor Name="@name" ModifiedOnly="@(!ShowAll.Contains(key))" ExcludeRearm="@(!shared)" RearmOnly="@shared" Changed="Refresh" />
            @foreach (var c in group.Where(c => catalog?.Resolve(c) == null))
            { <p class="notice warning">@T.Format("StratagemChanges.Missing", c.SemanticFieldId, c.Attack ?? c.Weapon ?? c.Entity ?? c.Path)</p><button @onclick="() => Run(() => Workspace.ResetStratagemAsync(instance: c.InstanceKey))">@T["StratagemChanges.RemoveMissing"]</button> }
            @foreach (var c in weaponChanges.Where(c => Workspace.Metadata?.SupportAuthoring?.FieldInstances.All(f => f.InstanceKey != c.InstanceKey) != false))
            { <p class="notice warning">@T.Format("StratagemChanges.Missing", c.SemanticFieldId, c.AttackRole)</p><button @onclick="() => Run(() => Workspace.ResetSupportAsync(instance: c.InstanceKey))">@T["StratagemChanges.RemoveMissing"]</button> }
        </details>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private readonly HashSet<string> ShowAll = []; private string? Error;
    // The Eagle group key is logic (data-stratagem-change-group); its shown title is translated.
    private static string Key(StratagemChange c) => c.Path == "eagle_rearm" ? "Eagle Shared System" : c.Stratagem;
    private string Section(StratagemChange c) => c.TargetKind switch
    {
        "deployed_entity" => T["Stratagem.Graph.DeployedEntity"], "mounted_weapon" => T.Format("Stratagem.Graph.MountedWeapon", StratagemGraph.Title(c.Weapon ?? "")),
        _ => c.Path == "attack" ? T["StratagemChanges.Section.Attack"] : T["Stratagem.Graph.Stratagem"],
    };
    private void Toggle(string key, bool value) { if (value) ShowAll.Add(key); else ShowAll.Remove(key); }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) { Error = e.Message; } }
}

@inject BuilderWorkspace Workspace
@{
    var catalog = Workspace.Metadata?.Stratagems; var links = Workspace.Metadata?.SupportLinks; var project = Workspace.Project;
    // Support weapon edits whose weapon has a published call-in link are shown with that stratagem (one logical entry).
    var linked = project?.SupportChanges.Select(c => (Change: c, Link: links?.ForWeapon(c.Weapon))).Where(x => x.Link != null)
        .ToLookup(x => x.Link!.Stratagem.Name, x => x.Change) ?? Enumerable.Empty<SupportChange>().ToLookup(_ => "");
}
@if (project != null && (project.StratagemChanges.Count > 0 || linked.Count > 0))
{
    <div class="panel-heading"><h2>Stratagem changes</h2>@if (project.StratagemChanges.Count > 0) { <button class="reset-action" @onclick="() => Run(() => Workspace.ResetStratagemAsync())">Reset all stratagem changes</button> }</div>
    @if (Workspace.Metadata != null)
    {
        @foreach (var overlap in StratagemLua.SharedOverlaps(project, Workspace.Metadata))
        { <p class="notice" data-shared-overlap>@string.Join(", ", overlap.Changes.Select(c => c.Stratagem + " · " + c.SemanticFieldId).Distinct()): @overlap.Message</p> }
    }
    @foreach (var key in project.StratagemChanges.Select(Key).Concat(linked.Select(g => g.Key)).Distinct().Order())
    {
        var group = project.StratagemChanges.Where(c => Key(c) == key).ToArray(); var weaponChanges = linked[key].ToArray();
        var shared = key == "Eagle Shared System"; var name = group.FirstOrDefault()?.Stratagem ?? key;
        <details class="panel" data-stratagem-change-group="@key"><summary>@if (!shared && catalog?.Root(name) is { } root && StratagemCategories.Of(root.Family) is { } category) { <span class="category-pill static @category.CssClass" data-change-category="@category.Key"><span class="cat-dot" aria-hidden="true"></span>@category.Label</span> }<strong>@key</strong> <span class="badge">@(group.Length + weaponChanges.Length) @(group.Length + weaponChanges.Length == 1 ? "change" : "changes")</span> <small class="subtle">@string.Join(" · ", group.Select(Section).Concat(weaponChanges.Length > 0 ? ["Weapon · " + weaponChanges[0].Weapon] : []).Distinct())</small></summary>
            <label><input type="checkbox" checked="@ShowAll.Contains(key)" @onchange="e => Toggle(key, (bool)e.Value!)" /> Show all fields</label>
            <StratagemEditor Name="@name" ModifiedOnly="@(!ShowAll.Contains(key))" ExcludeRearm="@(!shared)" RearmOnly="@shared" Changed="Refresh" />
            @foreach (var c in group.Where(c => catalog?.Resolve(c) == null))
            { <p class="notice warning">Missing capability: @c.SemanticFieldId · @(c.Attack ?? c.Weapon ?? c.Entity ?? c.Path)</p><button @onclick="() => Run(() => Workspace.ResetStratagemAsync(instance: c.InstanceKey))">Remove missing change</button> }
            @foreach (var c in weaponChanges.Where(c => Workspace.Metadata?.SupportAuthoring?.FieldInstances.All(f => f.InstanceKey != c.InstanceKey) != false))
            { <p class="notice warning">Missing capability: @c.SemanticFieldId · @c.AttackRole</p><button @onclick="() => Run(() => Workspace.ResetSupportAsync(instance: c.InstanceKey))">Remove missing change</button> }
        </details>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private readonly HashSet<string> ShowAll = []; private string? Error;
    private static string Key(StratagemChange c) => c.Path == "eagle_rearm" ? "Eagle Shared System" : c.Stratagem;
    private static string Section(StratagemChange c) => c.TargetKind switch
    { "deployed_entity" => "Deployed Entity", "mounted_weapon" => "Mounted Weapon · " + StratagemGraph.Title(c.Weapon ?? ""), _ => c.Path == "attack" ? "Attack" : "Stratagem" };
    private void Toggle(string key, bool value) { if (value) ShowAll.Add(key); else ShowAll.Remove(key); }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) { Error = e.Message; } }
}

@inject BuilderWorkspace Workspace
@if (Workspace.Project?.StratagemChanges.Count > 0)
{
    var catalog = Workspace.Metadata?.Stratagems;
    <div class="panel-heading"><h2>Stratagem changes</h2><button class="reset-action" @onclick="() => Run(() => Workspace.ResetStratagemAsync())">Reset all stratagem changes</button></div>
    @if (Workspace.Metadata != null)
    {
        @foreach (var overlap in StratagemLua.SharedOverlaps(Workspace.Project, Workspace.Metadata))
        { <p class="notice" data-shared-overlap>@string.Join(", ", overlap.Changes.Select(c => c.Stratagem + " · " + c.SemanticFieldId).Distinct()): @overlap.Message</p> }
    }
    @foreach (var group in Workspace.Project.StratagemChanges.GroupBy(c => c.Path == "eagle_rearm" ? "Eagle Shared System" : c.Stratagem).OrderBy(g => g.Key))
    {
        var shared = group.All(c => c.Path == "eagle_rearm");
        <details class="panel" data-stratagem-change-group="@group.Key"><summary><strong>@group.Key</strong> <span class="badge">@group.Count() @(group.Count() == 1 ? "change" : "changes")</span> <small class="subtle">@string.Join(" · ", group.Select(Section).Distinct())</small></summary>
            <label><input type="checkbox" checked="@ShowAll.Contains(group.Key)" @onchange="e => Toggle(group.Key, (bool)e.Value!)" /> Show all fields</label>
            <StratagemEditor Name="@group.First().Stratagem" ModifiedOnly="@(!ShowAll.Contains(group.Key))" ExcludeRearm="@(!shared)" RearmOnly="@shared" Changed="Refresh" />
            @foreach (var c in group.Where(c => catalog?.Resolve(c) == null))
            { <p class="notice warning">Missing capability: @c.SemanticFieldId · @(c.Attack ?? c.Weapon ?? c.Entity ?? c.Path)</p><button @onclick="() => Run(() => Workspace.ResetStratagemAsync(instance: c.InstanceKey))">Remove missing change</button> }
        </details>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private readonly HashSet<string> ShowAll = []; private string? Error;
    private static string Section(StratagemChange c) => c.TargetKind switch
    { "deployed_entity" => "Deployed Entity", "mounted_weapon" => "Mounted Weapon · " + StratagemGraph.Title(c.Weapon ?? ""), _ => c.Path == "attack" ? "Attack" : "Stratagem" };
    private void Toggle(string key, bool value) { if (value) ShowAll.Add(key); else ShowAll.Remove(key); }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) { Error = e.Message; } }
}

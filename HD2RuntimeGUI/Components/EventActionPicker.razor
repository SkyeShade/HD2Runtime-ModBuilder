@inject BuilderWorkspace Workspace
@* Searchable pickers for what event scripts can make the game do, from the SDK's EventCatalog.json: explosions, projectiles, statuses and
   healing. Each shows Runtime's limits (host only, in a mission, rate limits), whether it is live-proven, and what loads its assets.
   Nothing here is implied to be proven when the catalog does not say so. Labels and limits are UI text; names, API calls and the catalog's
   own descriptions are shown as published, and the inserted Lua never depends on the UI language. *@
@{ var catalog = Workspace.Metadata?.Events; var assets = Workspace.Metadata?.Assets; }
@if (catalog != null)
{
    var a = catalog.Actions;
    <div class="event-actions" data-event-actions>
        <label class="reference-search">@T["Common.Search"]<input data-action-search @bind="Search" @bind:event="oninput" placeholder="Hellbomb, Eruptor, fire…" /></label>
        <section class="action-group" data-action-group="explosions">
            <h3 class="group-title">@T["EventActions.Explosions.Title"] <small class="subtle">@a.Explosions.Api</small></h3>
            <p class="subtle">@T.Format("EventActions.Explosions.Summary", Limits(T, a.Explosions.HostOnly, a.Explosions.InMissionOnly, a.Explosions.RateLimit), a.Explosions.CreditedTo.Replace('_', ' '), a.Explosions.OtherPlayersSee, a.Explosions.Assets)</p>
            @foreach (var n in a.Explosions.Named.Where(n => Match(n.Name, string.Join(" ", n.Aliases))))
            {
                var name = n.Aliases.FirstOrDefault() ?? n.Name;
                <div class="action-row" data-action-explosion="@n.Name"><span><strong>@n.Name</strong>@if (n.Aliases.Length > 0) { <small class="subtle">@(" " + T.Format("EventActions.Aliases", string.Join("', '", n.Aliases)))</small> }</span>
                    <span>@Proof(n.LiveProven)@if (n.SharedType) { <span class="badge amber" title="@T["EventActions.SharedType.Tooltip"]">@T["EventActions.SharedType.Label"]</span> }@AssetBadge("explosion/" + n.Name)</span>
                    <button class="small" data-action-insert @onclick="() => Explosion(name)">@T["Common.Insert"]</button></div>
            }
            @foreach (var w in a.Explosions.Weapons.Where(w => Match(w)))
            {
                <div class="action-row" data-action-explosion="@w"><span><strong>@w</strong> <small class="subtle">@T["EventActions.WeaponExplosion"]</small></span>
                    <span>@Proof(a.Explosions.LiveProvenWeapons.Contains(w))@AssetBadge("player_weapon/" + w)</span>
                    <button class="small" data-action-insert @onclick="() => Explosion(w)">@T["Common.Insert"]</button></div>
            }
        </section>
        <section class="action-group" data-action-group="projectiles">
            <h3 class="group-title">@T["EventActions.Projectiles.Title"] <small class="subtle">@a.Projectiles.Api</small></h3>
            <p class="subtle">@T.Format("EventActions.Projectiles.Summary", Limits(T, a.Projectiles.HostOnly, a.Projectiles.InMissionOnly, a.Projectiles.RateLimit), string.Join(" · ", a.Projectiles.SideEffects), a.Projectiles.OtherPlayersSee, a.Projectiles.Assets)</p>
            @foreach (var w in a.Projectiles.Weapons.Where(w => Match(w)))
            {
                <div class="action-row" data-action-projectile="@w"><span><strong>@w</strong></span><span>@Proof(a.Projectiles.LiveProven.Contains(w))@AssetBadge("player_weapon/" + w)</span>
                    <button class="small" data-action-insert @onclick="() => Projectile(w)">@T["Common.Insert"]</button></div>
            }
        </section>
        <section class="action-group" data-action-group="statuses">
            <h3 class="group-title">@T["EventActions.Statuses.Title"] <small class="subtle">@a.StatusEffects.Api</small></h3>
            <p class="subtle">@T.Format("EventActions.Statuses.Summary", Limits(T, a.StatusEffects.HostOnly, a.StatusEffects.InMissionOnly, a.StatusEffects.RateLimit), string.Join(" · ", a.StatusEffects.Unproven))</p>
            @foreach (var s in a.StatusEffects.Statuses.Where(s => Match(s.Id, s.Name, s.Family)))
            {
                <div class="action-row" data-action-status="@s.Id"><span><code>@s.Id</code> <small class="subtle">@(s.Duration is { } d ? T.Format("EventActions.Status.FamilyDuration", s.Family, d.ToString(System.Globalization.CultureInfo.InvariantCulture)) : s.Family)</small></span><span>@Proof(s.LiveProven)</span>
                    <button class="small" data-action-insert @onclick="() => Status(s.Id)">@T["Common.Insert"]</button></div>
            }
        </section>
        <section class="action-group" data-action-group="healing">
            <h3 class="group-title">@T["EventActions.Healing.Title"] <small class="subtle">hd2.actions.heal</small></h3>
            @if (catalog.Api.Classes.GetValueOrDefault("HD2Actions")?.Methods?.FirstOrDefault(m => m.Name == "heal") is { } heal)
            {
                <div class="action-row" data-action-heal><span><code>@heal.Signature</code><small class="subtle"> @heal.Doc</small></span><span></span>
                    <button class="small" data-action-insert @onclick="Heal">@T["Common.Insert"]</button></div>
            }
            <p class="subtle">@T.Format("EventActions.SpawnEntity", a.SpawnEntity.Status, a.SpawnEntity.Reason)</p>
        </section>
    </div>
}
@code {
    [Parameter] public EventCallback<string> Insert { get; set; }
    private string Search = "";
    // Inserted calls use the catalogued name verbatim; positions and entities come from the event the user is handling.
    private Task Explosion(string name) => Insert.InvokeAsync("hd2.explosions.spawn(" + LuaGenerator.Quote(name) + ", {position = event.position})\n");
    private Task Projectile(string weapon) => Insert.InvokeAsync("hd2.projectiles.spawn(" + LuaGenerator.Quote(weapon) + ", {position = position, direction = {x = 1, y = 0, z = 0}})\n");
    private Task Status(string id) => Insert.InvokeAsync("hd2.status.apply(event.entity, " + LuaGenerator.Quote(id) + ", {buildup = 100})\n");
    private Task Heal() => Insert.InvokeAsync("local amount, why = hd2.actions.heal(25)\n");
    private bool Match(params string?[] values) => Search.Trim().Length == 0 || values.Any(v => v?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) == true);
    // Runtime's limits for an action: where it may run (host only, in a mission), then its rate limit per mod and, where the catalog has
    // one, per target. Each combination is one template, so a translation can order it naturally.
    private static string Limits(IUiText t, bool host, bool mission, ActionRateLimit r)
    {
        var rate = r.PerTargetBurst is { } target ? t.Format("EventActions.Limits.RatePerTarget", r.Burst, r.PerSecond, target) : t.Format("EventActions.Limits.Rate", r.Burst, r.PerSecond);
        return host && mission ? t.Format("EventActions.Limits.HostInMission", rate) : host ? t.Format("EventActions.Limits.Host", rate) : mission ? t.Format("EventActions.Limits.InMission", rate) : rate;
    }
    private RenderFragment Proof(bool live) => __builder =>
    {
        if (live) { <span class="badge green" data-live-proven>@T["EventActions.LiveProven"]</span> }
        else { <span class="badge" title="@T["EventActions.NotLiveTested.Tooltip"]">@T["EventActions.NotLiveTested.Label"]</span> }
    };
    private RenderFragment AssetBadge(string key) => __builder =>
    {
        if (Workspace.Metadata?.Assets?.Objects.GetValueOrDefault(key)?.PackageDependency is { } d)
        {
            if (d.Known) { <span class="badge" title="@(T.Format(d.AutoLoadSupported ? "EventActions.Assets.PackageAutoLoad" : "EventActions.Assets.Package", d.Package))">@(d.AutoLoadSupported ? T["EventActions.Assets.AutoLoad"] : T["EventActions.Assets.Known"])</span> }
            else { <span class="badge amber" title="@d.Blocker">@T["EventActions.Assets.Unknown"]</span> }
        }
    };
}

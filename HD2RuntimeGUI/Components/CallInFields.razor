@inject BuilderWorkspace Workspace
@* Call-in definition fields (cooldown, max uses, …) of a stratagem linked to a vehicle or backpack by Runtime's published relationship.
   Writes stay on hd2.stratagem(...); this only places them in the same editor. *@
@{ var catalog = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.Stratagems;
   var fields = catalog?.FieldInstances.Where(f => f.Target.Stratagem == Stratagem && f.Target.Path == "stratagem"
       && (!ModifiedOnly || StratagemChangeService.Saved(Workspace.Project, catalog, f) != null)).ToArray() ?? []; }
@if (fields.Length > 0)
{
    <section class="panel" data-callin="@Stratagem"><div class="panel-heading"><h2>Call-in</h2><span class="category-pill static cat-support"><span class="cat-dot" aria-hidden="true"></span>Stratagem</span></div>
        <p class="subtle">@Stratagem call-in definition, linked by HD2Runtime's structural call-in relationship.</p>
        <div class="stat-grid">@foreach (var f in fields) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Changed" /> }</div>
    </section>
}
@code {
    [Parameter, EditorRequired] public string Stratagem { get; set; } = "";
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
}

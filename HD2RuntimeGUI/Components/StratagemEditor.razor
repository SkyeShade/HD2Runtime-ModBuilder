@inject BuilderWorkspace Workspace
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Stratagems; var link = sdk?.SupportLinks?.ForStratagem(Name); }
@if (catalog?.Root(Name) != null)
{
    var graph = StratagemGraph.Build(catalog, Name, f => (!ExcludeRearm || f.Target.Path != "eagle_rearm") && (!RearmOnly || f.Target.Path == "eagle_rearm")
        && (!ModifiedOnly || StratagemChangeService.Saved(Workspace.Project, catalog, f) != null));
    @if (Workspace.Project == null) { <p class="notice">@T["Stratagem.Editor.NoProject"]</p> }
    else if (!RearmOnly && Workspace.Project.StratagemChanges.Any(c => c.Stratagem == Name)) { <button class="reset-action" @onclick="() => Run(() => Workspace.ResetStratagemAsync(Name))">@T["Stratagem.Editor.Reset"]</button> }
    @foreach (var scope in graph.AllFields.Where(f => f.Shared).GroupBy(f => f.ScopeKey))
    {
        var field = scope.First(); var consumers = catalog.Backing(field)?.SharedConsumers ?? field.SharedConsumers;
        @if (Workspace.Project != null && scope.Any(f => StratagemChangeService.Saved(Workspace.Project, catalog, f) != null))
        {
            <AckPanel Title="@(field.Target.Path == "eagle_rearm" ? T["Stratagem.Shared.EagleRearm"] : T.Format("Stratagem.Shared.Title", field.BackingObjectKind))" Kind="shared"
                Description="@(T.Plural("Stratagem.Shared.Affects", consumers.Length) + (field.DynamicConsumersPossible ? " " + T["Stratagem.Shared.Dynamic"] : "") + (!field.ReviewedScopeComplete ? " " + T["Stratagem.Shared.Incomplete"] : ""))"
                PanelAttributes="@(new() { ["data-stratagem-approval"] = field.Target.Path, ["data-shared-scope"] = field.ScopeKey })">
                <ul class="ack-list">@foreach (var consumer in consumers) { <li data-shared-consumer>@consumer.Label · @ConsumerPath(consumer.Path)</li> }</ul>
            </AckPanel>
        }
    }
    @if (graph.Definition.Length > 0 || graph.EagleRearm.Length > 0)
    {
        <details class="ia-section" data-section="call-in" open><summary>@T["Stratagem.Section.CallIn"] <small>@T["Stratagem.Section.CallIn.Hint"]</small></summary><div class="ia-body">
        @if (graph.Definition.Length > 0)
        {
            <section class="panel" data-stratagem-branch="stratagem">
                <div class="stat-grid">@foreach (var f in graph.Definition) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div>
            </section>
        }
        @if (graph.EagleRearm.Length > 0)
        {
            <section class="panel" data-stratagem-branch="eagle_rearm"><h3 class="group-title">@T["Stratagem.EagleShared.Title"]</h3>
                <p class="subtle">@T["Stratagem.EagleShared.Help"]</p>
                <div class="stat-grid">@foreach (var f in graph.EagleRearm) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div>
            </section>
        }
        </div></details>
    }
    @if (link != null && !RearmOnly && (!ModifiedOnly || Workspace.Project?.SupportChanges.Any(c => c.Weapon == link.Weapon.Name) == true) || graph.Entities.Length > 0 || graph.Attacks.Length > 0)
    {
    <details class="ia-section" data-section="delivered" open><summary>@T["Stratagem.Section.Delivered"] <small>@DeliveredLabel(graph, link)</small></summary><div class="ia-body">
    @if (link != null && !RearmOnly)
    {
        // Merged support entry: the linked weapon's own editor and guards, joined through published semantic IDs only.
        if (!ModifiedOnly) { <SupportWeaponDetail Weapon="@link.Weapon.Name" Embedded="true" Changed="Refresh" /> }
        else if (Workspace.Project?.SupportChanges.Any(c => c.Weapon == link.Weapon.Name) == true)
        { <div class="linked-weapon-changes" data-linked-weapon="@link.Weapon.Name"><h3 class="section-label">@T.Format("Stratagem.Delivered.Weapon", link.Weapon.Name)</h3><SupportAuthoringEditor Weapon="@link.Weapon.Name" ModifiedOnly="true" Changed="Refresh" /></div> }
    }
    @foreach (var entity in graph.Entities)
    {
        <EntityStats TField="StratagemField" Title="@(entity.Shield != null ? T["Stratagem.Entity.Emitter"] : T["Stratagem.Graph.DeployedEntity"])" Identity="@entity.Entity" Kind="@EntityStats.KindLabel(entity.Identity)" Items="entity.Stats"
                     Description="@(graph.Root.Family == "mine" ? T["Stratagem.Entity.Minefield"] : entity.Shield != null ? T["Stratagem.Entity.EmitterHelp"] : null)">
            <Editor Context="f"><StratagemFieldEditor @key="f.InstanceKey" Field="f" Label="@EntityStats.Label(f.SemanticFieldId)" Changed="Refresh" /></Editor>
            <ChildContent>
                @if (entity.Zones.Length > 0)
                {
                    <div class="entity-zones" data-entity-zones="@entity.Entity">
                        <h3 class="group-title">@(entity.Shield != null ? T["Stratagem.Entity.BodyZones"] : T["Stratagem.Entity.Zones"])</h3>
                        @foreach (var zone in entity.Zones)
                        {
                            <div class="zone-row" data-zone="@zone.Zone.ZoneId"><strong>@(zone.Zone.Name?.Replace('_', ' ') ?? zone.Zone.ZoneId)</strong> <small class="subtle">@zone.Zone.ZoneId</small>
                                <div class="stat-grid">@foreach (var f in zone.Fields) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div></div>
                        }
                    </div>
                }
                @foreach (var weapon in entity.Weapons)
                {
                    <div class="mounted-weapon" data-mounted-weapon="@weapon.Weapon">
                        <h3 class="section-label">@T.Format("Stratagem.Graph.MountedWeapon", weapon.Title)</h3>
                        @foreach (var group in weapon.Groups)
                        { <h4 class="group-title">@group.Title</h4><div class="stat-grid">@foreach (var f in group.Fields) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div> }
                        @foreach (var attack in weapon.Attacks)
                        {
                            <div class="attack-branch" data-stratagem-branch="@attack.Attack.Role" data-branch-kind="@attack.Attack.Kind">
                                <h4 class="group-title">@attack.Title</h4><small class="subtle">@ConsumerPath(attack.Attack.Path)</small>
                                <div class="stat-grid">@foreach (var f in attack.Fields) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div>
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </EntityStats>
        @if (entity.Shield is { } shield)
        {
            <section class="panel category-panel cat-defensive shield-projector" data-shield-projector="@entity.Entity">
                <div class="panel-heading"><h2>@T["Stratagem.Shield.Title"]</h2><span class="badge">@shield.Config.Component</span></div>
                <p class="subtle">@T.Format("Stratagem.Shield.Help", shield.Config.IdentityRole, shield.Config.RuntimeShieldInstance)</p>
                @if (shield.Fields.Length > 0) { <div class="stat-grid">@foreach (var f in shield.Fields) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div> }
                @if (!ModifiedOnly && shield.Config.BlockedFields.Length > 0)
                { <details data-shield-blocked><summary>@T["Stratagem.Blocked.Title"]</summary>@foreach (var b in shield.Config.BlockedFields) { <p data-blocked-field="@b.Field"><strong>@T.Format("Stratagem.Blocked.Field", b.Field)</strong> @b.Reason</p> }</details> }
            </section>
        }
    }
    @foreach (var attack in graph.Attacks)
    {
        <section class="panel" data-stratagem-branch="@attack.Attack.Role">
            <h2>@ConsumerPath(attack.Attack.Path)</h2>
            @foreach (var domain in FieldGroups.Group(attack.Fields, f => f.SemanticFieldId, f => f.Domain))
            { <h3 class="group-title">@SupportAuthoringEditor.GroupLabel(T, domain.Key)</h3><div class="stat-grid">@foreach (var f in domain) { <StratagemFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div> }
        </section>
    }
    </div></details>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public bool ExcludeRearm { get; set; }
    [Parameter] public bool RearmOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    public static string ConsumerPath(string path) => path.Replace("/", " → ");
    private string DeliveredLabel(StratagemGraph graph, SupportCallInLink? link) => link != null ? T.Format("Stratagem.Delivered.Support", link.Weapon.Name)
        : graph.Entities.Length > 0 ? string.Join(", ", graph.Entities.Select(e => EntityStats.KindLabel(e.Identity).ToLowerInvariant()).Distinct()) : T.Plural("Stratagem.Delivered.Attacks", graph.Attacks.Length);
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) { Error = e.Message; } }
}

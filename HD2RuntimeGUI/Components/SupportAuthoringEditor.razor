@inject BuilderWorkspace Workspace
@{ var catalog = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.SupportAuthoring; var fields = catalog?.FieldInstances.Where(f => f.SupportWeapon == Weapon).ToArray() ?? []; }
@if (fields.Length > 0)
{
    @if (Workspace.Project == null) { <p class="notice">Create or open a project to author these capabilities.</p> }
    else if (Workspace.Project.SupportChanges.Any(c => c.Weapon == Weapon)) { <button class="reset-action" @onclick="Reset">Reset support weapon</button> }
    @foreach (var scope in fields.Where(f => f.SharedScope.RequiresAcknowledgement).GroupBy(f => f.SharedScope.ScopeKey))
    {
        var f = scope.First();
        @if (Workspace.Project != null && scope.Any(f => Workspace.Project.SupportChanges.Any(c => c.InstanceKey == f.InstanceKey)))
        {
            <AckPanel Title="@($"Shared {f.Backing.SemanticType}")" Kind="shared" Checked="SupportChangeService.Approved(Workspace.Project, f)" OnChange="v => Approve(f, v)"
                Description="@($"Changing this object may affect these consumers.{(f.SharedScope.DynamicConsumersPossible ? " Additional runtime consumers are possible." : "")}")"
                Items="@f.SharedScope.AffectedSemanticConsumers.Select(c => $"{c.Weapon} · {c.AttackRole}").ToArray()" ItemsLabel="Affected:"
                PanelAttributes="@(new() { ["data-support-scope"] = scope.Key })" />
        }
    }
    @foreach (var branch in fields.Where(f => !ModifiedOnly || Workspace.Project!.SupportChanges.Any(c => c.InstanceKey == f.InstanceKey)).GroupBy(f => (f.Target.Path, f.Target.AttackRole)))
    {
        <section class="panel" data-support-authoring-branch="@(branch.Key.AttackRole ?? "weapon")"><h3>@(branch.Key.AttackRole == null ? "Weapon" : "Attack · " + string.Join(" / ", branch.First().Target.WritableCatalogBranches.Select(b => b.Name)))</h3>
            @foreach (var domain in FieldGroups.Group(branch, f => f.SemanticFieldId, f => f.Display.Domain))
            {
                <h3 class="group-title">@domain.Key</h3>
                @* 0.26.0 fire modes: the native mode list has its own editor (and its own acknowledgement); burst length stays a row. *@
                @if (domain.Any(f => f.SemanticFieldId == FireModes.ModesField) && !ModifiedOnly) { <SupportFireModes Weapon="@Weapon" Changed="Refresh" /> }
                <div class="stat-grid">@foreach (var f in domain.Where(f => f.SemanticFieldId != FireModes.ModesField || ModifiedOnly)) { <SupportFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div>
            }
            @{ var unverified = branch.Where(f => f.Operation.Acknowledgement == "allow_unverified_effect" && Saved(f) != null && (f.SemanticFieldId != FireModes.ModesField || ModifiedOnly)).ToArray(); }
            @if (unverified.Length > 0)
            {
                <AckPanel Title="Unverified effects" Kind="unverified" Checked="unverified.All(f => Saved(f)!.EffectAcknowledgement == SupportChangeService.EffectEvidence(f))"
                    OnChange="v => AcknowledgeEffects(unverified, v)" Items="@unverified.Select(f => f.Display.Name).ToArray()" ItemsLabel="Edited:"
                    Description="The gameplay effect of these edits is not proven in game (allow_unverified_effect)." Label="I understand these effects are unverified"
                    CheckboxAttributes='@(new() { ["data-support-effect-ack"] = "true" })' />
            }
        </section>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@* 0.26.0: read-only reticle and fire modes show Runtime's blocker compactly (no invented controls); backpack-fed weapons show their
   backpack ammunition even when the weapon's own fields are blocked (the Cremator resolves to two native roots). *@
@if (!ModifiedOnly && (Workspace.Metadata ?? Workspace.SdkStatus?.Installed) is { Has026: true } sdk026)
{
    var blocked = sdk026.SupportAuthoring?.Weapons.FirstOrDefault(w => w.Name == Weapon)?.BlockedFields.Where(b => b.Field is FireModes.ReticleField or FireModes.ModesField).ToArray() ?? [];
    @if (fields.All(f => f.SemanticFieldId != FireModes.ModesField) && sdk026.FireModes?.Find("support", Weapon) is { Writable: false }) { <SupportFireModes Weapon="@Weapon" Changed="Refresh" /> }
    @foreach (var b in blocked.Where(b => b.Field == FireModes.ReticleField && fields.All(f => f.SemanticFieldId != FireModes.ReticleField)))
    { <p class="subtle field-blocker" data-reticle-blocked="@Weapon"><strong>Third-person reticle:</strong> read-only · @b.Reason</p> }
}
<SupportBackpackAmmo Weapon="@Weapon" ModifiedOnly="ModifiedOnly" Changed="Refresh" />
@code {
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public string Weapon { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    public static string Label(string domain) => domain switch { "magazine" => "Magazine ammo", "rounds" => "Rounds feed", "heatsink" => "Heatsinks", _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(domain) };
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) { Error = e.Message; } }
    private Task Reset() => Run(() => Workspace.ResetSupportAsync(Weapon));
    private Task Approve(SupportField f, bool approved) => Run(() => Workspace.SetSupportApprovalAsync(f.InstanceKey, approved));
    private SupportChange? Saved(SupportField f) => Workspace.Project?.SupportChanges.SingleOrDefault(c => c.InstanceKey == f.InstanceKey);
    // One checkbox for the group; Runtime still receives allow_unverified_effect on each edited field.
    private Task AcknowledgeEffects(IEnumerable<SupportField> fields, bool value) => Run(async () => { foreach (var f in fields) await Workspace.SetSupportEffectAcknowledgedAsync(f.InstanceKey, value); });
}

@inject BuilderWorkspace Workspace
@{ var catalog = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.SupportAuthoring; var fields = catalog?.FieldInstances.Where(f => f.SupportWeapon == Weapon).ToArray() ?? []; }
@if (fields.Length > 0)
{
    @if (Workspace.Project == null) { <p class="notice">Create or open a project to author these capabilities.</p> }
    else if (Workspace.Project.SupportChanges.Any(c => c.Weapon == Weapon)) { <button class="reset-action" @onclick="Reset">Reset support weapon</button> }
    @foreach (var scope in fields.Where(f => f.SharedScope.RequiresAcknowledgement).GroupBy(f => f.SharedScope.ScopeKey))
    {
        var f = scope.First();
        @if (Workspace.Project != null && scope.Any(f => Workspace.Project.SupportChanges.Any(c => c.InstanceKey == f.InstanceKey)))
        {
            <section class="panel notice warning" data-support-scope="@scope.Key"><strong>Shared @f.Backing.SemanticType</strong>
                <p>Changing this object may affect these consumers:</p><ul>@foreach (var consumer in f.SharedScope.AffectedSemanticConsumers) { <li>@consumer.Weapon · @consumer.AttackRole</li> }</ul>
                @if (f.SharedScope.DynamicConsumersPossible) { <p>Additional runtime consumers are possible.</p> }
                <label><input type="checkbox" checked="@SupportChangeService.Approved(Workspace.Project, f)" @onchange="e => Approve(f, (bool)e.Value!)" /> I acknowledge writes to this shared object.</label>
            </section>
        }
    }
    @foreach (var branch in fields.Where(f => !ModifiedOnly || Workspace.Project!.SupportChanges.Any(c => c.InstanceKey == f.InstanceKey)).GroupBy(f => (f.Target.Path, f.Target.AttackRole)))
    {
        <section class="panel" data-support-authoring-branch="@branch.Key.AttackRole"><h3>@(branch.Key.AttackRole == null ? "Weapon" : "Attack · " + string.Join(" / ", branch.First().Target.WritableCatalogBranches.Select(b => b.Name)))</h3>
            @foreach (var domain in FieldGroups.Group(branch, f => f.SemanticFieldId, f => f.Display.Domain))
            { <h3 class="group-title">@domain.Key</h3><div class="stat-grid">@foreach (var f in domain) { <SupportFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div> }
        </section>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public string Weapon { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    public static string Label(string domain) => domain switch { "magazine" => "Magazine ammo", "rounds" => "Rounds feed", "heatsink" => "Heatsinks", _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(domain) };
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) { Error = e.Message; } }
    private Task Reset() => Run(() => Workspace.ResetSupportAsync(Weapon));
    private Task Approve(SupportField f, bool approved) => Run(() => Workspace.SetSupportApprovalAsync(f.InstanceKey, approved));
}

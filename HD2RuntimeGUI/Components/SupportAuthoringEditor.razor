@inject BuilderWorkspace Workspace
@{ var catalog = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.SupportAuthoring;
   // The attack projectile reference (0.28.0) is edited as a projectile host swap (ProjectileHostSwaps), not as a field row.
   var hosted = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.AttackOutputs != null;
   var fields = catalog?.FieldInstances.Where(f => f.SupportWeapon == Weapon && !(hosted && f.IsProjectileReference)).ToArray() ?? []; }
@if (fields.Length > 0)
{
    @if (Workspace.Project == null) { <p class="notice">@T["Support.Editor.NoProject"]</p> }
    else if (Workspace.Project.SupportChanges.Any(c => c.Weapon == Weapon)) { <button class="reset-action" @onclick="Reset">@T["Support.Editor.Reset"]</button> }
    @foreach (var scope in fields.Where(f => f.SharedScope.RequiresAcknowledgement).GroupBy(f => f.SharedScope.ScopeKey))
    {
        var f = scope.First();
        @if (Workspace.Project != null && scope.Any(f => Workspace.Project.SupportChanges.Any(c => c.InstanceKey == f.InstanceKey)))
        {
            <AckPanel Title="@T.Format("Support.Shared.Title", f.Backing.SemanticType)" Kind="shared"
                Description="@(T["Support.Shared.Affects"] + (f.SharedScope.DynamicConsumersPossible ? " " + T["Support.Shared.Dynamic"] : ""))"
                Items="@f.SharedScope.AffectedSemanticConsumers.Select(c => $"{c.Weapon} · {c.AttackRole}").ToArray()" ItemsLabel="@T["Support.Shared.ItemsLabel"]"
                PanelAttributes="@(new() { ["data-support-scope"] = scope.Key })" />
        }
    }
    @foreach (var branch in fields.Where(f => !ModifiedOnly || Workspace.Project!.SupportChanges.Any(c => c.InstanceKey == f.InstanceKey)).GroupBy(f => (f.Target.Path, f.Target.AttackRole)))
    {
        <section class="panel" data-support-authoring-branch="@(branch.Key.AttackRole ?? "weapon")"><h3>@(branch.Key.AttackRole == null ? T["Support.Branch.Weapon"] : T.Format("Support.Branch.Attack", string.Join(" / ", branch.First().Target.WritableCatalogBranches.Select(b => b.Name))))</h3>
            @foreach (var domain in FieldGroups.Group(branch, f => f.SemanticFieldId, f => f.Display.Domain))
            {
                <h3 class="group-title">@GroupLabel(T, domain.Key)</h3>
                @* 0.26.0 fire modes: the native mode list has its own editor (and its own acknowledgement); burst length stays a row. *@
                @if (domain.Any(f => f.SemanticFieldId == FireModes.ModesField) && !ModifiedOnly) { <SupportFireModes Weapon="@Weapon" Changed="Refresh" /> }
                <div class="stat-grid">@foreach (var f in domain.Where(f => f.SemanticFieldId != FireModes.ModesField || ModifiedOnly)) { <SupportFieldEditor @key="f.InstanceKey" Field="f" Changed="Refresh" /> }</div>
            }
            @{ var unverified = branch.Where(f => f.Operation.Acknowledgement == "allow_unverified_effect" && Saved(f) != null && (f.SemanticFieldId != FireModes.ModesField || ModifiedOnly)).ToArray(); }
            @if (unverified.Length > 0)
            {
                <AckPanel Title="@T["Support.Unverified.Title"]" Kind="unverified" Items="@unverified.Select(f => f.Display.Name).ToArray()" ItemsLabel="@T["Support.Unverified.ItemsLabel"]"
                    Description="@T["Support.Unverified.Description"]" />
            }
        </section>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@* 0.26.0: read-only reticle and fire modes show Runtime's blocker compactly (no invented controls); backpack-fed weapons show their
   backpack ammunition even when the weapon's own fields are blocked (the Cremator resolves to two native roots). *@
@if (!ModifiedOnly && (Workspace.Metadata ?? Workspace.SdkStatus?.Installed) is { Has026: true } sdk026)
{
    var blocked = sdk026.SupportAuthoring?.Weapons.FirstOrDefault(w => w.Name == Weapon)?.BlockedFields.Where(b => b.Field is FireModes.ReticleField or FireModes.ModesField).ToArray() ?? [];
    @if (fields.All(f => f.SemanticFieldId != FireModes.ModesField) && sdk026.FireModes?.Find("support", Weapon) is { Writable: false }) { <SupportFireModes Weapon="@Weapon" Changed="Refresh" /> }
    @foreach (var b in blocked.Where(b => b.Field == FireModes.ReticleField && fields.All(f => f.SemanticFieldId != FireModes.ReticleField)))
    { <p class="subtle field-blocker" data-reticle-blocked="@Weapon"><strong>@T["Support.Reticle.Label"]</strong> @T.Format("Support.Reticle.Blocked", b.Reason)</p> }
}
<SupportBackpackAmmo Weapon="@Weapon" ModifiedOnly="ModifiedOnly" Changed="Refresh" />
@code {
    [Parameter] public bool ModifiedOnly { get; set; }
    [Parameter] public string Weapon { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    // Display labels only: published domains stay the filter values and FieldGroups names stay the group keys. Unknown SDK domains show as published.
    public static string Label(IUiText t, string domain) => domain switch
    {
        "magazine" => t["Support.Domain.Magazine"], "rounds" => t["Support.Domain.Rounds"], "heatsink" => t["Stratagem.Group.Heatsinks"],
        _ => GroupLabel(t, System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(domain)),
    };
    public static string GroupLabel(IUiText t, string group) => group switch
    {
        "Ammo" => t["Stratagem.Group.Ammo"], "Handling" => t["Stratagem.Group.Handling"], "Firing" => t["Stratagem.Group.Firing"], "Fire Mode" => t["Stratagem.Group.FireMode"],
        "Weapon" => t["Stratagem.Group.Weapon"], "Projectile" => t["Stratagem.Group.Projectile"], "Damage" => t["Stratagem.Group.Damage"], "Explosion" => t["Stratagem.Group.Explosion"],
        "Arc" => t["Stratagem.Group.Arc"], "Beam" => t["Stratagem.Group.Beam"], "Status" => t["Stratagem.Group.Status"], "Heat" => t["Stratagem.Group.Heat"],
        "Heatsinks" => t["Stratagem.Group.Heatsinks"], "Charge" => t["Stratagem.Group.Charge"], "Reload" => t["Stratagem.Group.Reload"], "Windup" => t["Stratagem.Group.Windup"],
        "Stratagem" => t["Stratagem.Group.Stratagem"], "Orbital" => t["Stratagem.Group.Orbital"], "Eagle" => t["Stratagem.Group.Eagle"], "Entity" => t["Stratagem.Group.Entity"],
        "Zone" => t["Stratagem.Group.Zone"], "Turret" => t["Stratagem.Group.Turret"], "Targeting" => t["Stratagem.Group.Targeting"], "Payload" => t["Stratagem.Group.Payload"],
        "Minefield" => t["Stratagem.Group.Minefield"], "Shield" => t["Stratagem.Group.Shield"], "Functions" => t["Stratagem.Group.Functions"],
        "Presentation" => t["Stratagem.Group.Presentation"],
        _ => group,
    };
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) { Error = e.Message; } }
    private Task Reset() => Run(() => Workspace.ResetSupportAsync(Weapon));
    private SupportChange? Saved(SupportField f) => Workspace.Project?.SupportChanges.SingleOrDefault(c => c.InstanceKey == f.InstanceKey);
}

@inject BuilderWorkspace Workspace
@* Stratagem browser. Each stratagem is one object: header, call-in, delivered object, then collapsed advanced/provenance.
   Support equipment is presented through its support call-in; equipment without a published structural link is listed as unlinked. *@
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Stratagems; }
<div class="page-heading"><div><div class="eyebrow">GUARDED AUTHORING · SDK @sdk?.Version</div><h1>Stratagems</h1><p>Call-in settings and everything a stratagem delivers: deployed entities, support equipment, mounted weapons and attacks.</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">Build requires review: @issue</div> }
@if (catalog?.Stratagems.Any(s => s.UiIcon != null) == true) { <IconImportPrompt /> }
else if (catalog != null) { <p class="subtle" data-stratagem-icons-unpublished>HD2Runtime SDK @sdk?.Version does not publish stratagem icon identities, so stratagems show category glyphs. Icons appear once the bound SDK publishes each stratagem's icon identity.</p> }
@if (catalog == null) { <section class="panel"><h2>Stratagem authoring requires SDK 0.21</h2><p>Install a compatible SDK in Settings. Existing projects stay pinned until you explicitly rebind from Overview.</p></section> }
else
{
    // Support → Other / Standalone: equipment without a call-in (no_call_in or unlinked) and native-only vehicles/backpacks.
    var showOther = Category is "" or "support" && Family is "" or StratagemCategories.OtherSupport && Availability == "" && System == "";
    var unlinked = showOther ? SupportEquipment.Unlinked(sdk).Where(w => w.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToArray() : [];
    var standalone = showOther ? SupportEquipment.Standalone(sdk).Where(w => w.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToArray() : [];
    var nativeEntities = showOther ? StratagemCategories.EntitiesWithoutCallIn(sdk?.Entities).Where(e => e.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToArray() : [];
    var otherCount = SupportEquipment.Unlinked(sdk).Count + SupportEquipment.Standalone(sdk).Count + StratagemCategories.EntitiesWithoutCallIn(sdk?.Entities).Count;
    <div class="category-pills" role="tablist" aria-label="Stratagem categories">
        <button role="tab" class="category-pill @(Category == "" ? "active" : "")" aria-selected="@(Category == "")" data-category="all" @onclick='() => SelectCategory("")'>All <small>@catalog.Stratagems.Count(s => StratagemCategories.Listed(s, sdk?.Entities))</small></button>
        @foreach (var c in StratagemCategories.All)
        { <button role="tab" class="category-pill @c.CssClass @(Category == c.Key ? "active" : "")" aria-selected="@(Category == c.Key)" data-category="@c.Key" @onclick="() => SelectCategory(c.Key)"><span class="cat-dot" aria-hidden="true"></span>@c.Label <small>@StratagemCategories.Count(catalog, c, sdk?.Entities)</small></button> }
    </div>
    <div class="family-tabs" role="tablist" aria-label="Stratagem families">
        @foreach (var tab in StratagemBrowser.Tabs(catalog).Where(t => t.Family == "" || InCategory(t.Family) && catalog.Stratagems.Any(s => s.Family == t.Family && StratagemCategories.Listed(s, sdk?.Entities))))
        { <button role="tab" class="family-tab @((tab.Family == "" ? StratagemCategories.Find(Category) : StratagemCategories.Of(tab.Family))?.CssClass) @(Family == tab.Family ? "active" : "")" aria-selected="@(Family == tab.Family)" data-family-tab="@(tab.Family == "" ? "all" : tab.Family)" @onclick="() => Family = tab.Family">@(tab.Family == "" ? "All " + (StratagemCategories.Find(Category)?.Label ?? "families") : tab.Label) <small>@(catalog.Stratagems.Count(s => (tab.Family == "" ? InCategory(s.Family) : s.Family == tab.Family) && StratagemCategories.Listed(s, sdk?.Entities)))</small></button> }
        @if (Category == "support" && otherCount > 0)
        { <button role="tab" class="family-tab cat-support @(Family == StratagemCategories.OtherSupport ? "active" : "")" aria-selected="@(Family == StratagemCategories.OtherSupport)" data-family-tab="other" @onclick="() => Family = StratagemCategories.OtherSupport">Other / Standalone <small>@otherCount</small></button> }
    </div>
    <div class="weapon-editor"><section class="panel weapon-browser">@{ var shown = catalog.Stratagems.Count(s => Visible(catalog, s)); }<h2>@shown @(shown == 1 ? "stratagem" : "stratagems")</h2>
        <label>Search<input id="stratagem-search" @bind="Search" @bind:event="oninput" placeholder="Name, ID or type" /></label>
        <label>System<select id="stratagem-system" @bind="System"><option value="">All systems</option><option value="cooldown">Cooldown</option>@foreach (var domain in catalog.FieldInstances.Select(f => f.Domain).Distinct().Order()) { <option value="@domain">@SupportAuthoringEditor.Label(domain)</option> }<option value="beam">Beam</option></select></label>
        <label>Availability<select @bind="Availability"><option value="">All capabilities</option><option value="writable">Writable</option><option value="blocked">Read-only / blocked</option><option value="shared">Shared</option></select></label>
        <div class="weapon-list">
            @foreach (var root in catalog.Stratagems.Where(s => Visible(catalog, s)))
            {
                var category = StratagemCategories.Of(root.Family);
                <button class="resource-item with-icon @category?.CssClass @(Selected == root.Name ? "active" : "")" data-stratagem="@root.Name" data-family="@root.Family" @onclick="() => Selected = root.Name">
                    <GameIcon Kind="stratagem" Key="@GameIconStore.StratagemIconKey(root)" State="@root.UiIcon?.State" Reason="@IconReason(catalog, root)" Label="@root.Name" CssClass="@category?.CssClass" />
                    <span class="resource-text"><strong>@root.Name@if (Warning(catalog, root) is { } warning) { <span class="warn-dot" title="@warning">●</span> }</strong><small>@FamilyLabel(root.Family) · @Summary(catalog, root)</small></span></button>
            }
            @if (unlinked.Length > 0)
            {
                <div class="list-group-title" data-unlinked-support-group>@(sdk?.SupportLinks == null ? "Support equipment (not linked by this SDK)" : "Unlinked support equipment")</div>
                @foreach (var weapon in unlinked)
                {
                    <button class="resource-item with-icon cat-support @(Selected == Equipment + weapon ? "active" : "")" data-unlinked-support="@weapon" @onclick="() => Selected = Equipment + weapon">
                        <GameIcon Kind="stratagem" Label="@weapon" CssClass="cat-support" />
                        <span class="resource-text"><strong>@weapon</strong><small>Support equipment · @(sdk?.SupportAuthoring?.Weapons.SingleOrDefault(w => w.Name == weapon)?.Writable == true ? "writable" : "read-only") · no call-in link</small></span></button>
                }
            }
            @if (standalone.Length > 0)
            {
                <div class="list-group-title" data-standalone-support-group>Standalone equipment · no call-in</div>
                @foreach (var weapon in standalone)
                {
                    <button class="resource-item with-icon cat-support @(Selected == Equipment + weapon ? "active" : "")" data-standalone-support="@weapon" @onclick="() => Selected = Equipment + weapon">
                        <GameIcon Kind="stratagem" Label="@weapon" CssClass="cat-support" State="no_native_root" Reason="@("No call-in stratagem: " + sdk?.SupportAuthoring?.Weapons.SingleOrDefault(w => w.Name == weapon)?.LinkedStratagem?.NoCallIn?.Reason)" />
                        <span class="resource-text"><strong>@weapon</strong><small>@AcquisitionLabel(sdk, weapon) · @(sdk?.SupportAuthoring?.Weapons.SingleOrDefault(w => w.Name == weapon)?.Writable == true ? "writable" : "read-only")</small></span></button>
                }
            }
            @if (nativeEntities.Length > 0)
            {
                <div class="list-group-title" data-native-entity-group>Vehicles &amp; backpacks without a call-in</div>
                @foreach (var (resource, name) in nativeEntities)
                {
                    <button class="resource-item with-icon cat-support @(Selected == EntityKey(resource, name) ? "active" : "")" data-support-entity="@name" data-entity-resource="@resource" @onclick="() => Selected = EntityKey(resource, name)">
                        <GameIcon Kind="stratagem" Label="@name" CssClass="cat-support" Reason="No call-in stratagem: the SDK publishes no call-in for this native-only item." />
                        <span class="resource-text"><strong>@name</strong><small>@(resource == "vehicle" ? "Native-only vehicle" : "Native-only backpack") · no call-in</small></span></button>
                }
            }
        </div>
    </section><div class="weapon-detail">
        @if (Selected.StartsWith(Equipment, StringComparison.Ordinal) && sdk?.Advanced?.Support?.Weapons.ContainsKey(Selected[Equipment.Length..]) == true)
        {
            var weapon = Selected[Equipment.Length..]; var descriptor = sdk.SupportAuthoring?.Weapons.SingleOrDefault(w => w.Name == weapon);
            @if (descriptor?.LinkedStratagem is { IsNoCallIn: true } noCallIn && SupportEquipment.IsStandalone(sdk, weapon))
            {
                // Runtime proves the game defines no call-in for this equipment; it is standalone, not unresolved.
                <section class="panel category-panel cat-support" data-standalone-support-detail="@weapon">
                    <div class="object-header"><GameIcon Kind="stratagem" Label="@weapon" CssClass="cat-support" Size="md" />
                        <div><h2>@weapon</h2><div class="field-badges"><span class="category-pill static cat-support"><span class="cat-dot" aria-hidden="true"></span>Support</span><span class="badge" data-standalone-badge>No call-in · @AcquisitionLabel(sdk, weapon)</span></div></div></div>
                    <p class="subtle" data-no-call-in-reason>@noCallIn.NoCallIn!.Reason</p>
                    @if (noCallIn.NoCallIn.Acquisition?.Note is { } note) { <details class="subtle"><summary>Acquisition evidence</summary><p>@note</p></details> }
                </section>
            }
            else
            {
                <section class="panel category-panel cat-support" data-unlinked-support-detail="@weapon">
                    <div class="object-header"><GameIcon Kind="stratagem" Label="@weapon" CssClass="cat-support" Size="md" />
                        <div><h2>@weapon</h2><div class="field-badges"><span class="category-pill static cat-support"><span class="cat-dot" aria-hidden="true"></span>Support</span><span class="badge amber" data-unlinked-badge>Unlinked support equipment</span></div></div></div>
                    <p class="subtle">@(descriptor?.LinkedStratagem?.Blocker ?? (sdk.SupportLinks == null ? $"HD2Runtime {sdk.Version} does not publish which call-in delivers this equipment, so it is not paired with a stratagem." : "HD2Runtime publishes no structural call-in link for this equipment, so it is not paired with a stratagem."))</p>
                </section>
            }
            <SupportWeaponDetail Weapon="@weapon" Changed="Refresh" @key="weapon" />
        }
        else if (Selected.StartsWith(EntityPrefix, StringComparison.Ordinal) && Selected.Split(':', 3) is [_, var resource, var entityName])
        {
            // Native-only vehicle/backpack: no call-in stratagem, only its own published controls.
            if (resource == "vehicle") { <VehicleEditor Name="@entityName" Changed="Refresh" @key="Selected" /> } else { <BackpackEditor Name="@entityName" Changed="Refresh" @key="Selected" /> }
        }
        else if (catalog.Root(Selected) is { } stratagem)
        {
            var graph = StratagemGraph.Build(catalog, stratagem.Name); var category = StratagemCategories.Of(stratagem.Family);
            var fields = catalog.FieldInstances.Where(f => f.Target.Stratagem == stratagem.Name).ToArray();
            var link = sdk?.SupportLinks?.ForStratagem(stratagem.Name);
            (string Resource, string Entity)? delivered = sdk?.Entities?.CallIns.TryGetValue(stratagem.Name, out var callIn) == true ? callIn : null;
            // The object is the call-in plus what it delivers: count the linked equipment's published fields too.
            var equipment = link == null ? [] : sdk!.SupportAuthoring!.FieldInstances.Where(f => f.SupportWeapon == link.Weapon.Name).ToArray();
            <section class="panel category-panel @category?.CssClass" data-stratagem-category="@category?.Key" data-stratagem-header="@stratagem.Name">
                <div class="object-header"><GameIcon Kind="stratagem" Key="@GameIconStore.StratagemIconKey(stratagem)" State="@stratagem.UiIcon?.State" Reason="@IconReason(catalog, stratagem)" Label="@stratagem.Name" CssClass="@category?.CssClass" Size="md" />
                    <div><h2>@stratagem.Name</h2>
                        <div class="field-badges">@if (category != null) { <span class="category-pill static @category.CssClass"><span class="cat-dot" aria-hidden="true"></span>@category.Label</span> }
                            <span class="badge">@FamilyLabel(stratagem.Family)</span>
                            @if (stratagem.DeployedEntity is { } entity) { <span class="badge">@EntityStats.KindLabel(entity)</span> }
                            @if (delivered is { } del) { <span class="badge" data-delivers-entity="@del.Entity" title="Linked by HD2Runtime's published call-in relationship">Delivers @del.Entity</span> }
                            @if (link != null) { <span class="badge" data-support-linked="@link.Weapon.Name" title="Linked by HD2Runtime's structural call-in relationship; call-in and weapon remain separate guarded targets.">Delivers @link.Weapon.Name</span> }
                            <span class="badge @(stratagem.RootResolution == "UNIQUE" ? "green" : "")" title="Root identity: @stratagem.RootResolution">@(fields.Count(f => f.Editable) + equipment.Length) writable</span>
                            @if (fields.Count(f => !f.Editable) + graph.Blocked.Length is var readOnly and > 0) { <span class="badge" title="See Advanced / provenance">@readOnly read-only</span> }
                            @if (fields.Any(f => f.Shared)) { <span class="badge amber" data-flag="allow_shared" title="Some objects are shared with other stratagems and need acknowledgement">Shared objects</span> }</div></div></div>
                @if (stratagem.BlockedReason != null) { <p class="notice warning">@stratagem.BlockedReason</p> }
                @if (stratagem.Family == "support" && link == null)
                {
                    if (sdk?.SupportLinks == null) { <p class="notice cat-note cat-support" data-support-link-blocker>HD2Runtime @sdk?.Version does not publish which support equipment this call-in delivers. The equipment is listed under <strong>Support equipment</strong> at the end of the Support list.</p> }
                    else if (stratagem.Delivers is { Known: false } unresolved) { <p class="notice cat-note cat-support" data-support-link-unresolved>No delivered equipment is linked to this call-in: @unresolved.Blocker</p> }
                }
                @if (stratagem.Family == "mine" && stratagem.MineInstanceResolved != true)
                { <p class="notice" data-mine-scope>Runtime resolves this minefield's stratagem and deployment entity only. Individual mines, their triggers, distribution and attacks have no controls.</p> }
            </section>
            @if (delivered is { } d)
            {
                // One coherent editor: the vehicle/backpack editor includes this call-in's settings (CallInFields) and everything it delivers.
                if (d.Resource == "vehicle") { <VehicleEditor Name="@d.Entity" Embedded="true" Changed="Refresh" @key="d.Entity" /> }
                else { <BackpackEditor Name="@d.Entity" Embedded="true" Changed="Refresh" @key="d.Entity" /> }
            }
            else { <StratagemEditor Name="@stratagem.Name" Changed="Refresh" @key="stratagem.Name" /> }
            <details class="ia-section advanced" data-section="advanced" open="@(fields.All(f => !f.Editable) && graph.Blocked.Length > 0)"><summary>Advanced / provenance <small>structure, read-only reasons and inspection</small></summary><div class="ia-body">
                @if (graph.Entities.Length > 0)
                {
                    <ol class="graph-outline" data-stratagem-graph>
                        <li>Stratagem</li>
                        @foreach (var e in graph.Entities)
                        {
                            <li>Deployed Entity <small>@EntityStats.KindLabel(e.Identity)</small>
                                @if (e.Weapons.Length > 0) { <ol>@foreach (var w in e.Weapons) { <li>Mounted Weapon · @w.Title <small>@string.Join(" · ", w.Groups.Select(g => g.Title).Concat(w.Attacks.Select(a => a.Title)))</small></li> }</ol> }
                            </li>
                        }
                    </ol>
                }
                @if (link != null) { <DeliveryGraph Link="link" /> }
                <div data-blocked-capabilities><h3 class="group-title">Not currently writable</h3>
                    <p><strong>Call-In Time:</strong> @stratagem.CallInTime.Reason</p><p><strong>Max Uses:</strong> @stratagem.MaxUses.Reason</p>
                    @if (stratagem.BarrageScheduling != null) { <p><strong>Barrage scheduling:</strong> @stratagem.BarrageScheduling.Reason</p> }
                    @foreach (var blocked in graph.Blocked) { <p data-blocked-field="@blocked.Field"><strong>@BlockedLabel(blocked.Field):</strong> @blocked.Reason</p> }</div>
                <p class="subtle">Root identity @stratagem.RootResolution · <code>@stratagem.SemanticId</code></p>
                @if (IconReason(catalog, stratagem) is { } iconReason) { <p class="subtle" data-icon-reason="@stratagem.UiIcon!.State">Icon · @iconReason</p> }
                else if (stratagem.UiIcon is { State: "resolved" } icon) { <p class="subtle" data-icon-reason="resolved">Icon · <code>@icon.IconKey</code> from the game icon library (native type @icon.NativeType)</p> }
                @if (catalog.SemanticBranches.Any(b => b.Stratagem == stratagem.Name))
                {
                    <h3 class="group-title">Delivery graph / inspection</h3>
                    @foreach (var branch in catalog.SemanticBranches.Where(b => b.Stratagem == stratagem.Name))
                    {
                        <div class="graph-node"><strong>@branch.Name</strong> <span class="badge">@branch.KindLabel</span>
                            @if (branch.SemanticRoles is { Length: > 0 } roles) { <p>@string.Join(" / ", roles)</p> }
                            @if (branch.SourcePath != null) { <p>@branch.SourcePath</p> }
                            @if (branch.RelationshipEvidence != null) { <small>@branch.RelationshipEvidence@(branch.RelationshipVerified == false ? " · relationship not verified" : "")</small> }
                            <small>@branch.Correlation</small></div>
                    }
                }
            </div></details>
        }
        else { <section class="panel"><h2>Choose a stratagem</h2><p>Each stratagem shows its call-in settings together with what it delivers. Changes save automatically in your active project.</p><p>@catalog.Summary.WritableFieldInstances writable instances · @catalog.Summary.SharedConsumerScopeCount reviewed shared scopes@(catalog.DeployedEntities is { } entities ? $" · {entities.Length} deployed entities" : "")</p></section> }
    </div></div>
}
@code {
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public EventCallback<string> CategoryChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private const string Equipment = "equipment:", EntityPrefix = "entity:";
    private static string EntityKey(string resource, string name) => EntityPrefix + resource + ":" + name;
    // Opens a Support tab (family "vehicle" / "backpack" / "support" / "other"), e.g. from the old Vehicles / Backpacks routes.
    [Parameter] public string? SupportTab { get; set; }
    private string? shownSupportTab;
    private string? shownCategory;
    protected override void OnParametersSet()
    {
        if (shownCategory != Category) { shownCategory = Category; Family = ""; }
        if (SupportTab != shownSupportTab) { shownSupportTab = SupportTab; if (SupportTab != null) Family = SupportTab; }
    }
    private bool InCategory(string family) => StratagemCategories.Find(Category) is not { } c || c.Families.Contains(family);
    private bool Visible(StratagemCatalog c, StratagemDefinition s) => StratagemCategories.Listed(s, (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.Entities) && InCategory(s.Family) && StratagemBrowser.Matches(c, s, Family, Search, System, Availability);
    private async Task SelectCategory(string key) { Category = shownCategory = key; Family = ""; await CategoryChanged.InvokeAsync(key); }
    private string Search = "", Family = "", System = "", Availability = "", Selected = "";
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    public static string FamilyLabel(string family) => StratagemBrowser.FamilyLabel(family);
    // Why a stratagem shows a glyph instead of its game icon, from Runtime's published uiIcon (never inferred from names).
    public static string? IconReason(StratagemCatalog c, StratagemDefinition s) => s.UiIcon is null ? null : s.UiIcon.FallbackReason(c.UiIconContract) is { } reason
        ? (s.UiIcon.State switch { "empty_template" => "No icon artwork", "unbound" => "No game icon", "no_native_root" => "No call-in stratagem", _ => "No icon" }) + ": " + reason : null;
    // Runtime's published acquisition kind for no-call-in equipment (e.g. world_pickup → "World pickup").
    private static string AcquisitionLabel(SdkMetadata? sdk, string weapon) => sdk?.SupportAuthoring?.Weapons.SingleOrDefault(w => w.Name == weapon)?.LinkedStratagem?.NoCallIn?.Acquisition?.Kind is { } kind
        ? FieldPresentation.EnumLabel(kind) : "No call-in";
    private string Summary(StratagemCatalog c, StratagemDefinition s)
    {
        var writable = c.FieldInstances.Any(f => f.Target.Stratagem == s.Name && f.Editable);
        var link = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.SupportLinks?.ForStratagem(s.Name);
        var delivered = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.Entities?.CallIns.GetValueOrDefault(s.Name);
        var what = link != null ? "call-in + " + (link.Weapon.Writable ? "equipment" : "read-only equipment")
            : delivered is { Resource: { } resource } ? "call-in + " + resource
            : s.DeployedEntity is { } e ? EntityStats.KindLabel(e).ToLowerInvariant() + (e.WeaponBranches.Length > 0 ? " + weapon" : "")
            : s.AttackRoles.Length == 0 ? "call-in" : s.AttackRoles.Length + " attacks";
        return what + " · " + (writable ? "writable" : "read-only");
    }
    // One short list indicator: shared objects need acknowledgement; a non-unique root is read-only.
    private static string? Warning(StratagemCatalog c, StratagemDefinition s) =>
        s.RootResolution != "UNIQUE" ? "Root identity not unique: read-only" : c.FieldInstances.Any(f => f.Target.Stratagem == s.Name && f.Shared) ? "Includes shared objects (acknowledgement required)" : null;
    private static string BlockedLabel(string field) => field switch
    {
        "targeting.*" => "Targeting (range, traverse, tracking, firing arc)",
        _ => char.ToUpperInvariant(field[0]) + field[1..].Replace('.', ' ').Replace('_', ' '),
    };
}

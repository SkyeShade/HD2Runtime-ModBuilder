@inject BuilderWorkspace Workspace
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Stratagems; }
<div class="page-heading"><div><div class="eyebrow">GUARDED AUTHORING · SDK @sdk?.Version</div><h1>Stratagems</h1><p>Call-in settings, deployed entities, mounted weapons and published attack branches.</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">Build requires review: @issue</div> }
@if (catalog == null) { <section class="panel"><h2>Stratagem authoring requires SDK 0.21</h2><p>Install a compatible SDK in Settings. Existing projects stay pinned until you explicitly rebind from Overview.</p></section> }
else
{
    <div class="category-pills" role="tablist" aria-label="Stratagem categories">
        <button role="tab" class="category-pill @(Category == "" ? "active" : "")" aria-selected="@(Category == "")" data-category="all" @onclick='() => SelectCategory("")'>All <small>@catalog.Stratagems.Length</small></button>
        @foreach (var c in StratagemCategories.All)
        { <button role="tab" class="category-pill @c.CssClass @(Category == c.Key ? "active" : "")" aria-selected="@(Category == c.Key)" data-category="@c.Key" @onclick="() => SelectCategory(c.Key)"><span class="cat-dot" aria-hidden="true"></span>@c.Label <small>@StratagemCategories.Count(catalog, c)</small></button> }
    </div>
    <div class="family-tabs" role="tablist" aria-label="Stratagem families">
        @foreach (var tab in StratagemBrowser.Tabs(catalog).Where(t => t.Family == "" || InCategory(t.Family)))
        { <button role="tab" class="family-tab @((tab.Family == "" ? StratagemCategories.Find(Category) : StratagemCategories.Of(tab.Family))?.CssClass) @(Family == tab.Family ? "active" : "")" aria-selected="@(Family == tab.Family)" data-family-tab="@(tab.Family == "" ? "all" : tab.Family)" @onclick="() => Family = tab.Family">@(tab.Family == "" ? "All " + (StratagemCategories.Find(Category)?.Label ?? "families") : tab.Label) <small>@(tab.Family == "" ? catalog.Stratagems.Count(s => InCategory(s.Family)) : tab.Count)</small></button> }
    </div>
    <div class="weapon-editor"><section class="panel weapon-browser">@{ var shown = catalog.Stratagems.Count(s => Visible(catalog, s)); }<h2>@shown @(shown == 1 ? "stratagem" : "stratagems")</h2>
        <label>Search<input id="stratagem-search" @bind="Search" @bind:event="oninput" placeholder="Stratagem name" /></label>
        <label>System<select id="stratagem-system" @bind="System"><option value="">All systems</option><option value="cooldown">Cooldown</option>@foreach (var domain in catalog.FieldInstances.Select(f => f.Domain).Distinct().Order()) { <option value="@domain">@SupportAuthoringEditor.Label(domain)</option> }<option value="beam">Beam</option></select></label>
        <label>Availability<select @bind="Availability"><option value="">All capabilities</option><option value="writable">Writable</option><option value="blocked">Read-only / blocked</option><option value="shared">Shared</option></select></label>
        <div class="weapon-list">@foreach (var root in catalog.Stratagems.Where(s => Visible(catalog, s)))
        { <button class="resource-item @(StratagemCategories.Of(root.Family)?.CssClass) @(Selected == root.Name ? "active" : "")" data-stratagem="@root.Name" data-family="@root.Family" @onclick="() => Selected = root.Name"><strong>@root.Name</strong><small>@FamilyLabel(root.Family) · @(root.RootResolution == "UNIQUE" ? "Writable" : "Read-only") · @Summary(catalog, root)</small></button> }</div>
    </section><div class="weapon-detail">
        @if (catalog.Root(Selected) is { } stratagem)
        {
            var graph = StratagemGraph.Build(catalog, stratagem.Name);
            <section class="panel category-panel @(StratagemCategories.Of(stratagem.Family)?.CssClass)" data-stratagem-category="@(StratagemCategories.Of(stratagem.Family)?.Key)"><h2>@stratagem.Name</h2>@if (StratagemCategories.Of(stratagem.Family) is { } category) { <span class="category-pill static @category.CssClass"><span class="cat-dot" aria-hidden="true"></span>@category.Label</span> }<span class="badge">@FamilyLabel(stratagem.Family)</span><span class="badge">@stratagem.RootResolution</span>
                @if (stratagem.DeployedEntity is { } entity) { <span class="badge">@EntityStats.KindLabel(entity)</span> }
                @if (stratagem.BlockedReason != null) { <p class="notice warning">@stratagem.BlockedReason</p> }
                @if (graph.Entities.Length > 0)
                {
                    <ol class="graph-outline" data-stratagem-graph>
                        <li>Stratagem</li>
                        @foreach (var e in graph.Entities)
                        {
                            <li>Deployed Entity <small>@EntityStats.KindLabel(e.Identity)</small>
                                @if (e.Weapons.Length > 0) { <ol>@foreach (var w in e.Weapons) { <li>Mounted Weapon · @w.Title <small>@string.Join(" · ", w.Groups.Select(g => g.Title).Concat(w.Attacks.Select(a => a.Title)))</small></li> }</ol> }
                            </li>
                        }
                    </ol>
                }
                @if (stratagem.Family == "support")
                {
                    if (sdk?.SupportLinks == null) { <p class="notice cat-note cat-support" data-support-link-blocker>Support weapon equipment is edited under <strong>Support Weapons</strong>. HD2Runtime @sdk?.Version does not publish which support weapon a call-in delivers, so this call-in and its weapon are not paired automatically.</p> }
                    else if (sdk.SupportLinks.ForStratagem(stratagem.Name) is { } link) { <p class="notice cat-note cat-support" data-support-linked="@link.Weapon.Name">This call-in delivers <strong>@link.Weapon.Name</strong>. Its weapon controls are shown below with the call-in, using HD2Runtime's structural link. Call-in and weapon edits remain separate guarded targets.</p> }
                    else if (stratagem.Delivers is { Known: false } unresolved) { <p class="notice cat-note cat-support" data-support-link-unresolved>No support weapon is linked to this call-in: @unresolved.Blocker</p> }
                }
                @if (stratagem.Family == "mine" && stratagem.MineInstanceResolved != true)
                { <p class="notice" data-mine-scope>Runtime resolves this minefield's stratagem and deployment entity only. Individual mines, their triggers, distribution and explosion/status attacks are not resolved, so they have no controls here.</p> }
                <details open="@(graph.Blocked.Length > 0)" data-blocked-capabilities><summary>Not currently writable</summary>
                    <p><strong>Call-In Time:</strong> @stratagem.CallInTime.Reason</p><p><strong>Max Uses:</strong> @stratagem.MaxUses.Reason</p>
                    @if (stratagem.BarrageScheduling != null) { <p><strong>Barrage scheduling:</strong> @stratagem.BarrageScheduling.Reason</p> }
                    @foreach (var blocked in graph.Blocked) { <p data-blocked-field="@blocked.Field"><strong>@BlockedLabel(blocked.Field):</strong> @blocked.Reason</p> }
                </details>
            </section>
            <StratagemEditor Name="@stratagem.Name" Changed="Refresh" @key="stratagem.Name" />
            @if (catalog.SemanticBranches.Any(b => b.Stratagem == stratagem.Name))
            {
                <details class="panel"><summary>Delivery graph / inspection</summary>
                @foreach (var branch in catalog.SemanticBranches.Where(b => b.Stratagem == stratagem.Name))
                {
                    <div class="graph-node"><strong>@branch.Name</strong> <span class="badge">@branch.KindLabel</span>
                        @if (branch.SemanticRoles is { Length: > 0 } roles) { <p>@string.Join(" / ", roles)</p> }
                        @if (branch.SourcePath != null) { <p>@branch.SourcePath</p> }
                        @if (branch.RelationshipEvidence != null) { <small>@branch.RelationshipEvidence@(branch.RelationshipVerified == false ? " · relationship not verified" : "")</small> }
                        <small>@branch.Correlation</small></div>
                }
                </details>
            }
        }
        else { <section class="panel"><h2>Choose a stratagem</h2><p>Orbital, Eagle, support-weapon call-ins and defensive deployables stay separate from weapon authoring. Changes save automatically in your active project.</p><p>@catalog.Summary.WritableFieldInstances writable instances · @catalog.Summary.SharedConsumerScopeCount reviewed shared scopes@(catalog.DeployedEntities is { } entities ? $" · {entities.Length} deployed entities" : "")</p></section> }
    </div></div>
}
@code {
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public EventCallback<string> CategoryChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? shownCategory;
    protected override void OnParametersSet() { if (shownCategory != Category) { shownCategory = Category; Family = ""; } }
    private bool InCategory(string family) => StratagemCategories.Find(Category) is not { } c || c.Families.Contains(family);
    private bool Visible(StratagemCatalog c, StratagemDefinition s) => InCategory(s.Family) && StratagemBrowser.Matches(c, s, Family, Search, System, Availability);
    private async Task SelectCategory(string key) { Category = shownCategory = key; Family = ""; await CategoryChanged.InvokeAsync(key); }
    private string Search = "", Family = "", System = "", Availability = "", Selected = "";
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    public static string FamilyLabel(string family) => StratagemBrowser.FamilyLabel(family);
    private string Summary(StratagemCatalog c, StratagemDefinition s) => (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.SupportLinks?.ForStratagem(s.Name) is { } link
        ? "Call-in + weapon" + (link.Weapon.Writable ? "" : " (weapon read-only)")
        : s.DeployedEntity is { } e
        ? EntityStats.KindLabel(e) + (e.WeaponBranches.Length > 0 ? " · " + e.WeaponBranches.Length + " mounted weapon" + (e.WeaponBranches.Length == 1 ? "" : "s") : "")
        : s.AttackRoles.Length == 0 ? "Call-in definition" : s.AttackRoles.Length + " branches";
    private static string BlockedLabel(string field) => field switch
    {
        "targeting.*" => "Targeting (range, traverse, tracking, firing arc)",
        _ => char.ToUpperInvariant(field[0]) + field[1..].Replace('.', ' ').Replace('_', ' '),
    };
}

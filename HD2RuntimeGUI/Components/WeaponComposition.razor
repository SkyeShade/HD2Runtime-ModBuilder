@inject BuilderWorkspace Workspace

@if (Workspace.Metadata?.Composition is { } graph)
{
    <section class="semantic-section" data-section="Composition">
        <h2>Composition</h2>
        <div class="stat-grid">
        @foreach (var attack in graph.Projectiles.Weapons.Single(w => w.Weapon == Weapon).Attacks)
        {
            <ProjectileSelector @key="(Weapon, attack.Role)" Weapon="@Weapon" Attack="attack" Changed="Refresh" />
        }
        </div>
        @if (graph.Projectiles.Weapons.Single(w => w.Weapon == Weapon).Attacks.Count == 0)
        { <p class="subtle">No resolved projectile attack is published for this weapon. Its supported scalar fields remain below.</p> }
        @if (graph.Magazines.Weapons.Single(w => w.Weapon == Weapon).DefaultOption is { } option)
        {
            <details class="panel composition-inspection" data-inspection="magazine"><summary><strong>Magazine Options</strong> <span class="badge">Read-only</span></summary>
                <h3>@option.Name</h3><p>Default: @(option.Default ? "Yes" : "No")</p>
                <dl class="composition-values"><dt>Capacity</dt><dd>@option.Values.Capacity</dd><dt>Starting magazines</dt><dd>@option.Values.StartingMagazines</dd><dt>Spare magazines</dt><dd>@option.Values.SpareMagazines</dd><dt>Supply magazines</dt><dd>@option.Values.MagazinesFromSupply</dd></dl>
                <p class="subtle">@option.Reason</p><p class="subtle">@graph.Magazines.Weapons.Single(w => w.Weapon == Weapon).AlternateOptions.Reason</p>
            </details>
        }
        else if (graph.Magazines.Weapons.Single(w => w.Weapon == Weapon) is { ObservedCustomizationOptions.Count: > 0 } observed)
        {
            <details class="panel composition-inspection" data-inspection="magazine"><summary><strong>Observed Magazine Options</strong> <span class="badge">Read-only</span></summary>
                <p class="subtle">These identities occur in customization data. Their default/allowed relationship and option-owned ammo values are not proven.</p>
                @foreach (var item in observed.ObservedCustomizationOptions) { <p>@item.Name</p> }
                <p class="subtle">@observed.AlternateOptions.Reason</p>
            </details>
        }
        @{ var fire = graph.FireModes.Weapons.Single(w => w.Weapon == Weapon); }
        <details class="panel composition-inspection" data-inspection="fire-mode"><summary><strong>Fire Mode</strong> <span class="badge">Read-only</span></summary>
            <p>Native mode: <strong>@fire.PrimaryFireModeNativeValue</strong></p><p class="subtle">@fire.Reason</p>
        </details>
        @{ var terminal = graph.TerminalActions.Weapons.Single(w => w.Weapon == Weapon); }
        @if (terminal.Attacks.Count > 0)
        {
            <details class="panel composition-inspection" data-inspection="terminal"><summary><strong>Projectile Actions</strong> <span class="badge">Read-only · SDK baseline</span></summary>
            @foreach (var attack in terminal.Attacks)
            {
                <h3>@attack.Role.Replace('_', ' ')</h3>
                @foreach (var action in attack.Actions)
                {
                    <div class="metadata-row"><strong>@action.Phase</strong><span>@(action.LinkedExplosionRecord ? "ExplosionSettings · " + action.ReferenceType : action.ActionKind == "none" ? "None" : "Unresolved")</span></div>
                    <p class="subtle">@action.Reason</p>
                }
            }
            <p class="subtle">Inspection describes the published baseline, not a simulated result of project modifications.</p>
            </details>
        }
    </section>
}
@code {
    [Parameter, EditorRequired] public string Weapon { get; set; } = "";
    [Parameter] public EventCallback Changed { get; set; }
    private async Task Refresh() => await Changed.InvokeAsync();
}

@inject BuilderWorkspace Workspace
@* The event scripting reference, read from the bound SDK's EventCatalog.json (nothing here is written by hand): events with their payloads
   (and the plain records inside them, such as each stat source's fields), the scripting API (every class, with its fields and methods),
   the live / snapshot handle model, and the dispatch model. Blocked events stay listed with Runtime's reason. Live evidence comes from
   LiveEvidenceCatalog.json. Headings and notes are UI text; event names, payload fields, types, signatures and the SDK's doc strings are
   shown as published. "Insert handler" inserts a subscription skeleton (LuaSnippets.Handler) whose code never depends on the UI language. *@
@{ var catalog = Workspace.Metadata?.Events; var evidence = Workspace.Metadata?.LiveEvidence; }
@if (catalog != null)
{
    <div class="event-reference" data-event-reference>
        <div class="custom-lua-subtabs" role="tablist">
            @foreach (var (key, label) in new[] { ("events", T["EventReference.Section.Events"]), ("utility", T["EventReference.Section.Utility"]), ("handles", T["EventReference.Section.Handles"]), ("model", T["EventReference.Section.Model"]) })
            { <button role="tab" class="@(Section == key ? "active" : "")" data-reference-section="@key" @onclick="() => Section = key">@label</button> }
        </div>
        <label class="reference-search">@T["Common.Search"]<input data-reference-search @bind="Search" @bind:event="oninput" placeholder="@T["EventReference.Search.Placeholder"]" /></label>
        @if (Section == "events")
        {
            @foreach (var e in catalog.Events.Where(e => Match(e.Name, e.Summary, e.Reason, string.Join(" ", e.Payload?.Select(p => p.Name) ?? []))))
            {
                var proof = ScriptingReference.Evidence(evidence, e.Name);
                <details class="reference-item" data-reference-event="@e.Name" open="@(Search.Length > 0)">
                    <summary><code>@e.Name</code>
                        @if (e.IsAvailable) { <span class="badge">@e.Phase</span><span class="badge" title="@catalog.Sources.GetValueOrDefault(e.Source ?? "")">@e.Source</span> }
                        else { <span class="badge red" data-event-blocked>@e.Status</span> }
                        @if (e.Hot) { <span class="badge amber" title="@T["EventReference.EveryTick.Tooltip"]">@T["EventReference.EveryTick.Label"]</span> }
                        @if (proof.Any(p => p.LiveProven)) { <span class="badge green" data-live-proven>@T["EventActions.LiveProven"]</span> }</summary>
                    @if (e.IsAvailable)
                    {
                        <p class="subtle">@e.Summary</p>
                        <p class="subtle">@T.Format("EventReference.Source", catalog.Sources.GetValueOrDefault(e.Source ?? ""))</p>
                        <table class="reference-table"><thead><tr><th>@T["EventReference.Field"]</th><th>@T["EventReference.Type"]</th><th></th></tr></thead><tbody>
                            @foreach (var f in e.Payload ?? [])
                            {
                                <tr data-payload-field="@f.Name"><td><code>@f.Name</code></td><td><code>@f.Type</code></td><td class="subtle">@(f.Nullable ? T.Format("EventReference.MayBeNil", f.Doc) : f.Doc)</td></tr>
                                @foreach (var d in ScriptingReference.Detail(catalog, e, f))
                                {
                                    var name = f.Name + (f.Type.EndsWith("[]", StringComparison.Ordinal) ? "[]." : ".") + d[0].TrimEnd('?');
                                    <tr class="reference-subfield" data-payload-field="@name"><td><code>@name</code></td><td><code>@(d.Length > 1 ? d[1] : "")</code></td><td class="subtle">@(d.Length > 2 ? d[2] : "")</td></tr>
                                }
                            }
                        </tbody></table>
                        <p class="subtle">@T.Markup("EventReference.PayloadCommon.Html", "event", "time", "frame", "mission", "cause")</p>
                        <ScriptEvidenceNote Items="proof" />
                        @if (Insert.HasDelegate && LuaSnippets.Handler(catalog, e) is { } handler)
                        { <button class="small" data-reference-insert="@e.Name" title="@T.Format("EventReference.InsertHandler.Tooltip", "hd2.events.on")" @onclick="() => Insert.InvokeAsync(handler)">@T["EventReference.InsertHandler.Label"]</button> }
                    }
                    else { <p class="notice warning">@e.Reason</p> }
                </details>
            }
        }
        else if (Section == "utility")
        {
            <h3 class="group-title">@T.Format("EventReference.Functions.Title", "hd2")</h3>
            @foreach (var f in catalog.Api.Functions.Where(f => Match(f.Name, f.Doc))) { <div class="reference-item" data-reference-function="@f.Name"><code>hd2.@f.Signature</code><p class="subtle">@f.Doc</p></div> }
            @foreach (var (name, c) in catalog.Api.Classes.Where(c => Match(c.Key, c.Value.Doc, string.Join(" ", c.Value.Methods?.Select(m => m.Name) ?? []), string.Join(" ", c.Value.Fields?.Select(f => f[0]) ?? []))))
            {
                <details class="reference-item" data-reference-class="@name" open="@(Search.Length > 0)"><summary><code>@name</code> <span class="subtle">@c.Doc</span></summary>
                    @foreach (var f in c.Fields ?? []) { <div data-reference-member="@f[0]"><code>@f[0]</code> <small class="subtle">@(f.Length > 1 ? f[1] : "")@(f.Length > 2 && f[2].Length > 0 ? " · " + f[2] : "")</small></div> }
                    @foreach (var m in c.Methods ?? []) { <div class="reference-method" data-reference-member="@m.Name"><code>@m.Signature</code><small class="subtle">@m.Doc</small>
                        <ScriptEvidenceNote Items="ScriptingReference.Evidence(evidence, ApiPath(catalog, name, m.Name))" /></div> }
                </details>
            }
        }
        else if (Section == "handles")
        {
            @foreach (var (name, h) in catalog.Handles)
            {
                <div class="reference-item" data-reference-handle="@name"><h3 class="group-title">@name</h3><p class="subtle">@h.Doc</p>
                    <table class="reference-table"><tbody>
                        @foreach (var f in h.Fields.Where(f => Match(f[0], f.Length > 2 ? f[2] : null))) { <tr><td><code>@f[0]</code></td><td><code>@(f.Length > 1 ? f[1] : "")</code></td><td class="subtle">@(f.Length > 2 ? f[2] : "") <em>@T["EventReference.Snapshot"]</em></td></tr> }
                        @foreach (var m in h.Methods.Where(m => Match(m.Name, m.Doc)))
                        {
                            <tr data-reference-member="@m.Name"><td><code>:@(m.Name)()</code></td><td><code>@m.Returns</code></td><td class="subtle">@m.Doc <em>@T["EventReference.Live"]</em>
                                <ScriptEvidenceNote Items="ScriptingReference.Evidence(evidence, ScriptingReference.HandleSubject(name, m.Name))" /></td></tr>
                        }
                    </tbody></table></div>
            }
            <p class="subtle">@T["EventReference.Handles.Note"]</p>
        }
        else
        {
            @foreach (var (key, text) in catalog.Model) { <div class="reference-item"><strong>@FieldPresentation.EnumLabel(key)</strong><p class="subtle">@text</p></div> }
        }
    </div>
}
@code {
    // Inserts a handler skeleton into the editor; the reference is read-only without it.
    [Parameter] public EventCallback<string> Insert { get; set; }
    private string Section = "events", Search = "";
    private bool Match(params string?[] values) => Search.Trim().Length == 0 || values.Any(v => v?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) == true);
    // The call path of an API class method (hd2.actions.heal) where the hd2 table has a field of that class; else Class.method.
    private static string ApiPath(EventCatalog catalog, string type, string method) =>
        catalog.Api.Fields.FirstOrDefault(f => f.Length > 1 && f[1] == type) is { } field ? "hd2." + field[0] + "." + method : type + "." + method;
}

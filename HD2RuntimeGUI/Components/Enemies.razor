@inject BuilderWorkspace Workspace
@* Enemies or enemy structures (hd2.enemy / hd2.structure; EnemyAuthoringCapabilities.json from unreleased HD2Runtime 0.28.0 development SDKs).
   Every published class is listed by Runtime's name for it: its proven wiki name, otherwise its native class name (wiki candidates are shown as
   candidates, never as identity). Search runs over a per-class index built once per SDK load; only the selected class renders its editor. *@
@{
    var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var catalog = sdk?.Entities?.Enemies;
    var structures = Kind == EnemyAuthoringReader.Structure; var css = structures ? "cat-structure" : "cat-enemy";
}
<div class="page-heading @css"><div><div class="eyebrow">GUARDED AUTHORING · SDK @sdk?.Version@(Workspace.SdkStatus?.LocalSource != null ? " · LOCAL DEVELOPMENT SDK" : "")</div>
    <h1>@(structures ? "Structures" : "Enemies")</h1>
    <p>@(structures ? "Fabricators, emplacements, nests and objective buildings" : "Terminid, Automaton and Illuminate units") from <code>@(structures ? "hd2.structure" : "hd2.enemy")</code>: health, damage zones and the attacks Runtime reaches through each class's mounted weapons. Shared attack rows are written with <code>allow_shared</code>; unconfirmed effects with <code>allow_unverified_effect</code>.</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">Build requires review: @issue</div> }
@if (catalog == null)
{
    <section class="panel" data-enemy-unavailable><h2>@(structures ? "Structure" : "Enemy") authoring needs a newer HD2Runtime SDK</h2>
        <p>This project is bound to SDK @sdk?.Version, which does not publish <code>@EnemyAuthoringReader.FileName</code>. Enemy and structure authoring comes with HD2Runtime 0.28.0; until it is released, start ModBuilder with <code>--sdk-path &lt;HD2Runtime&gt;\sdk</code> (or <code>HD2RUNTIME_SDK_PATH</code>) to use a local development SDK.</p></section>
}
else
{
    var all = catalog.Of(Kind).ToArray();
    var modified = Workspace.Project?.EntityChanges.Where(c => c.Resource == Kind).Select(c => c.Entity).ToHashSet(StringComparer.Ordinal) ?? [];
    var list = all.Where(c => (Faction.Length == 0 || c.Faction == Faction) && catalog.Matches(c, Search.Trim())
        && Show switch { "named" => c.Named, "native" => !c.Named, "attacks" => c.Attacks.Length > 0, "modified" => modified.Contains(c.SemanticId), _ => true }).ToArray();
    <div class="weapon-editor"><section class="panel weapon-browser enemy-browser" data-enemy-browser="@Kind"><h2>@list.Length of @all.Length @(structures ? "structures" : "enemies")</h2>
        <label>Search<input id="enemy-search" data-enemy-search @bind="Search" @bind:event="oninput" placeholder="Name, native class, wiki page, attack or ID" /></label>
        <div class="filter-grid">
            <label>Faction<select data-enemy-faction-filter @bind="Faction"><option value="">All factions</option>@foreach (var f in all.Select(c => c.Faction).Distinct().OrderBy(FactionOrder)) { <option value="@f">@FactionLabel(f)</option> }</select></label>
            <label>Show<select data-enemy-show @bind="Show"><option value="">All</option><option value="named">Wiki-named</option><option value="native">Native names</option><option value="attacks">With attacks</option><option value="modified">Modified</option></select></label>
        </div>
        <div class="weapon-list">
            @foreach (var group in list.GroupBy(c => c.Faction).OrderBy(g => FactionOrder(g.Key)))
            {
                <h3 class="group-title enemy-faction" data-enemy-faction="@group.Key">@FactionLabel(group.Key) <small class="subtle">@group.Count()</small></h3>
                @foreach (var c in group.OrderBy(c => c.Named ? 0 : 1).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <button @key="c.SemanticId" class="resource-item @css @(Selected == c.SemanticId ? "active" : "")" data-enemy-item="@c.SemanticId" @onclick="() => Selected = c.SemanticId">
                        <strong class="@(c.Named ? "" : "native-name")">@c.Name</strong>
                        <small>@Identity(c) · @c.Zones.Length @(c.Zones.Length == 1 ? "zone" : "zones")@(c.Attacks.Length > 0 ? " · " + c.Attacks.Length + (c.Attacks.Length == 1 ? " attack" : " attacks") : "")@(modified.Contains(c.SemanticId) ? " · modified" : "")</small></button>
                }
            }
            @if (list.Length == 0) { <p class="subtle" data-enemy-empty>No @(structures ? "structure" : "enemy") matches this search.</p> }
        </div>
    </section><div class="weapon-detail">
        @if (catalog.Find(Selected) is { } selected && selected.Kind == Kind) { <EnemyEditor SemanticId="@Selected" Changed="Refresh" @key="Selected" /> }
        else
        {
            var fields = all.Sum(c => catalog.Fields(c.SemanticId).Count(f => f.Editable));
            <section class="panel category-panel @css" data-enemy-summary="@Kind"><h2>Choose @(structures ? "a structure" : "an enemy")</h2>
                <p>@all.Length classes · @all.Count(c => c.Named) with a proven wiki name · @all.Sum(c => c.Zones.Length).ToString("N0", System.Globalization.CultureInfo.InvariantCulture) damage zones · @all.Sum(c => c.Attacks.Length) attacks · @fields.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) writable fields</p>
                <p class="subtle" data-applies-to>Applies to @catalog.Model.AppliesTo.</p>
                <p class="subtle">Names are Runtime's: a wiki name only where the class's anatomy proves it, otherwise the native class name. Wiki pages a native class resembles are listed as candidates.</p>
            </section>
        }
    </div></div>
}
@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = EnemyAuthoringReader.Enemy;
    [Parameter] public EventCallback Changed { get; set; }
    private string Search = "", Selected = "", Faction = "", Show = "";
    private string LastKind = "";
    protected override void OnParametersSet() { if (Kind != LastKind) { LastKind = Kind; Search = Selected = Faction = Show = ""; } }
    // Faction keys are Runtime's; the display is the key capitalized. Known factions sort first, anything new after them.
    public static string FactionLabel(string faction) => faction.Length == 0 ? faction : char.ToUpperInvariant(faction[0]) + faction[1..];
    private static int FactionOrder(string faction) => Array.IndexOf(["terminids", "automatons", "illuminate", "neutral"], faction) is var i and >= 0 ? i : 99;
    private static string Identity(EnemyClass c) => c.Named ? "Wiki name" : c.WikiCandidates.Length > 0 ? "Native · like " + string.Join(", ", c.WikiCandidates.Take(2)) + (c.WikiCandidates.Length > 2 ? "…" : "") : "Native class";
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
}

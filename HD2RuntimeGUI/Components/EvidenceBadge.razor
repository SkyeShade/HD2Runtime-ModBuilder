@* Runtime-published evidence tier. Labels deliberately distinguish in-game testing from schema proof, live writes and structure-only references.
   Compact labels keep that distinction in a short badge; the full label, description and proof stay in the tooltip. *@
<span class="badge evidence tier-@Evidence.Tier.Replace('_', '-')" data-evidence-tier="@Evidence.Tier" title="@Tooltip">@(Compact ? Short(Evidence.Tier) : Label(Evidence.Tier))</span>
@code {
    [Parameter, EditorRequired] public EntityEvidence Evidence { get; set; } = null!;
    [Parameter] public IReadOnlyDictionary<string, string>? Tiers { get; set; }
    [Parameter] public bool Compact { get; set; }
    public static string Label(string tier) => tier switch
    {
        "gameplay_proven" => "In-game tested",
        "gameplay_proven_combined" => "In-game (combined edit)",
        "schema_proven" => "Schema-proven",
        "live_write_verified" => "Live write confirmed",
        "structural_reference" => "Structure only",
        // Magazine attachment tiers (0.23.1): the native owner is proven; the gameplay effect of an edit is not.
        "native_owner" => "Native owner · effect unproven",
        "native_owner_effect_consistent" => "Native owner · effects match catalog",
        "native_owner_value_consistent" => "Native owner · value matches catalog",
        // Booster tiers (0.24.0): the native link is proven; no booster edit is gameplay-tested yet.
        "structural_chain_exact_fingerprint" => "Structural chain · exact match · effect unproven",
        "unique_exact_multi_value_fingerprint" => "Unique value fingerprint · effect unproven",
        // Booster tiers (0.25.0): natively traced consumer code; "exact" adds an independent value fingerprint. Effects remain unproven in game.
        "native_table_code_consumer_exact_fingerprint" => "Native table + consumer · exact match · effect unproven",
        "native_table_code_consumer" => "Native table + consumer · effect unproven",
        "structural_code_chain_exact_fingerprint" => "Code chain · exact match · effect unproven",
        "structural_code_selector_exact_fingerprint" => "Code selector · exact match · effect unproven",
        "structural_code_selector" => "Code selector · effect unproven",
        // Throwable tiers (0.27.0): the native member is proven, and "wiki exact" adds an exact published-value match. Effects remain unproven in game.
        "wiki_exact" => "Native member · exact value match · effect unproven",
        "native_member" => "Native member · effect unproven",
        // Enemy tiers (0.28.0 development SDKs): live-tested on enemies, a member proven on vehicles, wiki-correlated members, and mount-chain rows.
        "live_proven" => "In-game tested on enemies",
        "gameplay_proven_member" => "Member proven on vehicles · enemy value untested",
        "schema_wiki_correlated" => "Member + wiki match · effect unproven",
        "mount_chain_structural" => "Mount chain · effect unproven",
        _ => tier.Replace('_', ' '),
    };
    public static string Short(string tier) => tier switch
    {
        "gameplay_proven" => "In-game tested",
        "gameplay_proven_combined" => "In-game (combined)",
        "schema_proven" => "Schema",
        "live_write_verified" => "Live write",
        "structural_reference" => "Structure only",
        "native_owner" or "native_owner_effect_consistent" or "native_owner_value_consistent" => "Native owner",
        "structural_chain_exact_fingerprint" => "Structural chain",
        "unique_exact_multi_value_fingerprint" => "Value fingerprint",
        "native_table_code_consumer_exact_fingerprint" or "native_table_code_consumer" => "Native consumer",
        "structural_code_chain_exact_fingerprint" => "Code chain",
        "structural_code_selector_exact_fingerprint" or "structural_code_selector" => "Code selector",
        "wiki_exact" => "Exact match",
        "native_member" => "Native member",
        "live_proven" => "In-game tested",
        "gameplay_proven_member" => "Proven member",
        "schema_wiki_correlated" => "Wiki-correlated",
        "mount_chain_structural" => "Mount chain",
        _ => tier.Replace('_', ' '),
    };
    private string Tooltip => string.Join("\n", new[] { Label(Evidence.Tier), Tiers?.GetValueOrDefault(Evidence.Tier), Evidence.ReferenceMod == null ? null : "Reference mod: " + Evidence.ReferenceMod,
        Evidence.ProvenOn is { Length: > 0 } on ? "Proven on: " + string.Join(", ", on) : null, Evidence.Proof,
        Evidence.NativeOwner == null ? null : "Native owner: " + Evidence.NativeOwner, Evidence.GameplayWriteEffect == null ? null : "Gameplay effect of a write: " + Evidence.GameplayWriteEffect }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

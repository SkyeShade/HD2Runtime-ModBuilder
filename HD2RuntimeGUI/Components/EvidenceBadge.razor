@* Runtime-published evidence tier. Labels deliberately distinguish in-game testing from schema proof, live writes and structure-only references. *@
<span class="badge evidence tier-@Evidence.Tier.Replace('_', '-')" data-evidence-tier="@Evidence.Tier" title="@Tooltip">@Label(Evidence.Tier)</span>
@code {
    [Parameter, EditorRequired] public EntityEvidence Evidence { get; set; } = null!;
    [Parameter] public IReadOnlyDictionary<string, string>? Tiers { get; set; }
    public static string Label(string tier) => tier switch
    {
        "gameplay_proven" => "In-game tested",
        "gameplay_proven_combined" => "In-game (combined edit)",
        "schema_proven" => "Schema-proven",
        "live_write_verified" => "Live write confirmed",
        "structural_reference" => "Structure only",
        // Magazine attachment tiers (0.23.1): the native owner is proven; the gameplay effect of an edit is not.
        "native_owner" => "Native owner · effect unproven",
        "native_owner_effect_consistent" => "Native owner · effects match catalog",
        "native_owner_value_consistent" => "Native owner · value matches catalog",
        // Booster tiers (0.24.0): the native link is proven; no booster edit is gameplay-tested yet.
        "structural_chain_exact_fingerprint" => "Structural chain · exact match · effect unproven",
        "unique_exact_multi_value_fingerprint" => "Unique value fingerprint · effect unproven",
        _ => tier.Replace('_', ' '),
    };
    private string Tooltip => string.Join("\n", new[] { Tiers?.GetValueOrDefault(Evidence.Tier), Evidence.ReferenceMod == null ? null : "Reference mod: " + Evidence.ReferenceMod,
        Evidence.ProvenOn is { Length: > 0 } on ? "Proven on: " + string.Join(", ", on) : null, Evidence.Proof,
        Evidence.NativeOwner == null ? null : "Native owner: " + Evidence.NativeOwner, Evidence.GameplayWriteEffect == null ? null : "Gameplay effect of a write: " + Evidence.GameplayWriteEffect }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

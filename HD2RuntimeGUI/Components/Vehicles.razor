@inject BuilderWorkspace Workspace
@{ var sdk = Workspace.Metadata ?? Workspace.SdkStatus?.Installed; var entities = sdk?.Entities; }
<div class="page-heading"><div><div class="eyebrow">GUARDED AUTHORING · SDK @sdk?.Version</div><h1>Vehicles</h1><p>Durability, native damage zones and weapon mounts from <code>hd2.vehicle</code>. Linked call-in cooldowns are edited here too.</p></div></div>
@if (Workspace.BuildError is { } issue && Workspace.Project != null) { <div class="notice warning" role="alert">Build requires review: @issue</div> }
@if (entities == null) { <section class="panel" data-entity-unavailable><h2>Vehicle authoring requires SDK 0.23.0</h2><p>This project is bound to SDK @sdk?.Version. Rebind it from Overview to use the published vehicle capabilities.</p></section> }
else
{
    var vehicles = entities.Vehicles.Vehicles.Where(v => v.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToArray();
    <div class="weapon-editor"><section class="panel weapon-browser"><h2>@vehicles.Length vehicles</h2>
        <label>Search<input id="vehicle-search" @bind="Search" @bind:event="oninput" placeholder="Vehicle name" /></label>
        <div class="weapon-list">
        @foreach (var group in vehicles.GroupBy(v => v.CallInStratagem.Known).OrderByDescending(g => g.Key))
        {
            <div class="section-label">@(group.Key ? "STRATAGEM VEHICLES" : "NATIVE-ONLY VEHICLES")</div>
            @foreach (var v in group)
            { <button class="resource-item cat-support @(Selected == v.Name ? "active" : "")" data-vehicle-item="@v.Name" @onclick="() => Selected = v.Name"><strong>@v.Name</strong><small>@(v.VehicleClass ?? "Native") · @v.Durability.Zones.Length zones · @v.Mounts.Count(m => m.Swappable) swappable mount@(v.Mounts.Count(m => m.Swappable) == 1 ? "" : "s")@(Modified(v.Name) ? " · modified" : "")</small></button> }
        }
        </div>
    </section><div class="weapon-detail">
        @if (entities.Vehicles.Find(Selected) != null) { <VehicleEditor Name="@Selected" Changed="Refresh" @key="Selected" /> }
        else { <section class="panel"><h2>Choose a vehicle</h2><p>@entities.Vehicles.Summary.Vehicles vehicles · @entities.Vehicles.Summary.PopulatedZones native damage zones · @entities.Vehicles.Summary.SwappableMountSlots swappable mount slots · @entities.Vehicles.Summary.DiscoveredMountedWeapons discovered mounted weapons</p></section> }
    </div></div>
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private string Search = "", Selected = "";
    private bool Modified(string name) => Workspace.Project?.EntityChanges.Any(c => c.Resource == "vehicle" && c.Entity == name) == true;
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
}

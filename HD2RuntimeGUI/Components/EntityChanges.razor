@inject BuilderWorkspace Workspace
@{
    var entities = Workspace.Metadata?.Entities; var project = Workspace.Project;
    // One logical entry per vehicle/backpack: its own edits plus edits to its linked call-in stratagem.
    // Mounted vehicle weapon edits (0.26.0) belong to their vehicle's entry; drop-pod racks are their own entry.
    var keys = project == null ? [] : project.EntityChanges.Select(Group)
        .Concat(entities == null ? [] : project.StratagemChanges.Where(c => entities.CallIns.ContainsKey(c.Stratagem)).Select(c => entities.CallIns[c.Stratagem]))
        .Distinct().OrderBy(k => k.Resource).ThenBy(k => k.Item2, StringComparer.Ordinal).ToArray();
}
@if (project != null && keys.Length > 0)
{
    <div class="panel-heading"><h2>@T["EntityChanges.Title"]</h2>@if (project.EntityChanges.Count > 0) { <button class="reset-action" @onclick="() => Run(() => Workspace.ResetEntityAsync())">@T["EntityChanges.ResetAll"]</button> }</div>
    @foreach (var (resource, entity) in keys)
    {
        var own = project.EntityChanges.Where(c => Group(c) == (resource, entity)).ToArray();
        var callIn = entities?.CallInFor(resource, entity); var callInChanges = callIn == null ? 0 : project.StratagemChanges.Count(c => c.Stratagem == callIn);
        var key = resource + ":" + entity;
        @* The editor is built only while its group is open. *@
        <LazyDetails class="panel" data-entity-change-group="@key" @key="key"><Summary><span class="category-pill static @(resource == "booster" ? StratagemCategories.BoosterCssClass : resource == "throwable" ? StratagemCategories.ThrowableCssClass : resource == "enemy" ? StratagemCategories.EnemyCssClass : resource == "structure" ? StratagemCategories.StructureCssClass : "cat-support")"><span class="cat-dot" aria-hidden="true"></span>@KindLabel(resource)</span><strong>@Title(resource, entity)</strong>
            <span class="badge">@T.Plural("EntityChanges.Count", own.Length + callInChanges)</span>
            <small class="subtle">@string.Join(" · ", new[] { callInChanges > 0 ? T["EntityChanges.Part.CallIn"] : null, own.Any(c => c.Path is "entity" or "backpack") ? (resource == "vehicle" ? T["EntityChanges.Part.Durability"] : T["EntityChanges.Part.Settings"]) : null,
                own.Any(c => c.Path == "damage_zone") ? T.Plural("EntityChanges.Part.ZoneFields", own.Count(c => c.Path == "damage_zone")) : null, own.Any(c => c.Path == "mount") ? T["EntityChanges.Part.Mounts"] : null, own.Any(c => c.Resource == "vehicle_weapon" && c.Linked == null) ? T["EntityChanges.Part.MountedWeapons"] : null, own.Any(c => c.Resource == "backpack" && c.Linked != null) ? T["EntityChanges.Part.LinkedEntity"] : null, own.Any(c => c.Resource == "vehicle_weapon" && c.Linked != null) ? T["EntityChanges.Part.DroneWeapon"] : null, own.Any(c => c.Resource == "pod_rack") ? T["EntityChanges.Part.Contents"] : null, own.Any(c => c.Path == "magazine") ? T["EntityChanges.Part.MagazineValues"] : null, own.Any(c => c.Path == "deployed_entity") ? T["EntityChanges.Part.DeployedEntity"] : null, own.Any(c => c.Path == "status_effect") ? T["EntityChanges.Part.StatusEffect"] : null, own.Any(c => c.Path == "attack" && EntityChangeService.IsEnemy(c.Resource)) ? T.Plural("EntityChanges.Part.AttackRows", own.Where(c => c.Path == "attack").Select(c => c.Attack).Distinct().Count()) : null }.Where(s => s != null))</small></Summary>
            <ChildContent>
            <label><input type="checkbox" checked="@ShowAll.Contains(key)" @onchange="e => Toggle(key, (bool)e.Value!)" /> @T["EntityChanges.ShowAllFields"]</label>
            @if (resource == "vehicle") { <VehicleEditor Name="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            else if (resource == "backpack") { <BackpackEditor Name="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            else if (resource == "booster") { <BoosterEditor Name="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            else if (resource == "throwable") { <ThrowableEditor Name="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            else if (EntityChangeService.IsEnemy(resource)) { <EnemyEditor SemanticId="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            else if (resource == "pod_rack") { <PodPayloadEditor Rack="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            else { <MagazineAttachmentCard Attachment="@entity" ModifiedOnly="@(!ShowAll.Contains(key))" Changed="Refresh" /> }
            @foreach (var c in own.Where(c => entities?.Field(c.InstanceKey) == null))
            { <p class="notice warning">@T.Format("EntityChanges.MissingCapability", c.SemanticFieldId, c.Zone ?? c.Mount ?? c.Path)</p><button @onclick="() => Run(() => Workspace.ResetEntityAsync(instance: c.InstanceKey))">@T["EntityChanges.RemoveMissing"]</button> }
            </ChildContent>
        </LazyDetails>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private readonly HashSet<string> ShowAll = []; private string? Error;
    // Attachment definitions are named by their native name and the weapons whose default magazine they are.
    private string Title(string resource, string entity) => EntityChangeService.IsEnemy(resource) ? Workspace.Metadata?.Entities?.Enemies?.Name(entity) ?? entity
        : resource != "weapon_attachment" ? entity
        : Workspace.Metadata?.Entities?.Attachments?.Attachment(entity) is { } a ? a.Name + (a.Consumers.NativeDefaultOf.Length > 0 ? " (" + string.Join(", ", a.Consumers.NativeDefaultOf) + ")" : "") : entity;
    // Resource ids are the project's; each gets ModBuilder's category name (anything else is a magazine attachment).
    private string KindLabel(string resource) => resource switch
    {
        "vehicle" => T["EntityChanges.Kind.Vehicle"], "backpack" => T["EntityChanges.Kind.Backpack"], "booster" => T["EntityChanges.Kind.Booster"], "throwable" => T["EntityChanges.Kind.Throwable"],
        "pod_rack" => T["EntityChanges.Kind.DropPod"], "enemy" => T["EntityChanges.Kind.Enemy"], "structure" => T["EntityChanges.Kind.Structure"], _ => T["EntityChanges.Kind.MagazineAttachment"],
    };
    // A Guard Dog drone weapon (0.28.0, Linked "drone") belongs to its backpack's entry, where the drone is edited.
    private static (string Resource, string Entity) Group(EntityChange c) => c.Resource == "vehicle_weapon"
        ? (c.Linked == BackpackLinkedEntity.Drone ? "backpack" : "vehicle", VehicleWeaponReader.Split(c.Entity).Vehicle) : (c.Resource, c.Entity);
    private void Toggle(string key, bool value) { if (value) ShowAll.Add(key); else ShowAll.Remove(key); }
    private async Task Refresh() { StateHasChanged(); await Changed.InvokeAsync(); }
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Refresh(); } catch (Exception e) { Error = e.Message; } }
}

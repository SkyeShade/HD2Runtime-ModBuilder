@implements IAsyncDisposable
@inject BuilderWorkspace Workspace
@inject IJSRuntime JS
@* Hand-written HD2Runtime Lua (src/addon.lua, format 11). The text is the user's: ModBuilder saves it only on Save, reloads it only on Reload,
   and never overwrites a working copy changed in an external editor without an explicit choice. The page watches the working copy while it
   is open, checks syntax and SDK-enumerated names as you type, and offers the event API reference, action pickers and snippets. *@
@{ var project = Workspace.Project; var lua = project?.CustomLua; var sdk = Workspace.Metadata; }
<div class="page-heading"><div><div class="eyebrow">@T.Format(Workspace.SdkStatus?.LocalSource != null ? "CustomLua.EyebrowLocal" : "CustomLua.Eyebrow", sdk?.Version)</div><h1>@T["CustomLua.Title"]</h1>
    <p>@T.Markup("CustomLua.Intro.Html", CustomLuaSettings.RelativePath)</p></div></div>
@if (project == null) { }
else if (lua == null)
{
    <section class="panel" data-custom-lua-empty><h2>@T["CustomLua.Add.Title"]</h2>
        <p>@T.Markup("CustomLua.Add.Help.Html", "hd2.events.on", "hd2.after", "hd2.every", "hd2.input.bind")</p>
        @if (sdk?.Events == null) { <p class="notice warning">@T.Format("CustomLua.NoCatalog", sdk?.Version)</p> }
        <button class="primary" data-custom-lua-add @onclick="() => Run(Workspace.AddCustomLuaAsync)">@T.Format("CustomLua.Add.Button", CustomLuaSettings.RelativePath)</button>
    </section>
}
else
{
    <div class="custom-lua" data-custom-lua>
        <section class="panel custom-lua-main">
            <div class="custom-lua-toolbar">
                <div class="custom-lua-file"><strong>@CustomLuaSettings.RelativePath</strong>
                    <span class="badge @(Dirty ? "amber" : "green")" data-custom-lua-state>@(Dirty ? T["CustomLua.State.Unsaved"] : T["CustomLua.State.Saved"])</span>
                    @if (!lua.Enabled) { <span class="badge" data-custom-lua-disabled>@T["CustomLua.NotInBuild"]</span> }
                    <small class="subtle" title="@Workspace.CustomLuaPath">@Workspace.CustomLuaPath</small></div>
                <div class="actions">
                    <button class="primary" data-custom-lua-save disabled="@(!Dirty || Busy)" @onclick="() => Save(false)" title="Ctrl+S">@T["Common.Save"]</button>
                    <button data-custom-lua-reload disabled="@Busy" @onclick="Reload">@T["CustomLua.Reload"]</button>
                    <button data-custom-lua-open @onclick="() => Run(Workspace.OpenCustomLuaExternallyAsync)" title="@T["CustomLua.OpenEditor.Tooltip"]">@T["CustomLua.OpenEditor.Button"]</button>
                    <button data-custom-lua-folder @onclick="() => Run(Workspace.OpenCustomLuaFolderAsync)">@T["CustomLua.OpenFolder"]</button>
                    <button data-custom-lua-copy @onclick="CopyPath">@(Copied ? T["Common.Copied"] : T["CustomLua.CopyPath"])</button>
                    <label class="switch-label" title="@T["CustomLua.Include.Tooltip"]"><input type="checkbox" data-custom-lua-enabled checked="@lua.Enabled" @onchange="e => Run(() => Workspace.SetCustomLuaEnabledAsync((bool)e.Value!))" /> @T["CustomLua.Include.Label"]</label>
                </div>
            </div>
            @if (Conflict != null)
            {
                <div class="notice warning custom-lua-conflict" role="alert" data-custom-lua-conflict>
                    <span><strong>@T.Format(Dirty ? "CustomLua.Conflict.TitleDirty" : "CustomLua.Conflict.Title", CustomLuaSettings.RelativePath)</strong>
                        @(Dirty ? T["CustomLua.Conflict.HelpDirty"] : T["CustomLua.Conflict.Help"])</span>
                    <span class="actions">
                        <button class="primary" data-custom-lua-take-disk @onclick="Reload">@(Dirty ? T["CustomLua.Conflict.ReloadDiscard"] : T["CustomLua.Reload"])</button>
                        <button data-custom-lua-overwrite @onclick="() => Save(true)">@(Dirty ? T["CustomLua.Conflict.Overwrite"] : T["CustomLua.Conflict.Keep"])</button>
                    </span>
                    <small class="subtle">@T.Format("CustomLua.Conflict.Lines", Lines(Conflict), Lines(Draft))</small>
                </div>
            }
            <div class="lua-editor" @ref="EditorHost" data-lua-editor data-editor-label="@(T.Format("CustomLua.Editor.Label", CustomLuaSettings.RelativePath))"></div>
            <div class="custom-lua-diagnostics" data-custom-lua-diagnostics>
                @if (Diagnostics.Count == 0) { <p class="subtle" data-custom-lua-clean>@(sdk?.Events != null ? T["CustomLua.CleanWithNames"] : T["CustomLua.Clean"])</p> }
                @foreach (var d in Diagnostics)
                {
                    <button class="lua-diagnostic @d.Severity" data-lua-diagnostic="@d.Severity" @onclick="() => Goto(d)"><span class="badge @(d.Severity == LuaDiagnostic.Error ? "red" : "amber")">@(d.Severity == LuaDiagnostic.Error ? T["CustomLua.Diagnostic.Error"] : T["CustomLua.Diagnostic.Warning"])</span>
                        <code>@d.Line:@d.Column</code> @d.Message</button>
                }
                <p class="subtle">@T["CustomLua.Checked"]</p>
            </div>
            @if (Error != null) { <p class="notice warning" role="alert">@Error</p> }
        </section>
        <aside class="panel custom-lua-side">
            <div class="custom-lua-tabs" role="tablist">
                @foreach (var (key, label) in new[] { ("snippets", T["CustomLua.Tab.Snippets"]), ("reference", T["CustomLua.Tab.Reference"]), ("actions", T["CustomLua.Tab.Actions"]) })
                { <button role="tab" class="@(Tab == key ? "active" : "")" aria-selected="@(Tab == key)" data-custom-lua-tab="@key" @onclick="() => Tab = key">@label</button> }
            </div>
            @if (sdk?.Events == null) { <p class="notice warning">@T.Format("CustomLua.NoCatalogSide", "sdk/EventCatalog.json")</p> }
            else if (Tab == "snippets")
            {
                @foreach (var s in LuaSnippets.For(sdk, project.ResourceId))
                {
                    <div class="snippet" data-snippet="@s.Id"><div class="snippet-head"><strong>@s.Title</strong><button class="small" data-snippet-insert="@s.Id" @onclick="() => Insert(s.Code)">@T["Common.Insert"]</button></div>
                        <p class="subtle">@s.Description</p><small class="subtle">@string.Join(" · ", s.Uses)</small></div>
                }
            }
            else if (Tab == "reference") { <EventReference /> }
            else { <EventActionPicker Insert="Insert" /> }
        </aside>
    </div>
}
@code {
    [Parameter] public EventCallback Changed { get; set; }
    private ElementReference EditorHost; private DotNetObjectReference<CustomLuaPage>? Self;
    private string Draft = "", Saved = ""; private string? Conflict, Error; private bool Busy, Copied, Mounted; private string Tab = "snippets";
    private IReadOnlyList<LuaDiagnostic> Diagnostics = [];
    private Guid? ProjectId; private System.Threading.Timer? Watch;
    // The UI language the mounted editor's label and diagnostics were last produced in.
    private string? EditorLanguage;
    private bool Dirty => Draft != Saved;
    protected override void OnParametersSet()
    {
        if (Workspace.Project?.Id != ProjectId) { ProjectId = Workspace.Project?.Id; Mounted = false; Conflict = null; }
        Load();
        // Diagnostic messages are UI text: after a language change the draft is checked again so they show in the new language.
        if (Mounted && UiLanguage != EditorLanguage) Diagnostics = Workspace.CustomLuaDiagnostics(Draft);
    }
    // The editor text of this project: its unsaved draft if the user left the page with one, otherwise the saved text. Loaded before the
    // editor mounts, including right after "Add src/addon.lua" (which renders without new parameters).
    private void Load()
    {
        if (Workspace.Project?.CustomLua is { } lua && !Mounted) { Saved = lua.Source; Draft = Workspace.CustomLuaDraft ?? lua.Source; Diagnostics = Workspace.CustomLuaDiagnostics(Draft); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The editor reads its textarea label at mount (data-editor-label); a language change relabels it and the gutter's diagnostics.
        if (Mounted && UiLanguage != EditorLanguage)
        {
            EditorLanguage = UiLanguage;
            await JS.InvokeVoidAsync("hd2LuaEditor.setLabel", EditorHost, T.Format("CustomLua.Editor.Label", CustomLuaSettings.RelativePath));
            await Markers();
        }
        if (Workspace.Project?.CustomLua == null || Mounted) return;
        Load(); Mounted = true; EditorLanguage = UiLanguage; Self ??= DotNetObjectReference.Create(this);
        StateHasChanged();
        await JS.InvokeVoidAsync("hd2LuaEditor.mount", EditorHost, Self, Draft, LuaCompletion.Build(Workspace.Metadata));
        await Markers();
        Watch ??= new System.Threading.Timer(_ => InvokeAsync(CheckDisk), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
    }
    [JSInvokable] public async Task OnEditorInput(string text)
    {
        Draft = text; Workspace.CustomLuaDraft = Dirty ? text : null; Diagnostics = Workspace.CustomLuaDiagnostics(text);
        await Markers(); StateHasChanged();
    }
    [JSInvokable] public async Task OnEditorSave(string text) { Draft = text; await Save(false); StateHasChanged(); }
    private Task Markers() => Mounted ? JS.InvokeVoidAsync("hd2LuaEditor.setDiagnostics", EditorHost, Diagnostics.Select(d => new { line = d.Line, severity = d.Severity, message = d.Message })).AsTask() : Task.CompletedTask;
    // The working copy is compared with the saved text every two seconds while this page is open.
    private async Task CheckDisk()
    {
        try
        {
            var disk = Workspace.CustomLuaDisk();
            var conflict = disk is { Exists: true, InSync: false } ? disk.Text : null;
            if (conflict != Conflict) { Conflict = conflict; StateHasChanged(); }
        }
        catch (IOException) { }
        await Task.CompletedTask;
    }
    private async Task Save(bool overwrite)
    {
        await Run(async () =>
        {
            try { await Workspace.SaveCustomLuaAsync(Draft, overwrite); Saved = Draft; Workspace.CustomLuaDraft = null; Conflict = null; }
            catch (CustomLuaConflictException e) { Conflict = e.DiskText; throw new InvalidOperationException(e.Message); }
        });
    }
    private async Task Reload()
    {
        await Run(async () =>
        {
            await Workspace.ReloadCustomLuaAsync();
            Saved = Draft = Workspace.Project!.CustomLua!.Source; Workspace.CustomLuaDraft = null; Conflict = null;
            Diagnostics = Workspace.CustomLuaDiagnostics(Draft);
            await JS.InvokeVoidAsync("hd2LuaEditor.setText", EditorHost, Draft); await Markers();
        });
    }
    private async Task Insert(string code) => await JS.InvokeVoidAsync("hd2LuaEditor.insert", EditorHost, code);
    private async Task Goto(LuaDiagnostic d) => await JS.InvokeVoidAsync("hd2LuaEditor.goto", EditorHost, d.Line, d.Column);
    private async Task CopyPath()
    {
        await Run(async () => { await JS.InvokeVoidAsync("hd2LuaEditor.copy", Workspace.CustomLuaPath); Copied = true; });
    }
    private static int Lines(string? text) => text == null ? 0 : text.Split('\n').Length;
    private async Task Run(Func<Task> action)
    {
        Busy = true; Error = null;
        try { await action(); await Changed.InvokeAsync(); }
        catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException or JSException) { Error = e.Message; }
        finally { Busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        Watch?.Dispose();
        try { if (Mounted) await JS.InvokeVoidAsync("hd2LuaEditor.dispose", EditorHost); } catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
        Self?.Dispose();
    }
}

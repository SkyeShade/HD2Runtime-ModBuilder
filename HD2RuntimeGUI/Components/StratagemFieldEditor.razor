@inject BuilderWorkspace Workspace
@* One published stratagem scalar as a compact row: name, value, baseline and safety badges; provenance on demand. *@
@{ var saved = Saved; }
<div class="field-row @(saved != null ? "modified" : "") @(Field.Editable ? "" : "readonly")" data-stratagem-field="@Field.InstanceKey" data-semantic-field="@Field.SemanticFieldId">
    <div class="field-name"><span>@(Label ?? Field.DisplayName)</span>@if (Unit.Length > 0) { <small class="field-unit">@Unit</small> }
        @if (Field.Type == StratagemUses.Type && Field.Editable && Field.Caveat != null) { <span class="uses-caveat" tabindex="0" title="@Field.Caveat" aria-label="@Field.Caveat" data-uses-caveat>ⓘ</span> }
        <span class="field-flags">
            @if (Field.Shared) { <span class="badge amber" data-flag="allow_shared" title="@T["StratagemField.Shared.Tooltip"]">@T.Format("StratagemField.Shared.Badge", Field.SharedConsumers.Length)</span> }
            @if (saved != null) { <span class="badge modified-badge">@T["Common.Modified"]</span> }
            @if (saved != null && Field.Type == StratagemUses.Type && !StratagemChangeService.EffectRequired(Field, saved.DesiredValue)) { <span class="badge green" data-gameplay-proven>@T["StratagemField.GameplayProven"]</span> }
        </span></div>
    <div class="field-value">
        @if (!Field.Editable) { <span class="badge" title="@Field.Reason">@T["Common.ReadOnly"]</span> }
        else if (Field.Type == StratagemUses.Type)
        {
            @* 0.26.0 mission uses: [Unlimited ▼] or [Limited ▼] [N]. Unlimited is Runtime's own 'unlimited' token; only the modes the
               stratagem's published transitions allow are offered, and the count is editable only where Runtime allows that change. *@
            var uses = StratagemUses.Control(Field, saved?.DesiredValue ?? Field.CurrentDefault);
            <div class="mission-uses" data-mission-uses="@Field.Target.Stratagem" data-uses-mode="@(uses.Unlimited ? "unlimited" : "limited")">
                <select data-uses-select aria-label="@T["StratagemField.Uses.Mode"]" disabled="@(Workspace.Project == null || !uses.CanUnlimited || !uses.CanLimited)"
                    title="@(uses.CanUnlimited && uses.CanLimited ? null : T["StratagemField.Uses.NoOtherMode"])"
                    @onchange='e => Commit(e.Value?.ToString() == "unlimited" ? "\"unlimited\"" : uses.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))'>
                    @if (uses.CanUnlimited) { <option value="unlimited" selected="@uses.Unlimited">@T["StratagemField.Uses.Unlimited"]</option> }
                    @if (uses.CanLimited) { <option value="limited" selected="@(!uses.Unlimited)">@T["StratagemField.Uses.Limited"]</option> }
                </select>
                @if (!uses.Unlimited)
                {
                    <input type="number" step="1" min="@(Field.Min ?? 1)" max="@(Field.Max ?? 100)" value="@uses.Count" disabled="@(Workspace.Project == null || !uses.CountEditable)"
                        data-uses-count aria-label="@T["StratagemField.Uses.Count"]" @onchange="e => Commit(e.Value?.ToString() ?? string.Empty)" />
                }
            </div>
        }
        else if (Field.Type == "boolean") { <input type="checkbox" checked="@(Value == "true")" disabled="@(Workspace.Project == null)" @onchange='e => Commit((bool)e.Value! ? "true" : "false")' aria-label="@(Label ?? Field.DisplayName)" /> }
        else { <input type="number" step="@(Field.Type == "integer" ? "1" : "any")" value="@Value" disabled="@(Workspace.Project == null)" @onchange="e => Commit(e.Value?.ToString() ?? string.Empty)" aria-label="@(Label ?? Field.DisplayName)" /> }
    </div>
    @if (saved != null) { <div class="field-baseline modified-value" data-baseline="@Format(saved.ExpectedValue)" data-desired="@Format(saved.DesiredValue)">@T.Markup("StratagemField.BaseToDesired.Html", Format(saved.ExpectedValue), Format(saved.DesiredValue))</div> }
    else { <div class="field-baseline subtle" data-baseline="@Format(Field.CurrentDefault)">@T.Format("StratagemField.Base", Format(Field.CurrentDefault))</div> }
    <div class="field-tools">
        @if (saved != null) { <OptionToggle Key="@ModOptionsService.StratagemKey(Field.InstanceKey)" Changed="Changed" /> }
        @if (saved != null)
        {
            <label class="field-toggle" title="@T["StratagemField.Include.Tooltip"]"><input type="checkbox" checked="@saved.Enabled" @onchange="() => Run(() => Workspace.ToggleStratagemAsync(saved.InstanceKey))" /> @T["Common.On"]</label>
            <button class="reset-action small" @onclick="() => Run(() => Workspace.ResetStratagemAsync(instance: Field.InstanceKey))">@T["StratagemField.Reset"]</button>
        }
        <details class="field-info"><summary title="@T["StratagemField.Info.Tooltip"]">ⓘ</summary><div class="field-info-body">
            @if (!Field.Editable) { <p><strong>@T["StratagemField.NotWritable"]</strong> @Field.Reason</p> }
            @if (Field.Caveat != null) { <p>@Field.Caveat</p> }
            <p>@Field.Provenance</p><p>@Field.BackingObjectKind · @(Field.Target.Attack ?? Field.Target.Weapon ?? Field.Target.Entity ?? Field.Target.Path)</p><code>@Field.SemanticFieldId</code></div></details>
    </div>
    @if (Field.Type == StratagemUses.Type && Field.Editable && saved != null && StratagemChangeService.EffectRequired(Field, saved.DesiredValue))
    {
        <div class="field-wide"><AckPanel Title="@T["StratagemField.Uses.Unverified"]" Kind="unverified"
            Description="@Field.AcknowledgementReason" /></div>
    }
    @if (saved != null && Workspace.StratagemIssue(saved) is { } issue)
    {
        <div class="field-wide"><p class="notice warning">@issue</p>
            @if (Field.Editable && NeedsReview(saved)) { <button @onclick="() => Run(() => Workspace.SetStratagemAsync(Field.InstanceKey, Value, true))">@T["StratagemField.AcceptBaseline"]</button> }</div>
    }
    @if (Error != null) { <p class="field-wide notice warning" role="alert">@Error</p> }
</div>
@code {
    [Parameter, EditorRequired] public StratagemField Field { get; set; } = null!;
    [Parameter] public string? Label { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private StratagemChange? Saved => StratagemChangeService.Saved(Workspace.Project, (Workspace.Metadata ?? Workspace.SdkStatus!.Installed)!.Stratagems!, Field);
    private string Unit => Field.Unit?.Replace('_', ' ') ?? "";
    // A JSON literal for SetStratagemAsync: mission uses keep the quoted "unlimited" token; other scalars display as their JSON text.
    private string Value => Field.Type == StratagemUses.Type ? (Saved?.DesiredValue ?? Field.CurrentDefault).GetRawText() : Format(Saved?.DesiredValue ?? Field.CurrentDefault);
    private string Format(System.Text.Json.JsonElement v) { try { return StratagemScalar.Display(Field, v); } catch (InvalidDataException) { return v.GetRawText(); } }
    private bool NeedsReview(StratagemChange c)
    {
        var handle = (Workspace.Metadata ?? Workspace.SdkStatus!.Installed)!.Stratagems!.Resolve(c) ?? Field;
        return c.InstanceKey != handle.InstanceKey || c.CapabilityEvidence != StratagemChangeService.Evidence(handle) || !StratagemScalar.Equal(Field, c.ExpectedValue, Field.CurrentDefault);
    }
    private Task Commit(string value) => Run(() => Workspace.SetStratagemAsync(Field.InstanceKey, value));
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

@inject BuilderWorkspace Workspace
@* One published stratagem scalar as a compact row: name, value, baseline and safety badges; provenance on demand. *@
@{ var saved = Saved; }
<div class="field-row @(saved != null ? "modified" : "") @(Field.Editable ? "" : "readonly")" data-stratagem-field="@Field.InstanceKey" data-semantic-field="@Field.SemanticFieldId">
    <div class="field-name"><span>@(Label ?? Field.DisplayName)</span>@if (Unit.Length > 0) { <small class="field-unit">@Unit</small> }
        <span class="field-flags">
            @if (Field.Shared) { <span class="badge amber" data-flag="allow_shared" title="Shared object: requires acknowledgement of every reviewed consumer">Shared · @Field.SharedConsumers.Length</span> }
            @if (saved != null) { <span class="badge modified-badge">Modified</span> }
        </span></div>
    <div class="field-value">
        @if (!Field.Editable) { <span class="badge" title="@Field.Reason">Read-only</span> }
        else if (Field.Type == "boolean") { <input type="checkbox" checked="@(Value == "true")" disabled="@(Workspace.Project == null)" @onchange='e => Commit((bool)e.Value! ? "true" : "false")' aria-label="@(Label ?? Field.DisplayName)" /> }
        else { <input type="number" step="@(Field.Type == "integer" ? "1" : "any")" value="@Value" disabled="@(Workspace.Project == null)" @onchange="e => Commit(e.Value?.ToString() ?? string.Empty)" aria-label="@(Label ?? Field.DisplayName)" /> }
    </div>
    @if (saved != null) { <div class="field-baseline modified-value" data-baseline="@Format(saved.ExpectedValue)" data-desired="@Format(saved.DesiredValue)">Base @Format(saved.ExpectedValue) → <strong>@Format(saved.DesiredValue)</strong></div> }
    else { <div class="field-baseline subtle" data-baseline="@Format(Field.CurrentDefault)">Base @Format(Field.CurrentDefault)</div> }
    <div class="field-tools">
        @if (saved != null) { <OptionToggle Key="@ModOptionsService.StratagemKey(Field.InstanceKey)" Changed="Changed" /> }
        @if (saved != null)
        {
            <label class="field-toggle" title="Include this change in the build"><input type="checkbox" checked="@saved.Enabled" @onchange="() => Run(() => Workspace.ToggleStratagemAsync(saved.InstanceKey))" /> On</label>
            <button class="reset-action small" @onclick="() => Run(() => Workspace.ResetStratagemAsync(instance: Field.InstanceKey))">Reset field</button>
        }
        <details class="field-info"><summary title="Why? / provenance">ⓘ</summary><div class="field-info-body">
            @if (!Field.Editable) { <p><strong>Not writable:</strong> @Field.Reason</p> }
            <p>@Field.Provenance</p><p>@Field.BackingObjectKind · @(Field.Target.Attack ?? Field.Target.Weapon ?? Field.Target.Entity ?? Field.Target.Path)</p><code>@Field.SemanticFieldId</code></div></details>
    </div>
    @if (saved != null && Workspace.StratagemIssue(saved) is { } issue)
    {
        <div class="field-wide"><p class="notice warning">@issue</p>
            @if (Field.Editable && NeedsReview(saved)) { <button @onclick="() => Run(() => Workspace.SetStratagemAsync(Field.InstanceKey, Value, true))">Accept current capability / baseline</button> }</div>
    }
    @if (Error != null) { <p class="field-wide notice warning" role="alert">@Error</p> }
</div>
@code {
    [Parameter, EditorRequired] public StratagemField Field { get; set; } = null!;
    [Parameter] public string? Label { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string? Error;
    private StratagemChange? Saved => StratagemChangeService.Saved(Workspace.Project, (Workspace.Metadata ?? Workspace.SdkStatus!.Installed)!.Stratagems!, Field);
    private string Unit => Field.Unit?.Replace('_', ' ') ?? "";
    private string Value => Format(Saved?.DesiredValue ?? Field.CurrentDefault);
    private string Format(System.Text.Json.JsonElement v) { try { return StratagemScalar.Text(Field, v); } catch (InvalidDataException) { return v.GetRawText(); } }
    private bool NeedsReview(StratagemChange c)
    {
        var handle = (Workspace.Metadata ?? Workspace.SdkStatus!.Installed)!.Stratagems!.Resolve(c) ?? Field;
        return c.InstanceKey != handle.InstanceKey || c.CapabilityEvidence != StratagemChangeService.Evidence(handle) || !StratagemScalar.Equal(Field, c.ExpectedValue, Field.CurrentDefault);
    }
    private Task Commit(string value) => Run(() => Workspace.SetStratagemAsync(Field.InstanceKey, value));
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) when (e is InvalidDataException or InvalidOperationException or IOException) { Error = e.Message; } }
}

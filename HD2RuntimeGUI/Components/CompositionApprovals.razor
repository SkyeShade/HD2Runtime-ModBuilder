@inject BuilderWorkspace Workspace
@using HD2RuntimeGUI.Core.Generation
@* One warning per shared projectile / damage / explosion definition edited for this weapon (allow_shared is always emitted). *@
@if (Workspace.Metadata?.Plans != null)
{
    @foreach (var scope in Scopes())
    {
        var change = scope.First();
        var field = Field(change);
        if (field == null || !field.AffectsMultipleWeapons || Domains != null && !Domains.Contains(field.Domain)) { continue; }
        var label = field.Domain switch { "damage" => T["Composition.Shared.ProjectileDamage"], "terminal" => T["Composition.Shared.TerminalActions"], "explosion" => field.SemanticFieldId.Contains(".damage.") ? T["Composition.Shared.ExplosionDamage"] : T["Composition.Shared.ExplosionSettings"], _ => T["Composition.Shared.ProjectileDefinition"] };
        <AckPanel Title="@label" Kind="shared"
            Description="@(T.Plural(field.DynamicConsumersPossible == true ? "Composition.Shared.DescriptionDynamic" : "Composition.Shared.Description", scope.Count()))"
            Items="@field.SharedWithWeapons.Append(change.Target.Weapon).Append(Weapon).Distinct().ToArray()" ItemsLabel="@T["Composition.AffectedWeapons"]"
            PanelAttributes="@(new() { ["data-shared-scope"] = field.Backing?.Settings ?? "", ["data-scope-domain"] = field.Domain })">
            @if (field.SharedWithResources is { Count: > 0 } resources)
            { <details class="subtle"><summary>@T.Plural("Composition.ResourceConsumers", resources.Count)</summary><p>@string.Join(", ", resources)</p><p>@T.Format("Composition.Scope", field.WriteScope)</p></details> }
        </AckPanel>
    }
}
@code {
    [Parameter] public string Weapon { get; set; } = "";
    [Parameter] public IReadOnlyList<CompositionChange> Changes { get; set; } = [];
    // Shows only the scopes whose first edit is in one of these domains, so each panel sits next to its section.
    [Parameter] public IReadOnlyCollection<string>? Domains { get; set; }
    private WeaponCapability? Field(CompositionChange c) { try { return c.Scalar == null ? CompositionChangeService.TerminalField(Workspace.Metadata!, c.Target, c.Phase!) : Workspace.Metadata!.PlayerWeapons!.Field(c.Scalar.Weapon, c.Scalar.SemanticFieldId); } catch (InvalidDataException) { return null; } }
    private IEnumerable<IGrouping<string, CompositionChange>> Scopes() => Changes.Where(c => c.Enabled && c.Weapon == Weapon)
        .GroupBy(c => { try { return CompositionChangeService.ApprovalScopeKey(Workspace.Metadata!, c); } catch (InvalidDataException) { return c.Id.ToString(); } });
}

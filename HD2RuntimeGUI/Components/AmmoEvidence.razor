@if (Catalog.Weapons.FirstOrDefault(w => w.Name == WeaponName) is { } ammo)
{
    @if (ammo.DefaultMagazineOption is { } preset)
    {
        <section class="panel ammo-evidence" data-ammo-preset>
            <div class="panel-heading"><h3>@T["Ammo.Preset.Title"]</h3><span class="badge">@T["Common.ReadOnly"]</span>@if (preset.Shared) { <span class="badge amber">@T["Ammo.Preset.Shared"]</span> }</div>
            <p><strong>@preset.Name.Trim()</strong></p>
            <p>@T["Ammo.Preset.Help"]</p>
            <p class="subtle">@preset.Reason</p>
            @if (preset.SharedWithWeapons.Count > 0) { <p>@T.Format("Ammo.Preset.AlsoUsedBy", string.Join(", ", preset.SharedWithWeapons))</p> }
            <details class="provenance"><summary>@T["Ammo.Preset.Evidence"]</summary><p>@T.Format("Ammo.Preset.Ids", preset.OptionId, preset.AddPath)</p><p>@Catalog.OwnershipFindings.DefaultCustomization</p></details>
        </section>
    }
    @foreach (var diagnostic in ammo.Diagnostics)
    { <div class="notice warning"><p>@diagnostic</p></div> }
    @foreach (var discrepancy in Catalog.Discrepancies.Where(d => d.Weapon == WeaponName))
    {
        <div class="notice warning" data-ammo-discrepancy><p>@T.Format("Ammo.Discrepancy", discrepancy.Field, discrepancy.Runtime.ToString(), discrepancy.Catalog.ToString())</p></div>
    }
}
@code {
    [Parameter, EditorRequired] public PlayerWeaponAmmoCatalog Catalog { get; set; } = default!;
    [Parameter, EditorRequired] public string WeaponName { get; set; } = "";
}

@inject BuilderWorkspace Workspace
@{ var entities = (Workspace.Metadata ?? Workspace.SdkStatus?.Installed)?.Entities; var vehicle = entities?.Vehicles.Find(Name); }
@if (entities != null && vehicle != null)
{
    var catalog = entities.Vehicles; var fields = catalog.FieldInstances.Where(f => f.Target.Vehicle == Name).ToDictionary(f => f.InstanceKey);
    bool Show(EntityField f) => !ModifiedOnly || EntityChangeService.Saved(Workspace.Project, f) != null;
    var callIn = entities.CallInFor("vehicle", Name);
    @if (!ModifiedOnly)
    {
        <section class="panel @(Embedded ? "delivered-panel" : "category-panel cat-support")" data-vehicle="@vehicle.Name">
            <div class="eyebrow">@(Embedded ? T["Vehicle.Eyebrow.Delivered"] : T["Vehicle.Eyebrow"]) · @(vehicle.VehicleClass?.ToUpperInvariant() ?? T["Vehicle.Eyebrow.Native"])</div>@if (Embedded) { <h3>@vehicle.Name</h3> } else { <h2>@vehicle.Name</h2> }
            <div class="field-badges"><span class="badge">@(vehicle.CatalogSource == "native_only" ? T["Vehicle.NativeOnly"] : T["Vehicle.StratagemVehicle"])</span>
                <span class="badge">@T.Plural("Vehicle.DamageZoneCount", vehicle.Durability.Zones.Length)</span><span class="badge">@T.Plural("Vehicle.SwappableMountCount", vehicle.Mounts.Count(m => m.Swappable))</span></div>
            @if (!vehicle.CallInStratagem.Known) { <p class="subtle" data-callin-unknown>@vehicle.CallInStratagem.Reason</p> }
            @if (Workspace.Project != null && Workspace.Project.EntityChanges.Any(c => c.Resource == "vehicle" && c.Entity == Name))
            { <button class="reset-action" @onclick='() => Run(() => Workspace.ResetEntityAsync("vehicle", Name))'>@T["Vehicle.Reset"]</button> }
        </section>
    }
    @if (callIn != null) { <CallInFields Stratagem="@callIn" ModifiedOnly="ModifiedOnly" Changed="Changed" /> }
    var main = vehicle.Durability.FieldInstanceKeys.Select(k => fields[k]).Where(Show).OrderBy(f => EntityStats.Order(f.SemanticFieldId)).ToArray();
    @if (main.Length > 0)
    {
        <section class="panel" data-vehicle-durability><h2>@T["Vehicle.Durability.Title"]</h2>
            <div class="stat-grid">@foreach (var f in main) { <EntityFieldEditor @key="f.InstanceKey" Field="f" Label="@EntityStats.Label(f.SemanticFieldId)" Tiers="catalog.EvidenceTiers" Changed="Changed" /> }</div>
        </section>
    }
    var zones = vehicle.Durability.Zones.Where(z => z.FieldInstanceKeys.Any(k => Show(fields[k]))).Where(z => ZoneFilter.Length == 0 || (z.Label + " " + z.ZoneId).Contains(ZoneFilter, StringComparison.OrdinalIgnoreCase)).ToArray();
    @if (vehicle.Durability.Zones.Length > 0 && (!ModifiedOnly || zones.Length > 0))
    {
        <details class="panel" data-vehicle-zones open="@ModifiedOnly">
            <summary><strong>@T["Vehicle.Zones.Title"]</strong> <span class="badge">@vehicle.Durability.Zones.Length</span>
                <small class="subtle">@T.Format("Vehicle.Zones.Summary", vehicle.Durability.Zones.Count(z => z.NameResolved), vehicle.Durability.UnpopulatedZoneSlots)</small></summary>
            <p class="subtle">@T["Vehicle.Zones.Help"]</p>
            @if (!ModifiedOnly) { <label>@T["Vehicle.Zones.Filter.Label"]<input data-zone-filter @bind="ZoneFilter" @bind:event="oninput" placeholder="@T["Vehicle.Zones.Filter.Placeholder"]" /></label> }
            @foreach (var zone in zones)
            {
                <details class="zone-row" data-zone="@zone.ZoneId" open="@ModifiedOnly">
                    <summary><strong>@zone.Label</strong> <small class="subtle">@(zone.ChildZones.Length > 0 ? T.Plural("Vehicle.Zone.MetaWithChildren", zone.ActorCount, zone.ZoneId, string.Join(", ", zone.ChildZones)) : T.Plural("Vehicle.Zone.Meta", zone.ActorCount, zone.ZoneId))</small>
                        @if (zone.FieldInstanceKeys.Any(k => EntityChangeService.Saved(Workspace.Project, fields[k]) != null)) { <span class="badge modified-badge">@T["Common.Modified"]</span> }</summary>
                    <div class="stat-grid">@foreach (var f in zone.FieldInstanceKeys.Select(k => fields[k]).Where(Show)) { <EntityFieldEditor @key="f.InstanceKey" Field="f" Tiers="catalog.EvidenceTiers" Changed="Changed" /> }</div>
                </details>
            }
        </details>
    }
    @* 0.26.0: mounts with a published weapon get a full weapon section (which hosts the swap selector); the older mount panel keeps
       non-weapon slots, and in the Changes view every saved swap. *@
    var weaponSlots = entities.VehicleWeapons?.Find(Name)?.Mounts.Where(m => m.Weapon != null).Select(m => m.Slot).ToHashSet() ?? [];
    <VehicleWeaponsPanel Vehicle="@Name" ModifiedOnly="ModifiedOnly" Changed="Changed" />
    var mounts = vehicle.Mounts.Where(m => ModifiedOnly
        ? catalog.FieldInstances.Any(f => f.Target.Vehicle == Name && f.Target.Mount == m.MountId && EntityChangeService.Saved(Workspace.Project, f) != null)
        : !weaponSlots.Contains(m.SlotIndex)).ToArray();
    @if (mounts.Length > 0)
    {
        <section class="panel" data-vehicle-mounts><h2>@T["Vehicle.Mounts.Title"]</h2>
            <p class="subtle">@T["Vehicle.Mounts.Help"]</p>
            <div class="stat-grid">@foreach (var m in mounts) { <MountEditor @key="m.MountId" Mount="m" Vehicle="@Name" Changed="Changed" /> }</div>
        </section>
    }
    @if (!ModifiedOnly && vehicle.BlockedFields.Length > 0)
    {
        <details class="panel" data-blocked-capabilities><summary>@T["EntityPanel.Blocked.Title"]</summary>@foreach (var b in vehicle.BlockedFields) { <p data-blocked-field="@b.Field">@T.Markup("EntityPanel.Blocked.Field.Html", b.Field, b.Reason)</p> }</details>
    }
    @if (Error != null) { <p class="notice warning">@Error</p> }
}
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public bool ModifiedOnly { get; set; }
    // Hosted under its Support stratagem entry (Stratagems → Support): the stratagem header is shown above, so this header is compact.
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string ZoneFilter = ""; private string? Error;
    private async Task Run(Func<Task> action) { try { await action(); Error = null; await Changed.InvokeAsync(); } catch (Exception e) { Error = e.Message; } }
}

@inject SnapshotWorkspace Research
@inject BuilderWorkspace Workspace
<div class="page-heading"><div><div class="eyebrow">@T["Snapshot.Eyebrow"]</div><h1>@T["Snapshot.Title"]</h1><p>@T["Snapshot.Tagline"]</p></div><button class="primary" @onclick="() => Run(Research.PickSnapshotAsync)">@T["Snapshot.Load"]</button></div>
@if (Busy) { <p role="status">@T["Snapshot.Reading"]</p> }
@if (Error != null) { <div class="notice error" role="alert">@Error</div> }
@if (Research.Status != null) { <p>@Research.Status</p> }
@if (Research.Snapshot is { } snapshot)
{
    <section class="panel"><h2>@T["Snapshot.Capture.Title"]</h2><code class="path">@snapshot.Path</code><p>@T.Format("Snapshot.Capture.Versions", snapshot.CapturedAt, snapshot.RuntimeVersion, snapshot.GameVersion)</p><p>@T.Format("Snapshot.Capture.Stats", snapshot.Regions.Count, snapshot.CapturedBytes.ToString("N0"), snapshot.Architecture.ToString("X"))</p>
        <div class="metadata-row"><span>@T["Snapshot.Capture.ExeHash"]</span><code class="path">@snapshot.Fingerprints.Exe</code></div><div class="metadata-row"><span>game.dll SHA-256</span><code class="path">@snapshot.Fingerprints.Dll</code></div>
        <span class="badge">@(snapshot.Fingerprints == Workspace.SdkStatus?.Installed.PlayerWeapons?.BuildFingerprints ? T["Snapshot.Capture.MatchesSdk"] : T["Snapshot.Capture.DifferentSdk"])</span>
    </section>
    <section class="panel"><div class="panel-heading"><h2>@T["Snapshot.Resources.Title"]</h2><button @onclick="() => Run(Research.PickReportAsync)">@T["Snapshot.Resources.Link"]</button></div><p class="subtle">@T["Snapshot.Resources.Help"]</p>
        @if (Research.Map is { } map)
        {
            <input aria-label="@T["Snapshot.Resources.Search.Aria"]" placeholder="@T["Snapshot.Resources.Search.Placeholder"]" @bind="Search" @bind:event="oninput" />
            @foreach (var resource in map.RuntimeCandidates.Where(r => r.ResourceHash.Contains(Search, StringComparison.OrdinalIgnoreCase) || r.CredibleWikiIdentities.Any(n => n.Contains(Search, StringComparison.OrdinalIgnoreCase)) || r.Ownership.Keys.Any(n => n.Contains(Search, StringComparison.OrdinalIgnoreCase))).Take(100))
            { <details class="provenance"><summary>@resource.ResourceHash · @string.Join(", ", resource.CredibleWikiIdentities)</summary><p>@T.Format("Snapshot.Resources.EntityRow", resource.EntityRow)</p>
                @foreach (var component in resource.Ownership) { <details><summary>@component.Key</summary><pre>@component.Value.ToString()</pre></details> }
                <details><summary>@T["Snapshot.Resources.ResolvedFields"]</summary>@foreach (var field in resource.ResolvedFields) { <p><strong>@field.Key</strong> <code>@field.Value.ToString()</code></p> }</details>
                <details><summary>@T["Snapshot.Resources.Attacks"]</summary>@foreach (var attack in resource.Attacks) { <pre>@attack.ToString()</pre> }</details>
            </details> }
        }
    </section>
    <section class="panel"><h2>@T["Snapshot.Raw.Title"]</h2><p>@T["Snapshot.Raw.Help"]</p><label for="snapshot-address">@T["Snapshot.Raw.Address"]</label><div class="input-action"><input id="snapshot-address" @bind="Address" /><button @onclick="() => Run(() => Research.InspectAsync(Address))">@T["Snapshot.Raw.Inspect"]</button></div>
        <details><summary>@T["Snapshot.Raw.Regions"]</summary>@foreach (var region in snapshot.Regions.Where(r => r.Status == 1 && r.Size >= 256).Take(100)) { <button @onclick="() => Region(region)">@T.Format("Snapshot.Raw.Region", region.Base.ToString("X"), region.Size)</button> }</details>
        <pre>@Research.RawText</pre>
    </section>
}
@code {
    private string Search = "", Address = "";
    private bool Busy;
    private string? Error;
    protected override async Task OnInitializedAsync() { if (Research.Snapshot == null) await Run(Research.RestoreAsync); }
    private async Task Region(SnapshotRegion region) { Address = region.Base.ToString("X"); await Run(() => Research.InspectAsync(Address)); }
    private async Task Run(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); } catch (Exception e) { Error = e.Message; } finally { Busy = false; } }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships as HD2RuntimeModBuilder.Core.dll since 1.0.1. The root namespace (and so the embedded Bundled/*.json resource
         names) stays HD2RuntimeGUI.Core. -->
    <AssemblyName>HD2RuntimeModBuilder.Core</AssemblyName>
    <RootNamespace>HD2RuntimeGUI.Core</RootNamespace>
    <!-- UI text: Resources/Strings/Strings.resx is English (neutral); each Strings.<culture>.resx builds to
         <culture>/HD2RuntimeModBuilder.Core.resources.dll. See docs/localization.md. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Metadata/Bundled/*.json" />
    <!-- The SDK LuaLS stub (stubs/mods/skyeshade/hd2runtime.lua), kept under its flat cache name. -->
    <EmbeddedResource Include="Metadata/Bundled/hd2runtime-stubs.lua" />
    <!-- Custom content targets: the HD2Runtime custom stratagem schema each target adapter was written against (CustomContent/Targets). -->
    <EmbeddedResource Include="CustomContent/Targets/*.json" />
    <!-- The LuaLS stub of that Runtime: completion for custom stratagem callbacks (ctx, hd2.pelican, hd2.custom_stratagem). -->
    <EmbeddedResource Include="CustomContent/Targets/*.lua" />
    <!-- Custom stratagem templates: ModBuilder's simple examples and two of HD2Runtime's own (sdk/fixtures/custom_stratagems, byte for byte). -->
    <EmbeddedResource Include="CustomContent/Templates/*.json" />
    <!-- HD2Runtime 0.30's weapon sound catalogue (sdk/WeaponSoundCatalogue.json, byte for byte): the Custom Lua sound picker (Scripting/WeaponSounds). -->
    <EmbeddedResource Include="Scripting/Bundled/*.json" />
    <!-- HD2Runtime's HUD icon sprite names (sdk/HudIconSprites.json, byte for byte): the game icons read from the installed game's texture atlases. -->
    <EmbeddedResource Include="GameAssets/Bundled/*.json" />
    <!-- Release package / updater contract, shared with the standalone updater. -->
    <Compile Include="../HD2RuntimeModBuilder.Updater/UpdateContract.cs" Link="Updates/UpdateContract.cs" />
  </ItemGroup>
</Project>

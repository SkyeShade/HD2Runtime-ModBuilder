<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships as HD2RuntimeModBuilder.Core.dll since 1.0.1. The root namespace (and so the embedded Bundled/*.json resource
         names) stays HD2RuntimeGUI.Core. -->
    <AssemblyName>HD2RuntimeModBuilder.Core</AssemblyName>
    <RootNamespace>HD2RuntimeGUI.Core</RootNamespace>
    <!-- UI text: Resources/Strings/Strings.resx is English (neutral); each Strings.<culture>.resx builds to
         <culture>/HD2RuntimeModBuilder.Core.resources.dll. See docs/localization.md. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Metadata/Bundled/*.json" />
    <!-- Release package / updater contract, shared with the standalone updater. -->
    <Compile Include="../HD2RuntimeModBuilder.Updater/UpdateContract.cs" Link="Updates/UpdateContract.cs" />
  </ItemGroup>
</Project>
